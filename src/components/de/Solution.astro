---
// Solution section - AgentPuter features

const features = [
  {
    icon: '>_',
    title: '24/7 Immer Online',
    description: 'Dein Agent läuft in der Cloud und schläft nie. Er arbeitet, während du schläfst, reist oder eine Pause machst.',
  },
  {
    icon: '[~]',
    title: 'Auth läuft nie ab',
    description: 'Serververwaltete Tokens und API-Keys. Automatische Aktualisierung und Wartung. Kein manueller Eingriff erforderlich.',
  },
  {
    icon: '>>',
    title: 'Parallele Agenten',
    description: 'Führe mehrere Agenten gleichzeitig aus, ohne deinen lokalen Rechner zu belasten. Skalierbar nach Bedarf.',
  },
  {
    icon: '[*]',
    title: 'Zugriff von überall',
    description: 'Steuere deine Agenten von jedem Gerät und von überall. Deine KI folgt dir, nicht umgekehrt.',
  },
];
---

<section id="features" class="py-20 lg:py-32 bg-dark-primary relative particles">
  <div class="max-w-7xl mx-auto px-6 lg:px-20">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <span class="inline-block px-4 py-2 text-xs font-mono font-bold tracking-widest text-accent border border-accent/30 bg-accent/10 rounded mb-6">
        LÖSUNG: INITIALISIERT
      </span>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold font-mono text-accent text-glow mb-4">
        Deine persönliche KI-Cloud
      </h2>
      <p class="text-text-secondary text-lg max-w-2xl mx-auto font-mono">
        AgentPuter ist die dedizierte Laufzeitumgebung deines KI-Agenten – ein Cloud-Pod, der niemals herunterfährt
      </p>
    </div>
    
    <!-- Content Grid -->
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Terminal Visual -->
      <div class="bg-dark-secondary rounded-lg border border-accent/30 overflow-hidden glow-accent neon-box pulse-border order-2 lg:order-1">
        <div class="flex items-center gap-2 px-4 h-10 bg-dark-tertiary border-b border-accent/20">
          <span class="w-3 h-3 rounded-full bg-error"></span>
          <span class="w-3 h-3 rounded-full bg-warning"></span>
          <span class="w-3 h-3 rounded-full bg-accent"></span>
          <span class="text-accent font-mono text-xs ml-2">agentputer@cloud:~</span>
        </div>
        <div class="p-5 font-mono text-sm leading-relaxed space-y-2 min-h-[320px]">
          <div class="text-accent">$ agentputer status</div>
          <div class="text-text-secondary"></div>
          <div class="text-text-secondary">  Pod-ID:      <span class="text-terminal-cyan">pod-7x24-alpha</span></div>
          <div class="text-accent">  Status:      <span class="text-accent">●</span> ONLINE</div>
          <div class="text-text-secondary">  Uptime:      <span class="text-terminal-blue">14T 7h 23m</span></div>
          <div class="text-text-secondary">  Agenten:     <span class="text-terminal-orange">3 aktiv</span></div>
          <div class="text-text-secondary"></div>
          <div class="text-accent">$ openclaw logs --tail</div>
          <div class="text-text-muted text-xs"><span class="text-terminal-cyan">[02:34:15]</span> <span class="text-terminal-orange">[gateway]</span> WhatsApp verbunden</div>
          <div class="text-text-muted text-xs"><span class="text-terminal-cyan">[02:34:18]</span> <span class="text-terminal-orange">[clawbot]</span> 47 Nachrichten verarbeitet</div>
          <div class="text-text-muted text-xs"><span class="text-terminal-cyan">[02:34:22]</span> <span class="text-terminal-orange">[moltbot]</span> Kalender synchronisiert ✓</div>
          <div class="text-accent text-xs"><span class="text-terminal-cyan">[02:34:25]</span> <span class="text-accent">✓</span> Alle Aufgaben abgeschlossen</div>
          <div class="text-text-secondary"></div>
          <div class="flex">
            <span class="text-accent">$ </span>
            <span class="text-accent animate-blink">█</span>
          </div>
        </div>
      </div>
      
      <!-- Features List -->
      <div class="space-y-6 order-1 lg:order-2">
        {features.map((feature, index) => (
          <div 
            class="flex gap-4 group"
            style={`animation-delay: ${index * 100}ms`}
          >
            <div class="flex-shrink-0 w-12 h-12 rounded-lg bg-dark-tertiary border border-accent/20 flex items-center justify-center group-hover:border-accent group-hover:bg-accent/10 transition-colors">
              <span class="text-accent font-mono font-bold text-sm">{feature.icon}</span>
            </div>
            <div>
              <h3 class="text-text-primary font-mono font-semibold mb-1 group-hover:text-accent transition-colors">
                {feature.title}
              </h3>
              <p class="text-text-secondary text-sm leading-relaxed font-mono">
                {feature.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>