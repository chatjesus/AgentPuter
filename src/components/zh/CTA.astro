---
// CTA section - Chinese version
---

<section id="cta" class="py-20 lg:py-32 bg-dark-primary relative matrix-grid">
  <div class="max-w-7xl mx-auto px-6 lg:px-20">
    <div class="relative overflow-hidden rounded-2xl bg-dark-secondary border-2 border-accent/50 p-8 md:p-16 glow-accent neon-box pulse-border scanlines">
      <!-- Terminal grid background -->
      <div class="absolute inset-0 opacity-5">
        <div class="absolute inset-0" style="background-image: linear-gradient(rgba(0,255,65,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(0,255,65,0.1) 1px, transparent 1px); background-size: 20px 20px;"></div>
      </div>
      
      <div class="relative text-center">
        <div class="font-mono text-accent text-sm mb-4">&gt; ./立即部署.sh</div>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-accent text-glow-strong mb-4 font-mono">
          2 分钟部署你的 AI Agent
        </h2>
        <p class="text-text-secondary text-lg mb-10 max-w-xl mx-auto font-mono">
          一键部署 OpenClaw + Telegram + Claude，你的 AI 从此永不休眠。
        </p>
        
        <!-- Deploy CTA Button -->
        <div class="max-w-lg mx-auto mb-8">
          <a
            href="https://app.agentputer.com/sign-up"
            class="inline-flex items-center justify-center gap-3 w-full h-14 rounded-lg bg-accent text-dark-primary font-mono font-bold text-lg hover:bg-accent-dark transition-all hover:shadow-lg hover:shadow-accent/25"
          >
            <span>$</span>
            <span>./启动云舱 --now</span>
            <span class="animate-pulse">_</span>
          </a>
        </div>
        
        <!-- Secondary: Email waitlist -->
        <div class="max-w-lg mx-auto">
          <p class="text-text-muted text-xs font-mono mb-3">// 或加入等候名单获取更新：</p>
          <form id="waitlist-form-zh" class="flex flex-col sm:flex-row gap-3">
            <div class="flex-1 relative">
              <span class="absolute left-4 top-1/2 -translate-y-1/2 text-accent font-mono text-sm">$</span>
              <input
                type="email"
                name="email"
                required
                placeholder="你的邮箱@example.com"
                class="w-full h-12 pl-8 pr-5 rounded-lg bg-dark-primary text-accent placeholder-text-muted font-mono text-sm border border-accent/20 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent"
              />
            </div>
            <button
              type="submit"
              class="h-12 px-6 rounded-lg border border-accent/50 text-accent font-mono font-bold text-sm hover:bg-accent/10 transition-colors whitespace-nowrap"
            >
              [确认]
            </button>
          </form>
          <div id="form-message-zh" class="mt-3 text-sm font-mono hidden"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('waitlist-form-zh');
    const messageEl = document.getElementById('form-message-zh');
    
    if (!form) return;
    
    form.addEventListener('submit', async function(e) {
      e.preventDefault();
      
      const formData = new FormData(form);
      const email = formData.get('email');
      
      if (!messageEl || !email) return;
      
      // Show loading state
      const submitBtn = form.querySelector('button[type="submit"]');
      const originalText = submitBtn.textContent;
      submitBtn.textContent = '[处理中...]';
      submitBtn.disabled = true;
      
      try {
        // Save to localStorage (works in dev mode)
        const subscribers = JSON.parse(localStorage.getItem('agentputer_subscribers') || '[]');
        if (!subscribers.includes(email)) {
          subscribers.push(email);
          localStorage.setItem('agentputer_subscribers', JSON.stringify(subscribers));
        }
        console.log('[DEV] Email saved to localStorage:', email);
        
        // Try API call (will work after deployment to Cloudflare)
        try {
          const response = await fetch('/api/subscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: email }),
          });
          if (response.ok) {
            console.log('[PROD] Email saved to API');
          }
        } catch (err) {
          console.log('[DEV] API not available, using localStorage only');
        }
        
        // Always show success
        messageEl.innerHTML = '<span class="text-accent">✓ 成功:</span> 你已加入等候名单！我们会尽快联系你。';
        messageEl.className = 'mt-4 text-sm font-mono text-accent';
        messageEl.classList.remove('hidden');
        form.reset();
        
        // Show terminal-style success animation
        const input = form.querySelector('input[type="email"]');
        if (input) {
          input.placeholder = '已订阅! ✓';
          setTimeout(function() {
            input.placeholder = '你的邮箱@example.com';
          }, 3000);
        }
      } catch (error) {
        messageEl.innerHTML = '<span class="text-error">[错误]</span> 出了点问题，请重试。';
        messageEl.className = 'mt-4 text-sm font-mono text-error';
        messageEl.classList.remove('hidden');
      } finally {
        submitBtn.textContent = originalText;
        submitBtn.disabled = false;
      }
    });
  });
</script>
