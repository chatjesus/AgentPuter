---
// 文档侧边栏导航 - 中文版
interface Props {
  activeItem?: string;
}
const { activeItem = 'home' } = Astro.props;

const sections = [
  {
    label: '开始使用',
    items: [
      { id: 'quick-start', name: '快速上手', href: '/zh/docs#quick-start' },
      { id: 'add-channels', name: '添加渠道', href: '/zh/docs/add-channel' },
      { id: 'skills', name: 'Skills & ClawHub', href: '/zh/docs#skills' },
    ],
  },
  {
    label: '配置',
    items: [
      { id: 'pod-settings', name: 'Pod 设置', href: '/zh/docs#pod-settings' },
      { id: 'env-secrets', name: '环境变量与密钥', href: '/zh/docs#env-secrets' },
      { id: 'ssh', name: 'SSH 访问', href: '/zh/docs#ssh' },
    ],
  },
  {
    label: '了解更多',
    items: [
      { id: 'security', name: '安全与隐私', href: '/zh/docs#security' },
      { id: 'troubleshooting', name: '故障排查', href: '/zh/docs#troubleshooting' },
      { id: 'cost', name: '费用与用量', href: '/zh/docs#cost' },
    ],
  },
];

const comingSoon = [
  '核心概念',
  '多 Agent',
  'Skills & Tools',
  '费用管理',
  'API 参考',
  '迁移指南',
];
---

<aside class="w-full lg:w-[240px] lg:min-w-[240px] bg-[#111111] border-r border-[#222222] lg:min-h-[calc(100vh-80px)] lg:sticky lg:top-20 overflow-y-auto">
  <div class="p-4 lg:py-5 lg:px-4 flex flex-col gap-1">
    <!-- 搜索框 -->
    <div class="w-full h-[30px] bg-[#1A1A1A] rounded-md border border-[#333333] flex items-center px-3 mb-3">
      <span class="text-[#555] text-[11px] font-sans">🔍 搜索...  ⌘K</span>
    </div>

    <!-- Docs Home -->
    <a
      href="/zh/docs"
      class={`w-full rounded px-2.5 py-1.5 font-mono text-[13px] font-semibold transition-colors ${
        activeItem === 'home'
          ? 'bg-accent/10 text-accent'
          : 'text-[#94A3B8] hover:text-white hover:bg-white/5'
      }`}
    >
      ⌂  文档首页
    </a>

    <!-- 各分区 -->
    {sections.map((section) => (
      <div class="mt-4">
        <span class="text-[#666] font-mono text-[10px] font-semibold tracking-[2px] block mb-1 px-1">
          {section.label}
        </span>
        {section.items.map((item) => (
          <a
            href={item.href}
            class={`block px-2.5 py-1 font-mono text-[13px] rounded transition-colors ${
              activeItem === item.id
                ? 'text-white bg-white/5'
                : 'text-[#94A3B8] hover:text-white hover:bg-white/5'
            }`}
          >
            {item.name}
          </a>
        ))}
      </div>
    ))}

    <!-- 分隔线 -->
    <div class="w-full h-px bg-[#222] my-4"></div>

    <!-- Coming Soon -->
    <span class="text-[#333] font-mono text-[9px] font-semibold tracking-[2px] block mb-1 px-1">
      即将推出
    </span>
    {comingSoon.map((item) => (
      <span class="block px-2.5 py-0.5 font-mono text-[12px] text-[#333] cursor-default">
        {item}
      </span>
    ))}
  </div>
</aside>
