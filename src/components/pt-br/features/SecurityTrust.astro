---
// Segurança e Confiança
const badges = [
  { icon: '🔐', title: 'AES-256', desc: 'Criptografado em repouso\ne em trânsito' },
  { icon: '🛡️', title: 'VPS Isolado', desc: 'Cada Pod em seu\npróprio ambiente' },
  { icon: '📡', title: 'Root SSH Completo', desc: 'Seu VPS,\nsuas regras' },
  { icon: '🗑️', title: 'Destruição com Um Clique', desc: 'Destrua todos os dados\ninstantaneamente' },
  { icon: '👁️', title: 'Humano no Controle', desc: 'Operações sensíveis\nprecisam da sua aprovação' },
];
---

<section class="relative py-16 bg-[#0A0A0A]">
  <div class="max-w-7xl mx-auto px-6 lg:px-20">
    <span class="block text-xs font-mono font-semibold tracking-[2px] text-accent mb-8">SEGURANÇA E CONFIANÇA</span>
    
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
      {badges.map((b) => (
        <div class="flex flex-col items-center text-center bg-[#111111] border border-[#222222] rounded-xl p-5 transition-all duration-300 hover:border-accent/20">
          <span class="text-2xl mb-2">{b.icon}</span>
          <span class="font-mono text-sm font-semibold text-white mb-1">{b.title}</span>
          <span class="text-xs text-[#666666] leading-relaxed whitespace-pre-line">{b.desc}</span>
        </div>
      ))}
    </div>
  </div>
</section>