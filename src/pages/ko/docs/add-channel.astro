---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/ko/Header.astro';
import Footer from '../../../components/ko/Footer.astro';
import DocsSidebar from '../../../components/ko/docs/DocsSidebar.astro';
import DocsChannels from '../../../components/ko/docs/DocsChannels.astro';
import AddChannelDashboard from '../../../components/ko/docs/AddChannelDashboard.astro';
---

<Layout
  title="채널 추가 - AgentPuter 문서 | Telegram, WhatsApp, Slack 등 연결"
  description="단계별 가이드: OpenClaw를 Telegram, WhatsApp, Slack, Discord 등 15개 이상의 채팅 채널에 연결하세요. DM Pairing 보안 메커니즘 상세 설명."
  tags={['AgentPuter 채널', 'Telegram Bot 설정', 'OpenClaw 채널', 'DM Pairing', 'WhatsApp AI', 'Slack Bot']}
>
  <Header />
  <main class="relative z-10 pt-20">
    <!-- 문서 뷰 -->
    <div class="flex flex-col lg:flex-row min-h-[calc(100vh-80px)]">
      <DocsSidebar activeItem="add-channels" />
      <DocsChannels />
    </div>

    <!-- Dashboard 미리보기 -->
    <section class="border-t border-[#222222]">
      <div class="max-w-7xl mx-auto px-6 py-10">
        <div class="inline-block bg-[#00BFFF]/10 border border-[#00BFFF]/30 rounded px-3 py-1 mb-6">
          <span class="text-[#00BFFF] font-mono text-[10px] font-semibold tracking-[2px]">
            DASHBOARD 미리보기
          </span>
        </div>
        <p class="text-[#666] text-[14px] mb-6">
          아래는 AgentPuter Dashboard에서 채널을 추가하는 실제 화면입니다.
        </p>
      </div>
      <AddChannelDashboard />
    </section>
  </main>
  <Footer />
</Layout>