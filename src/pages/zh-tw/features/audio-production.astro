---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
---

<Layout
  title="Podcast 與音訊後期處理 — AgentPuter"
  description="Upload raw recordings, get broadcast-quality MP3 in seconds."
>
  <Header activePage="features" />
  <main class="relative z-10">

    <!-- Hero -->
    <section class="relative pt-32 pb-16 lg:pt-40 lg:pb-20 overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-[#0A0A0A] to-[#0D0D14]"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_left,rgba(4ADE804D,transparent_60%)]" style="background: radial-gradient(ellipse at top left, #4ADE800D, transparent 60%)"></div>
      <div class="relative max-w-5xl mx-auto px-6 lg:px-20">
        <a href="/zh-tw/features" class="inline-flex items-center gap-2 text-xs font-mono text-[#4B5563] hover:text-[#4ADE80] transition-colors mb-8">
          ← 返回功能頁
        </a>
        <div class="flex flex-wrap gap-3 mb-5">
          <span class="text-xs font-bold font-mono px-2.5 py-1 rounded text-[#4ADE80] bg-[#4ADE80]/10">AUDIO</span>
          <span class="text-xs font-mono text-[#4A4A6A] px-2.5 py-1 rounded border border-[#1E1E2E]">ap-audio</span>
          <span class="text-xs font-mono text-[#4A4A6A] px-2.5 py-1 rounded border border-[#1E1E2E]">sox + ffmpeg</span>
        </div>
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-5 leading-tight">
          Podcast 與音訊<br/>後期處理
        </h1>
        <p class="text-[#9CA3AF] text-lg mb-10 max-w-2xl">上傳錄音 → AI 降噪剪輯 → 匯出廣播級 MP3</p>
        <div class="flex flex-wrap gap-3">
              <span class="inline-flex items-center gap-2 px-4 py-2 bg-[#111111] border border-[#4ADE80]/20 rounded-full text-xs text-[#94A3B8] font-mono">① 上傳原始 WAV/MP3</span>
              <span class="inline-flex items-center gap-2 px-4 py-2 bg-[#111111] border border-[#4ADE80]/20 rounded-full text-xs text-[#94A3B8] font-mono">② Agent 降噪 & 響度標準化</span>
              <span class="inline-flex items-center gap-2 px-4 py-2 bg-[#111111] border border-[#4ADE80]/20 rounded-full text-xs text-[#94A3B8] font-mono">③ 廣播級 MP3 完成</span>
        </div>
      </div>
    </section>

    <!-- Session Log -->
    <section class="py-12 lg:py-20">
      <div class="max-w-5xl mx-auto px-6 lg:px-20">
        <p class="font-mono text-xs font-semibold tracking-[0.2em] mb-8" style="color:#4ADE80">// Agent 工作階段日誌</p>
        <div class="flex flex-col gap-4">

          <div class="flex items-start gap-4">
            <div class="shrink-0 w-8 h-8 rounded-full bg-[#1E293B] flex items-center justify-center text-xs font-mono text-[#94A3B8]">U</div>
            <div class="bg-[#111827] border border-[#1E293B] rounded-2xl rounded-tl-sm px-5 py-4 max-w-xl">
              <p class="text-[#E2E8F0] text-sm">"處理 Podcast 第 12 集。去除背景雜音，標準化至 -14 LUFS，修剪 2 秒以上的靜音段，匯出 128kbps MP3。"</p>
            </div>
          </div>

          <div class="flex items-start gap-4 flex-row-reverse">
            <div class="shrink-0 w-8 h-8 rounded-full border flex items-center justify-center text-xs font-mono" style="background:#0C1020;border-color:#4ADE804D;color:#4ADE80">AP</div>
            <div class="rounded-2xl rounded-tr-sm px-5 py-4 max-w-xl border" style="background:#0D1020;border-color:#4ADE8026">
              <p class="text-[#94A3B8] text-xs font-mono mb-3">// 規劃執行順序</p>
              <ul class="text-[#CBD5E1] text-sm space-y-1.5">
                <li class="flex gap-2"><span class="text-[#4ADE80]">→</span> 從靜音段取樣雜訊特徵</li>
                <li class="flex gap-2"><span class="text-[#4ADE80]">→</span> 套用降噪（sox noisered）</li>
                <li class="flex gap-2"><span class="text-[#4ADE80]">→</span> EBU R128 響度標準化至 -14 LUFS</li>
                <li class="flex gap-2"><span class="text-[#4ADE80]">→</span> 修剪 2 秒以上的靜音段</li>
                <li class="flex gap-2"><span class="text-[#4ADE80]">→</span> 透過 ffmpeg 轉換為 128kbps MP3</li>
              </ul>
            </div>
          </div>

          
          <div class="bg-[#080810] border border-[#1E1E2E] rounded-2xl p-6 font-mono text-xs">
            <div class="flex items-center gap-2 mb-5">
              <span class="w-3 h-3 rounded-full bg-[#FF5F57]"></span><span class="w-3 h-3 rounded-full bg-[#FEBC2E]"></span><span class="w-3 h-3 rounded-full bg-[#28C840]"></span>
              <span class="text-[#4B5563] ml-2">agentputer — ap-audio executor</span>
            </div>
            <div class="space-y-1.5">
              <p><span class="text-[#2A2A3A]">$ </span><span class="text-[#94A3B8]">ap-audio analyze --input ep12-raw.wav</span></p>
              <p class="text-[#4ADE80] pl-4">✓ Duration: 47m 23s · Peak: -2.1 dBFS · Noise floor: -45 dB</p>
              <p class="mt-3"><span class="text-[#2A2A3A]">$ </span><span class="text-[#94A3B8]">ap-audio denoise --input ep12-raw.wav --profile auto</span></p>
              <p class="text-[#4ADE80] pl-4">✓ Noise profile sampled · Applied: -18dB noise reduction</p>
              <p class="mt-3"><span class="text-[#2A2A3A]">$ </span><span class="text-[#94A3B8]">ap-audio loudnorm --target -14 --tp -1.5 --lra 11</span></p>
              <p class="text-[#4ADE80] pl-4">✓ Integrated loudness: -23.4 LUFS → -14.0 LUFS (EBU R128)</p>
              <p class="mt-3"><span class="text-[#2A2A3A]">$ </span><span class="text-[#94A3B8]">ap-audio trim --remove-silence --threshold 0.02 --min-duration 2.0</span></p>
              <p class="text-[#4ADE80] pl-4">✓ Removed 4m 12s of silence · Final: 43m 11s</p>
              <p class="mt-3"><span class="text-[#2A2A3A]">$ </span><span class="text-[#94A3B8]">ap-audio convert --mp3 128k --output podcast-ep12-final.mp3</span></p>
              <p class="text-[#4ADE80] pl-4">✓ Exported: podcast-ep12-final.mp3 · 128kbps</p>
            </div>
            <div class="mt-5 pt-4 border-t border-[#1E1E2E] flex items-center justify-between">
              <span class="text-[#4B5563]">elapsed: 2m 18s</span>
              <div class="flex items-center gap-2 rounded-lg px-3 py-1.5 border" style="background:#07100A;border-color:#4ADE8033">
                <span style="color:#4ADE80">🎵</span><span style="color:#4ADE80">podcast-ep12-final.mp3</span><span class="text-[#4B5563] ml-2">128kbps · 43m 11s</span>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Capabilities -->
    <section class="py-12 lg:py-16 bg-[#080810]">
      <div class="max-w-5xl mx-auto px-6 lg:px-20">
        <p class="font-mono text-xs font-semibold tracking-[0.2em] mb-8" style="color:#4ADE80">// 此情境支援的功能</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="flex gap-4 bg-[#0D0D1A] border border-[#1E1E2E] rounded-xl p-5">
              <span class="text-2xl shrink-0 mt-0.5">🔇</span>
              <div>
                <h3 class="text-white text-sm font-semibold mb-1">自適應降噪</h3>
                <p class="text-[#6B7280] text-xs leading-relaxed">從靜音段自動取樣雜訊輪廓，適用於冷氣雜訊、室內底噪等。</p>
              </div>
            </div>
            <div class="flex gap-4 bg-[#0D0D1A] border border-[#1E1E2E] rounded-xl p-5">
              <span class="text-2xl shrink-0 mt-0.5">📊</span>
              <div>
                <h3 class="text-white text-sm font-semibold mb-1">EBU R128 響度標準</h3>
                <p class="text-[#6B7280] text-xs leading-relaxed">Podcast 平台行業標準（Spotify -14 LUFS、Apple -16 LUFS）。</p>
              </div>
            </div>
            <div class="flex gap-4 bg-[#0D0D1A] border border-[#1E1E2E] rounded-xl p-5">
              <span class="text-2xl shrink-0 mt-0.5">✂️</span>
              <div>
                <h3 class="text-white text-sm font-semibold mb-1">靜音偵測與修剪</h3>
                <p class="text-[#6B7280] text-xs leading-relaxed">可設定閾值，精準去除死寂片段而不影響語音。</p>
              </div>
            </div>
            <div class="flex gap-4 bg-[#0D0D1A] border border-[#1E1E2E] rounded-xl p-5">
              <span class="text-2xl shrink-0 mt-0.5">🔄</span>
              <div>
                <h3 class="text-white text-sm font-semibold mb-1">格式轉換</h3>
                <p class="text-[#6B7280] text-xs leading-relaxed">WAV、FLAC、OGG、AAC、MP3 — 任意編解碼器、任意位元率。</p>
              </div>
            </div>
            <div class="flex gap-4 bg-[#0D0D1A] border border-[#1E1E2E] rounded-xl p-5">
              <span class="text-2xl shrink-0 mt-0.5">🎚️</span>
              <div>
                <h3 class="text-white text-sm font-semibold mb-1">多軌道混音</h3>
                <p class="text-[#6B7280] text-xs leading-relaxed">將片頭/片尾音樂與人聲軌道混合。</p>
              </div>
            </div>
            <div class="flex gap-4 bg-[#0D0D1A] border border-[#1E1E2E] rounded-xl p-5">
              <span class="text-2xl shrink-0 mt-0.5">📋</span>
              <div>
                <h3 class="text-white text-sm font-semibold mb-1">音訊分析報告</h3>
                <p class="text-[#6B7280] text-xs leading-relaxed">取得時長、峰值電平、響度和削波統計。</p>
              </div>
            </div>
        </div>
      </div>
    </section>

    <!-- Other Scenarios -->
    <section class="py-12 lg:py-16">
      <div class="max-w-5xl mx-auto px-6 lg:px-20">
        <p class="font-mono text-xs text-[#4B5563] font-semibold tracking-[0.2em] mb-6">// 其他情境</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <a href="/zh-tw/features/financial-report" class="group flex items-center gap-4 bg-[#111111] hover:bg-[#161622] border border-[#1E1E2E] hover:border-[#4ADE80]/20 rounded-xl px-5 py-4 transition-all">
              <span class="text-2xl">📊</span>
              <div class="flex-1 min-w-0">
                <span class="text-xs font-mono text-[#4A4A6A] block mb-0.5">FINANCE</span>
                <span class="text-sm text-[#94A3B8] group-hover:text-white transition-colors truncate block">季度財務報告 自動化</span>
              </div>
              <span class="text-[#2A2A3A] group-hover:text-[#4ADE80] transition-colors">→</span>
            </a>
            <a href="/zh-tw/features/design-poster" class="group flex items-center gap-4 bg-[#111111] hover:bg-[#161622] border border-[#1E1E2E] hover:border-[#4ADE80]/20 rounded-xl px-5 py-4 transition-all">
              <span class="text-2xl">🎨</span>
              <div class="flex-1 min-w-0">
                <span class="text-xs font-mono text-[#4A4A6A] block mb-0.5">DESIGN</span>
                <span class="text-sm text-[#94A3B8] group-hover:text-white transition-colors truncate block">行銷海報 批次生成</span>
              </div>
              <span class="text-[#2A2A3A] group-hover:text-[#4ADE80] transition-colors">→</span>
            </a>
            <a href="/zh-tw/features/system-diagram" class="group flex items-center gap-4 bg-[#111111] hover:bg-[#161622] border border-[#1E1E2E] hover:border-[#4ADE80]/20 rounded-xl px-5 py-4 transition-all">
              <span class="text-2xl">📐</span>
              <div class="flex-1 min-w-0">
                <span class="text-xs font-mono text-[#4A4A6A] block mb-0.5">ENGINEERING</span>
                <span class="text-sm text-[#94A3B8] group-hover:text-white transition-colors truncate block">系統架構圖 自動繪製</span>
              </div>
              <span class="text-[#2A2A3A] group-hover:text-[#4ADE80] transition-colors">→</span>
            </a>
            <a href="/zh-tw/features/tech-docs" class="group flex items-center gap-4 bg-[#111111] hover:bg-[#161622] border border-[#1E1E2E] hover:border-[#4ADE80]/20 rounded-xl px-5 py-4 transition-all">
              <span class="text-2xl">📝</span>
              <div class="flex-1 min-w-0">
                <span class="text-xs font-mono text-[#4A4A6A] block mb-0.5">DOCS</span>
                <span class="text-sm text-[#94A3B8] group-hover:text-white transition-colors truncate block">技術文件 一鍵生成</span>
              </div>
              <span class="text-[#2A2A3A] group-hover:text-[#4ADE80] transition-colors">→</span>
            </a>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-12 lg:py-20">
      <div class="max-w-5xl mx-auto px-6 lg:px-20">
        <div class="rounded-2xl p-8 md:p-12 text-center border" style="background:#0D1020;border-color:#4ADE8033">
          <p class="font-mono text-xs tracking-[0.2em] mb-4" style="color:#4ADE80">// 部署你的 Agent</p>
          <h2 class="text-white text-2xl md:text-3xl font-bold mb-4">專業音訊，零手動編輯。</h2>
          <p class="text-[#6B7280] text-sm mb-8 max-w-md mx-auto">上傳原始錄音，獲得廣播級音訊。無需 DAW、無需外掛程式。</p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a href="https://app.agentputer.com/sign-up" class="btn-primary text-sm py-3 px-8 font-mono">[立即開始]</a>
            <a href="/zh-tw/features" class="btn-secondary text-sm py-3 px-8 font-mono">[全部場景]</a>
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>
