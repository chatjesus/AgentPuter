---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FeaturesHero from '../components/features/FeaturesHero.astro';
import BeforeAfter from '../components/features/BeforeAfter.astro';
import CommunityVoices from '../components/features/CommunityVoices.astro';
import CoreRoles from '../components/features/CoreRoles.astro';
import UseCases from '../components/features/UseCases.astro';
import ComparisonTable from '../components/features/ComparisonTable.astro';
import Architecture from '../components/features/Architecture.astro';
import SecurityTrust from '../components/features/SecurityTrust.astro';
import FeaturesCTA from '../components/features/FeaturesCTA.astro';

// Features 页面结构化数据 - FAQPage schema（提升搜索引擎 rich results 展示）
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is AgentPuter?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'AgentPuter is a dedicated cloud infrastructure for AI Agents. It provides a 24/7 runtime environment with persistent workspace, privacy proxy, context management, unified tool interface, and full accountability logging.',
      },
    },
    {
      '@type': 'Question',
      name: 'How does AgentPuter protect my data?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'AgentPuter acts as a Privacy Proxy between you and LLMs. All data is sanitized before reaching models, credentials are encrypted at rest with AES-256, API keys are managed server-side and never exposed to models, and PII is auto-detected and redacted.',
      },
    },
    {
      '@type': 'Question',
      name: 'What can my AI Agent do with AgentPuter?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Your agent can handle office work (reports, emails), research (web search, note-taking), development (code, test, deploy), and creative tasks (design, content generation) — all autonomously with its own persistent workspace.',
      },
    },
    {
      '@type': 'Question',
      name: 'How is AgentPuter different from ChatGPT or Claude?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Unlike chat interfaces, AgentPuter gives your agent a real computer with 24/7 uptime, persistent file storage, automatic auth management, multi-agent support, full audit trails, cost controls, and prompt injection defense.',
      },
    },
  ],
};

// SoftwareApplication schema
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'AgentPuter',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Cloud',
  description: "The infrastructure layer your AI agent is missing. A real computer purpose-built for AI Agents with privacy proxy, context management, and persistent workspace.",
  url: 'https://www.agentputer.com/features',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    description: 'Free during beta',
  },
  featureList: [
    'Privacy Proxy with AES-256 encryption',
    'Long-term Context Manager',
    'Unified Tool Interface (7 core tools)',
    'Persistent Workspace with file system',
    'Accountability Log with human-in-the-loop',
    '24/7 cloud runtime',
    'Multi-agent parallel execution',
    'Cost controls and budget limits',
  ],
};

// BreadcrumbList schema
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.agentputer.com/' },
    { '@type': 'ListItem', position: 2, name: 'Features', item: 'https://www.agentputer.com/features' },
  ],
};
---

<Layout
  title="Features - AgentPuter | The Infrastructure Layer Your Agent Is Missing"
  description="Explore AgentPuter's five core roles: Privacy Proxy, Context Manager, Unified Interface, Persistent Workspace, and Accountability Log. See how we compare to alternatives."
  tags={['AgentPuter Features', 'AI Agent Infrastructure', 'Privacy Proxy', 'Context Manager', 'Persistent Workspace', 'AI Security', 'AI Agent Platform', 'Cloud Runtime']}
>
  <!-- Features 页面专属结构化数据 -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />

  <Header activePage="features" />
  <main class="relative z-10">
    <FeaturesHero />
    <BeforeAfter />
    <CommunityVoices />
    <CoreRoles />
    <UseCases />
    <ComparisonTable />
    <Architecture />
    <SecurityTrust />
    <FeaturesCTA />
  </main>
  <Footer />
</Layout>
