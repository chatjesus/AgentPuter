                {
                  "type": "text",
                  "id": "NtFtTt",
                  "fill": "#FFAA33",
                  "content": "Features Page — 核心价值与逻辑需求",
                  "fontFamily": "Inter",
                  "fontSize": 16,
                  "fontWeight": "bold"
