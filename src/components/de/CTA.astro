---
// CTA-Bereich - Formular zur E-Mail-Sammlung
---

<section id="cta" class="py-20 lg:py-32 bg-dark-primary relative matrix-grid">
  <div class="max-w-7xl mx-auto px-6 lg:px-20">
    <div class="relative overflow-hidden rounded-2xl bg-dark-secondary border-2 border-accent/50 p-8 md:p-16 glow-accent neon-box pulse-border scanlines">
      <!-- Terminal-Rasterhintergrund -->
      <div class="absolute inset-0 opacity-5">
        <div class="absolute inset-0" style="background-image: linear-gradient(rgba(0,255,65,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(0,255,65,0.1) 1px, transparent 1px); background-size: 20px 20px;"></div>
      </div>
      
      <div class="relative text-center">
        <div class="font-mono text-accent text-sm mb-4">&gt; bereit_zum_start</div>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-accent text-glow-strong mb-4 font-mono">
          Bereit für deinen eigenen KI-Agenten?
        </h2>
        <p class="text-text-secondary text-lg mb-10 max-w-xl mx-auto font-mono">
          $29.99/Monat. In 2 Minuten eingerichtet. Kein Code erforderlich. Deine KI schläft nie.
        </p>
        
        <!-- Primärer CTA: Abonnieren -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-8">
          <a
            href="https://app.agentputer.com/sign-up"
            class="btn-primary text-sm py-4 px-10 font-mono"
          >
            [LOSLEGEN — $29.99/Monat]
          </a>
          <a
            href="/pricing"
            class="btn-secondary text-sm py-4 px-10 font-mono"
          >
            [PREISE ANZEIGEN]
          </a>
        </div>

        <p class="text-text-muted text-xs font-mono mb-6">
          // Jederzeit kündbar · Kein Code erforderlich · Keine versteckten Gebühren
        </p>
        
        <!-- E-Mail-Sammlung (sekundär) -->
        <div class="max-w-lg mx-auto mb-6">
          <p class="text-text-dark text-xs font-mono mb-3">// Oder trete der Warteliste für den BYOK-Plan bei:</p>
          <form id="waitlist-form" class="flex flex-col sm:flex-row gap-0">
            <div class="flex-1 relative">
              <span class="absolute left-4 top-1/2 -translate-y-1/2 text-accent font-mono text-sm">$</span>
              <input
                type="email"
                name="email"
                required
                placeholder="deine@email.de"
                class="w-full h-12 pl-8 pr-5 rounded-l-lg bg-dark-primary text-accent placeholder-text-muted font-mono text-sm border border-accent/30 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent"
              />
            </div>
            <button
              type="submit"
              class="h-12 px-5 rounded-r-lg bg-dark-tertiary text-text-secondary font-mono font-bold text-xs hover:bg-accent hover:text-dark-primary transition-colors whitespace-nowrap border border-accent/30 border-l-0"
            >
              [BENACHRICHTIGE MICH]
            </button>
          </form>
          <div id="form-message" class="mt-3 text-sm font-mono hidden"></div>
        </div>
        
        <!-- Kontakt -->
        <p class="text-text-muted text-xs font-mono mt-6">
          // Fragen? <a href="mailto:oscarzamora199907@gmail.com" class="text-terminal-cyan hover:underline">oscarzamora199907@gmail.com</a>
        </p>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('waitlist-form');
    const messageEl = document.getElementById('form-message');
    
    if (!form) return;
    
    form.addEventListener('submit', async function(e) {
      e.preventDefault();
      
      const formData = new FormData(form);
      const email = formData.get('email');
      
      if (!messageEl || !email) return;
      
      // Ladezustand anzeigen
      const submitBtn = form.querySelector('button[type="submit"]');
      const originalText = submitBtn.textContent;
      submitBtn.textContent = '[VERARBEITE...]';
      submitBtn.disabled = true;
      
      try {
        // In localStorage speichern (funktioniert im Entwicklermodus)
        // In der Produktion wird dies durch die API-Antwort überschrieben
        const subscribers = JSON.parse(localStorage.getItem('agentputer_subscribers') || '[]');
        if (!subscribers.includes(email)) {
          subscribers.push(email);
          localStorage.setItem('agentputer_subscribers', JSON.stringify(subscribers));
        }
        console.log('[DEV] E-Mail in localStorage gespeichert:', email);
        console.log('[DEV] Alle Abonnenten:', subscribers);
        
        // API-Aufruf versuchen (funktioniert nach dem Deployment auf Cloudflare)
        try {
          const response = await fetch('/api/subscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: email }),
          });
          if (response.ok) {
            console.log('[PROD] E-Mail in API gespeichert');
          }
        } catch (err) {
          // API im Entwicklermodus nicht verfügbar, das ist in Ordnung
          console.log('[DEV] API nicht verfügbar, nur localStorage wird verwendet');
        }
        
        // GA4 Conversion-Event-Tracking
        if (typeof gtag === 'function') {
          gtag('event', 'generate_lead', { event_category: 'engagement', event_label: 'cta_invite_request', value: 1 });
        }
        
        // Erfolg anzeigen
        messageEl.innerHTML = '<span class="text-accent">✓ ANFRAGE ERHALTEN:</span> Wir senden deinen Einladungscode innerhalb von 24 Stunden an <span class="text-terminal-cyan">' + email + '</span>.';
        messageEl.className = 'mt-3 text-sm font-mono text-accent';
        messageEl.classList.remove('hidden');
        form.reset();
      } catch (error) {
        messageEl.innerHTML = '<span class="text-error">[FEHLER]</span> Etwas ist schiefgelaufen. Bitte versuche es erneut.';
        messageEl.className = 'mt-4 text-sm font-mono text-error';
        messageEl.classList.remove('hidden');
      } finally {
        submitBtn.textContent = originalText;
        submitBtn.disabled = false;
      }
    });
  });
</script>