---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/zh/Header.astro';
import Footer from '../../../components/zh/Footer.astro';
import DocsSidebar from '../../../components/zh/docs/DocsSidebar.astro';
import DocsChannels from '../../../components/zh/docs/DocsChannels.astro';
import AddChannelDashboard from '../../../components/zh/docs/AddChannelDashboard.astro';
---

<Layout
  title="添加渠道 - AgentPuter 文档 | 连接 Telegram、WhatsApp、Slack 等"
  description="分步指南：将 OpenClaw 连接到 Telegram、WhatsApp、Slack、Discord 等 15+ 种聊天渠道。DM Pairing 安全机制详解。"
  tags={['AgentPuter 渠道', 'Telegram Bot 配置', 'OpenClaw 渠道', 'DM Pairing', 'WhatsApp AI', 'Slack Bot']}
>
  <Header />
  <main class="relative z-10 pt-20">
    <!-- 文档视角 -->
    <div class="flex flex-col lg:flex-row min-h-[calc(100vh-80px)]">
      <DocsSidebar activeItem="add-channels" />
      <DocsChannels />
    </div>

    <!-- Dashboard 预览 -->
    <section class="border-t border-[#222222]">
      <div class="max-w-7xl mx-auto px-6 py-10">
        <div class="inline-block bg-[#00BFFF]/10 border border-[#00BFFF]/30 rounded px-3 py-1 mb-6">
          <span class="text-[#00BFFF] font-mono text-[10px] font-semibold tracking-[2px]">
            DASHBOARD 预览
          </span>
        </div>
        <p class="text-[#666] text-[14px] mb-6">
          以下是 AgentPuter Dashboard 中添加渠道的实际界面效果。
        </p>
      </div>
      <AddChannelDashboard />
    </section>
  </main>
  <Footer />
</Layout>
