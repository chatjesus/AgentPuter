---
// Hero de Características - Título + Subtítulo + 5 etiquetas de vista previa
---

<section class="relative pt-32 pb-20 lg:pt-40 lg:pb-24 overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-b from-[#0A0A0A] via-[#0A0A0A] to-[#111111]"></div>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(0,255,65,0.06),transparent_50%)]"></div>
  
  <div class="relative max-w-7xl mx-auto px-6 lg:px-20">
    <div class="flex flex-col items-center text-center">
      <!-- Badge -->
      <span class="inline-block px-4 py-2 text-xs font-semibold tracking-[2px] text-accent font-mono mb-8 border border-accent/20 rounded-full bg-accent/5">
        CARACTERÍSTICAS: DESBLOQUEADAS
      </span>
      
      <!-- Headline -->
      <h1 class="text-4xl md:text-5xl lg:text-[52px] font-bold leading-[1.15] mb-8 text-white max-w-[900px]">
        La Capa de Infraestructura<br/>Que le Falta a tu Agente
      </h1>
      
      <!-- Subline -->
      <p class="text-base md:text-lg text-[#9CA3AF] leading-relaxed mb-10 max-w-[700px]">
        No es un envoltorio de chatbot. No es un host de plugins.<br/>
        Un ordenador de verdad, diseñado específicamente para Agentes de IA.
      </p>
      
      <!-- Role Preview Tags -->
      <div class="flex flex-wrap justify-center gap-3">
        <span class="inline-flex items-center gap-2 px-4 py-1.5 bg-[#111111] border border-[#333333] rounded-full text-xs">
          <span class="text-accent">🔒</span>
          <span class="text-[#94A3B8]">Proxy de Privacidad</span>
        </span>
        <span class="inline-flex items-center gap-2 px-4 py-1.5 bg-[#111111] border border-[#333333] rounded-full text-xs">
          <span class="text-[#00BFFF]">🧠</span>
          <span class="text-[#94A3B8]">Gestor de Contexto</span>
        </span>
        <span class="inline-flex items-center gap-2 px-4 py-1.5 bg-[#111111] border border-[#333333] rounded-full text-xs">
          <span class="text-[#A855F7]">🔌</span>
          <span class="text-[#94A3B8]">Interfaz Unificada</span>
        </span>
        <span class="inline-flex items-center gap-2 px-4 py-1.5 bg-[#111111] border border-[#333333] rounded-full text-xs">
          <span class="text-[#FFD700]">💾</span>
          <span class="text-[#94A3B8]">Espacio de Trabajo Persistente</span>
        </span>
        <span class="inline-flex items-center gap-2 px-4 py-1.5 bg-[#111111] border border-[#333333] rounded-full text-xs">
          <span class="text-[#FF6B6B]">📋</span>
          <span class="text-[#94A3B8]">Registro de Responsabilidad</span>
        </span>
      </div>
    </div>
  </div>
</section>