                      "content": "DESIGN NOTES",
                      "fontFamily": "JetBrains Mono",
                      "fontSize": 10,
                      "fontWeight": "bold",
                      "letterSpacing": 2
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "NtLPTt",
                  "fill": "#FFAA33",
                  "content": "Landing Page — 核心价值与逻辑需求",
                  "fontFamily": "Inter",
                  "fontSize": 16,
                  "fontWeight": "bold"
                }
              ]
            },
            {
              "type": "frame",
              "id": "NtLPLn",
              "name": "divider",
              "width": "fill_container",
              "height": 1,
              "fill": "#FFAA3330"
            },
            {
              "type": "text",
              "id": "NtLPTx",
              "name": "noteContent",
              "fill": "#CCAA77",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Landing Page v5 — 产品逻辑对齐修正\n══════════════════════════════════════════════════════\n\n【核心定位修正】\nAgentPuter = Managed OpenClaw Hosting\n类比: Vercel : Next.js = AgentPuter : OpenClaw\n\nOpenClaw (github.com/openclaw/openclaw):\n• 176k stars, MIT开源, Peter Steinberger 创建\n• 15+ 渠道 (WhatsApp/Telegram/Slack/Discord...)\n• 50+ 内置 skills + 565+ 社区 skills\n• mcporter 桥接 MCP 服务器\n• 已有 render.yaml + fly.toml (可在 Render/Fly.io 部署)\n• 推荐模型: Anthropic Claude Opus 4.6\n• 安装: npm install -g openclaw@latest\n• 运行: openclaw onboard --install-daemon\n\n【AgentPuter 解决什么】\nOpenClaw 很强, 但自己部署很痛:\n• 需要服务器 (VPS/Docker)\n• 需要 Node ≥22 + 持久存储 + daemon\n• 需要手动配置每个渠道\n• 需要自己管理更新\n• 需要自己监控健康状态\n• 需要自己控制 API 费用\n\nAgentPuter 一键解决全部.\n\n【Hero 修正建议】\n当前: 'Your AI Never Sleeps'\n建议添加副标题:\n  'Managed hosting for OpenClaw.\n   Your personal AI assistant, always on.\n   15+ channels. 500+ skills. Zero DevOps.'\n\n【Pain Points 修正】\n应该是 OpenClaw 自部署的痛点:\n• 'OpenClaw 需要一台服务器 24/7 运行'\n• 'Docker + nginx + systemd + SSL = 2天'\n• '渠道配置需要手动编辑 JSON'\n• '更新带风险, 没有 rollback'\n而不是抽象的 'agents need computers'\n\n【Telegram Setup 页 (TgPg1) 注意】\n• Step 1-2 基本正确 (BotFather + Token)\n• Step 3 '配对码' 是 OpenClaw 的 DM Pairing\n  但需要解释这不是我们的功能,\n  而是 OpenClaw 的安全机制\n• 应该改为通用 'Add Channel' 页,\n  不只是 Telegram Setup",
              "lineHeight": 1.7,
              "fontFamily": "JetBrains Mono",
              "fontSize": 13,
              "fontWeight": "normal"
            }
          ]
        }
      ]
