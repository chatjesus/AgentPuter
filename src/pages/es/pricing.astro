---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/es/Header.astro';
import Footer from '../../components/es/Footer.astro';
import MatrixRain from '../../components/MatrixRain.astro';

const pricingSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'AgentPuter Pro',
  description: 'Tu propio agente de IA que trabaja 24/7. Claude 4.5 incluido. Configuración en 2 minutos.',
  brand: { '@type': 'Brand', name: 'AgentPuter' },
  offers: {
    '@type': 'Offer',
    price: '29.00',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    priceValidUntil: '2027-12-31',
    url: 'https://app.agentputer.com/subscribe',
  },
};
const APP_URL = 'https://app.agentputer.com';
---
<Layout title="Precios - AgentPuter | Tu Agente de IA Siempre Activo" description="AgentPuter Pro: $29.99/mes. Tu agente de IA personal activo 24/7. Claude 4.5 incluido, más de 15 canales de mensajería, 500+ habilidades. Sin programación." tags={['AgentPuter', 'Precios', 'Agente IA', 'Automatización IA', 'Sin código']}>
  <fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(pricingSchema)} /></fragment>
  <MatrixRain />
  <Header activePage="pricing" />
  <main class="relative z-10">
    <section class="relative pt-32 pb-12 lg:pt-40 lg:pb-16 overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-dark-primary via-dark-primary to-dark-secondary"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(0,255,65,0.06),transparent_50%)]"></div>
      <div class="relative max-w-7xl mx-auto px-6 lg:px-20 text-center">
        <div class="font-mono text-accent text-xs font-semibold tracking-[0.2em] mb-6">PRECIOS: TRANSPARENTE</div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6">Precios Simples y Predecibles</h1>
        <p class="text-text-secondary text-lg md:text-xl max-w-2xl mx-auto leading-relaxed">
          Sin cargos ocultos. Sin facturas sorpresa. Cancela cuando quieras.<br /><span class="text-accent font-semibold">Plan Pro disponible</span> — empieza en 2 minutos.
        </p>
      </div>
    </section>
    <section class="pb-8">
      <div class="max-w-4xl mx-auto px-6 lg:px-20">
        <div class="bg-accent/5 border border-accent/15 rounded-xl p-6 md:p-8">
          <h3 class="text-white font-bold text-lg mb-4">💡 Todo incluido — regístrate y empieza</h3>
          <div class="flex flex-col md:flex-row items-start md:items-center gap-6 md:gap-10">
            <div><span class="text-accent font-semibold text-sm">Pro (Todo en uno)</span><p class="text-text-muted text-sm mt-1 leading-relaxed">Modelo IA, alojamiento en la nube, canales de mensajería — todo incluido. Sin claves API. Sin configuración. Funciona de inmediato.</p></div>
            <span class="text-text-dark font-bold text-sm hidden md:block">O</span>
            <div><span class="text-terminal-blue font-semibold text-sm">Starter (próximamente)</span><p class="text-text-muted text-sm mt-1 leading-relaxed">¿Ya tienes tu propia clave de API de IA? Usa nuestra plataforma a menor precio — $9/mes.</p></div>
          </div>
        </div>
      </div>
    </section>
    <section class="py-12 lg:py-16">
      <div class="max-w-7xl mx-auto px-6 lg:px-20">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 items-end max-w-5xl mx-auto">
          <div class="bg-dark-secondary rounded-2xl border border-dark-tertiary p-8 relative opacity-80">
            <div class="font-mono text-text-muted text-xs font-semibold tracking-[0.15em] mb-6">STARTER — PRÓXIMAMENTE</div>
            <div class="flex items-end gap-1 mb-2"><span class="text-5xl font-bold text-white">$9</span><span class="text-text-dark text-base mb-1">/mes</span></div>
            <p class="text-text-muted text-sm mb-6">Para usuarios que ya tienen una clave de API de IA</p>
            <div class="border-t border-dark-tertiary mb-6"></div>
            <ul class="space-y-3 text-sm mb-8">
              <li class="text-text-muted">✓ Siempre activo — funciona 24/7</li><li class="text-text-muted">✓ Más de 15 canales de mensajería</li><li class="text-text-muted">✓ Más de 500 habilidades integradas</li>
              <li class="text-text-muted">✓ Panel visual</li><li class="text-text-muted">✓ Entorno cloud dedicado</li><li class="text-text-muted">✓ Sin programación</li>
              <li class="pt-3 border-t border-dark-tertiary text-text-dark">✗ Modelo IA NO incluido</li>
              <li class="text-text-dark pl-4">Usas tu propia clave API</li>
            </ul>
            <button disabled class="w-full py-3.5 rounded-lg border border-dark-tertiary text-text-muted font-semibold text-sm cursor-not-allowed">Unirse a la lista de espera</button>
          </div>
          <div class="bg-dark-secondary rounded-2xl border-2 border-accent p-8 relative shadow-lg shadow-accent/10 md:-mt-4">
            <div class="flex items-center gap-3 mb-6"><span class="text-terminal-magenta font-mono text-xs font-bold">★ DISPONIBLE AHORA</span><span class="font-mono text-text-muted text-xs font-semibold tracking-[0.15em]">PRO</span></div>
            <div class="flex items-end gap-1 mb-2"><span class="text-6xl font-bold text-white">$29.99</span><span class="text-text-dark text-base mb-2">/mes</span></div>
            <p class="text-text-muted text-sm mb-6">Tu agente de IA que nunca duerme. Todo incluido.</p>
            <div class="border-t border-dark-tertiary mb-6"></div>
            <ul class="space-y-3 text-sm mb-8">
              <li class="text-text-muted">✓ Siempre activo — funciona 24/7, nunca para</li><li class="text-text-muted">✓ Conecta con Telegram, WhatsApp, Slack y más</li><li class="text-text-muted">✓ Más de 500 habilidades integradas (investigar, traducir, resumir...)</li>
              <li class="text-text-muted">✓ Panel visual — sin programación</li><li class="text-text-muted">✓ Computadora cloud dedicada, totalmente gestionada</li><li class="text-text-muted">✓ Configuración en 2 minutos</li>
              <li class="pt-3 border-t border-dark-tertiary text-accent">✓ Claude 4.5 IA incluido</li>
              <li class="text-accent/70 pl-4">Valor ~$20/mes, incluido gratis</li><li class="text-accent/70 pl-4">Sin clave API necesaria</li>
            </ul>
            <a href={`${APP_URL}/sign-up`} class="block w-full py-3.5 rounded-lg bg-accent text-dark-primary font-bold text-sm text-center hover:bg-accent-dark transition-colors">Empezar — $29.99/mes</a>
            <p class="text-text-dark text-xs text-center mt-3 font-mono">Cancela cuando quieras · Sin programación</p>
          </div>
          <div class="bg-dark-secondary rounded-2xl border border-dark-tertiary p-8 relative opacity-80">
            <div class="font-mono text-text-muted text-xs font-semibold tracking-[0.15em] mb-6">TEAM — PRÓXIMAMENTE</div>
            <div class="flex items-end gap-1 mb-2"><span class="text-4xl font-bold text-white">$59</span><span class="text-text-dark text-base mb-1">/mes</span></div>
            <p class="text-text-muted text-sm mb-6">Ejecuta múltiples agentes de IA para tu equipo</p>
            <div class="border-t border-dark-tertiary mb-6"></div>
            <ul class="space-y-3 text-sm mb-8">
              <li class="text-text-muted">✓ 3 agentes de IA funcionando 24/7</li><li class="text-text-muted">✓ Mayor rendimiento por agente</li><li class="text-text-muted">✓ Todos los canales de mensajería</li>
              <li class="text-text-muted">✓ Más de 500 habilidades integradas</li><li class="text-text-muted">✓ Soporte prioritario</li><li class="text-text-muted">✓ Flujos de trabajo multiagente</li>
              <li class="pt-3 border-t border-dark-tertiary text-text-muted">✓ Modelo IA INCLUIDO</li>
              <li class="text-text-dark pl-4">3x cuota de uso de IA</li><li class="text-text-dark pl-4">Modelos Claude 4.5 + Opus</li>
            </ul>
            <button disabled class="w-full py-3.5 rounded-lg border border-dark-tertiary text-text-muted font-semibold text-sm cursor-not-allowed">Unirse a la lista de espera</button>
          </div>
        </div>
      </div>
    </section>
    <section class="py-12 lg:py-16">
      <div class="max-w-5xl mx-auto px-6 lg:px-20">
        <div class="font-mono text-accent text-xs font-semibold tracking-[0.3em] mb-8">// POR QUÉ AGENTPUTER</div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-dark-secondary rounded-xl border border-dark-tertiary p-6">
            <span class="text-text-muted text-xs font-semibold">vs Hacerlo tú mismo</span>
            <p class="text-error font-bold mt-2">Horas de configuración + conocimientos técnicos necesarios</p>
            <p class="text-success text-sm mt-2 leading-relaxed">AgentPuter Pro $29.99/mes = 2 minutos para configurar. Sin programación. Sin gestión de servidores. Funciona de inmediato.</p>
          </div>
          <div class="bg-dark-secondary rounded-xl border border-dark-tertiary p-6">
            <span class="text-text-muted text-xs font-semibold">vs Suscripción a ChatGPT / Claude</span>
            <p class="text-error font-bold mt-2">$20/mes = Preguntas, responde. Eso es todo.</p>
            <p class="text-success text-sm mt-2 leading-relaxed">AgentPuter Pro $29.99/mes = IA que trabaja sola 24/7, conecta con tus apps y toma acción.</p>
          </div>
        </div>
      </div>
    </section>
    <section class="py-12 lg:py-20">
      <div class="max-w-5xl mx-auto px-6 lg:px-20">
        <div class="font-mono text-accent text-xs font-semibold tracking-[0.3em] mb-4">// POR QUÉ IMPORTA "SIEMPRE ACTIVO"</div>
        <h2 class="text-white text-2xl font-bold mb-3">Tu IA sigue trabajando mientras duermes.</h2>
        <p class="text-text-muted text-sm mb-8 leading-relaxed">ChatGPT se detiene cuando cierras el navegador. AgentPuter no. Monitorea, responde y actúa las 24 horas.</p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div class="bg-dark-secondary rounded-xl border border-accent/20 p-5"><span class="text-2xl mb-2 block">⚡</span><span class="text-accent font-bold text-lg">Configuración en 2 minutos</span><p class="text-text-muted text-sm mt-1">Haz clic, conecta, listo. Sin descargas, sin código, sin esperas.</p></div>
          <div class="bg-dark-secondary rounded-xl border border-terminal-blue/20 p-5"><span class="text-2xl mb-2 block">🔌</span><span class="text-terminal-blue font-bold text-lg">Más de 15 canales</span><p class="text-text-muted text-sm mt-1">Telegram, WhatsApp, Slack, Discord, Email — todos conectados.</p></div>
          <div class="bg-dark-secondary rounded-xl border border-terminal-magenta/20 p-5"><span class="text-2xl mb-2 block">🧠</span><span class="text-terminal-magenta font-bold text-lg">Claude 4.5 integrado</span><p class="text-text-muted text-sm mt-1">IA de primer nivel incluida. Sin suscripción separada.</p></div>
        </div>
      </div>
    </section>
    <section class="py-12 lg:py-16 bg-dark-secondary/50">
      <div class="max-w-3xl mx-auto px-6 lg:px-20">
        <h2 class="text-2xl font-bold text-white mb-8 text-center">Preguntas Frecuentes</h2>
        <div class="space-y-4" id="faq-list">
          <div class="faq-item border border-dark-tertiary rounded-lg overflow-hidden"><button class="faq-toggle w-full text-left px-6 py-4 flex items-center justify-between text-white font-medium hover:bg-dark-tertiary/50 transition-colors"><span>¿Necesito conocimientos técnicos?</span><span class="faq-icon text-accent font-mono text-sm">+</span></button><div class="faq-content hidden px-6 pb-4 text-text-muted text-sm leading-relaxed">No. AgentPuter está diseñado para personas que no programan. Regístrate, elige tu modelo de IA, conecta tu app de mensajería — listo. Todo está gestionado para ti.</div></div>
          <div class="faq-item border border-dark-tertiary rounded-lg overflow-hidden"><button class="faq-toggle w-full text-left px-6 py-4 flex items-center justify-between text-white font-medium hover:bg-dark-tertiary/50 transition-colors"><span>¿Qué modelo de IA está incluido?</span><span class="faq-icon text-accent font-mono text-sm">+</span></button><div class="faq-content hidden px-6 pb-4 text-text-muted text-sm leading-relaxed">El plan Pro incluye Claude 4.5 de Anthropic — uno de los modelos de IA más capaces disponibles. Aproximadamente $20/mes de uso de IA está incluido en tu suscripción. Sin clave API necesaria.</div></div>
          <div class="faq-item border border-dark-tertiary rounded-lg overflow-hidden"><button class="faq-toggle w-full text-left px-6 py-4 flex items-center justify-between text-white font-medium hover:bg-dark-tertiary/50 transition-colors"><span>¿Puedo cancelar en cualquier momento?</span><span class="faq-icon text-accent font-mono text-sm">+</span></button><div class="faq-content hidden px-6 pb-4 text-text-muted text-sm leading-relaxed">Sí — cancela cuando quieras desde tu panel. Tu agente de IA permanece activo hasta el final del período de facturación actual. Sin cargos por cancelación, sin compromisos.</div></div>
          <div class="faq-item border border-dark-tertiary rounded-lg overflow-hidden"><button class="faq-toggle w-full text-left px-6 py-4 flex items-center justify-between text-white font-medium hover:bg-dark-tertiary/50 transition-colors"><span>¿En qué se diferencia de ChatGPT?</span><span class="faq-icon text-accent font-mono text-sm">+</span></button><div class="faq-content hidden px-6 pb-4 text-text-muted text-sm leading-relaxed">ChatGPT es un chatbot — preguntas y responde. AgentPuter te da un agente de IA que funciona 24/7 por sí solo, conecta con tus apps y actúa incluso cuando no estás en tu computadora.</div></div>
          <div class="faq-item border border-dark-tertiary rounded-lg overflow-hidden"><button class="faq-toggle w-full text-left px-6 py-4 flex items-center justify-between text-white font-medium hover:bg-dark-tertiary/50 transition-colors"><span>¿Qué puede hacer realmente el agente de IA?</span><span class="faq-icon text-accent font-mono text-sm">+</span></button><div class="faq-content hidden px-6 pb-4 text-text-muted text-sm leading-relaxed">Más de 500 habilidades integradas: investigación, traducción, resumen, borradores de email, análisis de datos, programación, monitoreo de mercado y más. También puedes enseñarle nuevas tareas en lenguaje natural — sin código.</div></div>
        </div>
      </div>
    </section>
    <section class="py-16 lg:py-24">
      <div class="max-w-7xl mx-auto px-6 lg:px-20">
        <div class="relative overflow-hidden rounded-2xl bg-dark-secondary border-2 border-accent/50 p-8 md:p-16 glow-accent neon-box">
          <div class="absolute inset-0 opacity-5"><div class="absolute inset-0" style="background-image: linear-gradient(rgba(0,255,65,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(0,255,65,0.1) 1px, transparent 1px); background-size: 20px 20px;"></div></div>
          <div class="relative text-center">
            <div class="font-mono text-accent text-sm mb-4">> listo_para_empezar</div>
            <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-accent text-glow-strong mb-4 font-mono">¿Listo para empezar?</h2>
            <p class="text-text-secondary text-lg mb-10 max-w-xl mx-auto font-mono">$29.99/mes. Configuración en 2 minutos. Tu agente de IA nunca duerme.</p>
            <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
              <a href={`${APP_URL}/sign-up`} class="btn-primary text-sm py-4 px-10 font-mono">[EMPEZAR AHORA]</a>
              <a href="mailto:oscarzamora199907@gmail.com" class="btn-secondary text-sm py-4 px-10 font-mono">[HACER UNA PREGUNTA]</a>
            </div>
            <p class="text-text-muted text-xs font-mono mt-6">// Cancela cuando quieras · Sin programación · Sin cargos ocultos</p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
<script is:inline>
  document.querySelectorAll('.faq-toggle').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var item = btn.closest('.faq-item'); var content = item.querySelector('.faq-content'); var icon = item.querySelector('.faq-icon');
      document.querySelectorAll('.faq-item').forEach(function(other) { if (other !== item) { other.querySelector('.faq-content').classList.add('hidden'); other.querySelector('.faq-icon').textContent = '+'; } });
      content.classList.toggle('hidden'); icon.textContent = content.classList.contains('hidden') ? '+' : '−';
    });
  });
</script>