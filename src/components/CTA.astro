---
// CTA section - Email collection form
---

<section id="cta" class="py-20 lg:py-32 bg-dark-primary relative matrix-grid">
  <div class="max-w-7xl mx-auto px-6 lg:px-20">
    <div class="relative overflow-hidden rounded-2xl bg-dark-secondary border-2 border-accent/50 p-8 md:p-16 glow-accent neon-box pulse-border scanlines">
      <!-- Terminal grid background -->
      <div class="absolute inset-0 opacity-5">
        <div class="absolute inset-0" style="background-image: linear-gradient(rgba(0,255,65,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(0,255,65,0.1) 1px, transparent 1px); background-size: 20px 20px;"></div>
      </div>
      
      <div class="relative text-center">
        <div class="font-mono text-accent text-sm mb-4">&gt; ./request_access.sh</div>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-accent text-glow-strong mb-4 font-mono">
          Ready to Set Your AI Free?
        </h2>
        <p class="text-text-secondary text-lg mb-10 max-w-xl mx-auto font-mono">
          Request an invite code. Deploy OpenClaw in 2 minutes. Your AI never sleeps again.
        </p>
        
        <!-- Email Collection Form -->
        <div class="max-w-lg mx-auto mb-8">
          <form id="waitlist-form" class="flex flex-col sm:flex-row gap-0">
            <div class="flex-1 relative">
              <span class="absolute left-4 top-1/2 -translate-y-1/2 text-accent font-mono text-sm">$</span>
              <input
                type="email"
                name="email"
                required
                placeholder="your@email.com"
                class="w-full h-14 pl-8 pr-5 rounded-l-lg bg-dark-primary text-accent placeholder-text-muted font-mono text-sm border border-accent/30 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent"
              />
            </div>
            <button
              type="submit"
              class="h-14 px-6 rounded-r-lg bg-accent text-dark-primary font-mono font-bold text-sm hover:bg-accent-dark transition-colors whitespace-nowrap"
            >
              [REQUEST INVITE]
            </button>
          </form>
          <div id="form-message" class="mt-3 text-sm font-mono hidden"></div>
          <p class="text-text-muted text-xs font-mono mt-3">// Limited early access. Invite code sent within 24h.</p>
        </div>

        <!-- Secondary: Already have code -->
        <div class="flex items-center justify-center gap-4">
          <span class="text-text-muted text-sm font-mono">Already have a code?</span>
          <a
            href="https://app.agentputer.com/sign-up"
            class="inline-flex items-center gap-2 px-6 py-3 border border-accent/50 text-accent font-mono font-bold text-sm rounded hover:bg-accent/10 transition-colors"
          >
            ./launch_pod _
          </a>
        </div>
        
        <!-- Contact -->
        <p class="text-text-muted text-xs font-mono mt-8">
          // Questions? <a href="mailto:oscarzamora199907@gmail.com" class="text-terminal-cyan hover:underline">oscarzamora199907@gmail.com</a>
        </p>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('waitlist-form');
    const messageEl = document.getElementById('form-message');
    
    if (!form) return;
    
    form.addEventListener('submit', async function(e) {
      e.preventDefault();
      
      const formData = new FormData(form);
      const email = formData.get('email');
      
      if (!messageEl || !email) return;
      
      // Show loading state
      const submitBtn = form.querySelector('button[type="submit"]');
      const originalText = submitBtn.textContent;
      submitBtn.textContent = '[PROCESSING...]';
      submitBtn.disabled = true;
      
      try {
        // Save to localStorage (works in dev mode)
        // In production, this will be overridden by API response
        const subscribers = JSON.parse(localStorage.getItem('agentputer_subscribers') || '[]');
        if (!subscribers.includes(email)) {
          subscribers.push(email);
          localStorage.setItem('agentputer_subscribers', JSON.stringify(subscribers));
        }
        console.log('[DEV] Email saved to localStorage:', email);
        console.log('[DEV] All subscribers:', subscribers);
        
        // Try API call (will work after deployment to Cloudflare)
        try {
          const response = await fetch('/api/subscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: email }),
          });
          if (response.ok) {
            console.log('[PROD] Email saved to API');
          }
        } catch (err) {
          // API not available in dev mode, that's fine
          console.log('[DEV] API not available, using localStorage only');
        }
        
        // GA4 转化事件追踪
        if (typeof gtag === 'function') {
          gtag('event', 'generate_lead', { event_category: 'engagement', event_label: 'cta_invite_request', value: 1 });
        }
        
        // Show success
        messageEl.innerHTML = '<span class="text-accent">✓ REQUEST RECEIVED:</span> We\'ll send your invite code to <span class="text-terminal-cyan">' + email + '</span> within 24h.';
        messageEl.className = 'mt-3 text-sm font-mono text-accent';
        messageEl.classList.remove('hidden');
        form.reset();
      } catch (error) {
        messageEl.innerHTML = '<span class="text-error">[ERROR]</span> Something went wrong. Please try again.';
        messageEl.className = 'mt-4 text-sm font-mono text-error';
        messageEl.classList.remove('hidden');
      } finally {
        submitBtn.textContent = originalText;
        submitBtn.disabled = false;
      }
    });
  });
</script>
