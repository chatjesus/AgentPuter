---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/pt-br/Header.astro';
import Footer from '../../components/pt-br/Footer.astro';
import MatrixRain from '../../components/MatrixRain.astro';

const APP_URL = 'https://app.agentputer.com';

const useCases = [
  {
    category: 'Pesquisa e análise',
    icon: '',
    color: 'accent',
    items: ["Monitorar notícias do setor 24/7","Rastrear atualizações de concorrentes","Resumir relatórios longos e PDFs","Traduzir documentos em tempo real","Compilar briefings diários do mercado","Pesquisar empresas e tendências"],
  },
  {
    category: 'Comunicação',
    icon: '',
    color: 'accent',
    items: ["Redigir respostas de email automaticamente","Gerenciar mensagens do Telegram/Slack","Traduzir conversas em tempo real","Responder perguntas de clientes","Agendar follow-ups","Resumir longos threads de chat"],
  },
  {
    category: 'Produtividade',
    icon: '',
    color: 'accent',
    items: ["Organizar sua agenda e tarefas","Fazer anotações de reuniões automaticamente","Definir lembretes inteligentes","Criar apresentações a partir de notas","Rastrear prazos em projetos","Gerar relatórios conforme programado"],
  },
  {
    category: 'Finanças e negócios',
    icon: '',
    color: 'accent',
    items: ["Rastrear despesas e recibos","Monitorar preços de ações e alertas","Gerar faturas","Comparar cotações e propostas","Calcular cenários de ROI","Resumir relatórios financeiros"],
  },
  {
    category: 'Conteúdo e escrita',
    icon: '',
    color: 'accent',
    items: ["Redigir posts de blog e artigos","Escrever conteúdo para redes sociais","Criar newsletters","Editar e revisar documentos","Gerar descrições de produtos","Escrever contratos e NDAs"],
  },
  {
    category: 'Dados e automação',
    icon: '',
    color: 'accent',
    items: ["Extrair e organizar dados da web","Monitorar mudanças em sites","Categorizar automaticamente informações recebidas","Gerar resumos diários/semanais","Cruzar referências de múltiplas fontes","Construir fluxos de trabalho personalizados"],
  }
];
---
<Layout title="Ferramentas e Casos de Uso - AgentPuter | O que seu agente IA pode fazer?" description="Descubra 500+ coisas que seu agente IA sempre ativo pode fazer. Pesquisar, automatizar, comunicar, analisar — sem programação. Veja casos de uso reais." tags={['AgentPuter', 'Ferramentas IA', 'Casos de uso IA', 'Automação IA', 'IA sem código', 'Agente IA']}>
  <MatrixRain />
  <Header activePage="tools" />
  <main class="relative z-10">
    <section class="relative pt-32 pb-12 lg:pt-40 lg:pb-16 overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-dark-primary via-dark-primary to-dark-secondary"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(0,255,65,0.06),transparent_50%)]"></div>
      <div class="relative max-w-7xl mx-auto px-6 lg:px-20 text-center">
        <div class="font-mono text-accent text-xs font-semibold tracking-[0.2em] mb-6">500+ HABILIDADES INTEGRADAS</div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6">O que seu agente IA pode fazer?</h1>
        <p class="text-text-secondary text-lg md:text-xl max-w-2xl mx-auto leading-relaxed mb-4">Um agente. Milhares de casos de uso.<br />Diga o que você precisa em linguagem simples — ele cuida do resto.</p>
        <p class="text-text-muted text-sm max-w-xl mx-auto">Seu agente IA funciona 24/7, conecta-se aos seus apps favoritos e lida com tarefas mesmo enquanto você dorme. Sem programação. Sem configuração. Apenas descreva o que você quer.</p>
      </div>
    </section>
    <section class="py-8 overflow-hidden">
      <div class="relative">
        <div class="flex animate-scroll-left gap-4 whitespace-nowrap">
          <span class="inline-block px-4 py-2 bg-dark-secondary border border-dark-tertiary rounded-full text-text-muted text-sm">Ler e resumir email</span>
          <span class="inline-block px-4 py-2 bg-dark-secondary border border-dark-tertiary rounded-full text-text-muted text-sm">Redigir respostas automaticamente</span>
          <span class="inline-block px-4 py-2 bg-dark-secondary border border-dark-tertiary rounded-full text-text-muted text-sm">Traduzir mensagens</span>
          <span class="inline-block px-4 py-2 bg-dark-secondary border border-dark-tertiary rounded-full text-text-muted text-sm">Monitorar preços de ações</span>
          <span class="inline-block px-4 py-2 bg-dark-secondary border border-dark-tertiary rounded-full text-text-muted text-sm">Rastrear notícias de concorrentes</span>
          <span class="inline-block px-4 py-2 bg-dark-secondary border border-dark-tertiary rounded-full text-text-muted text-sm">Resumir relatórios</span>
          <span class="inline-block px-4 py-2 bg-dark-secondary border border-dark-tertiary rounded-full text-text-muted text-sm">Agendar reuniões</span>
          <span class="inline-block px-4 py-2 bg-dark-secondary border border-dark-tertiary rounded-full text-text-muted text-sm">Gerar faturas</span>
          <span class="inline-block px-4 py-2 bg-dark-secondary border border-dark-tertiary rounded-full text-text-muted text-sm">Pesquisar concorrentes</span>
          <span class="inline-block px-4 py-2 bg-dark-secondary border border-dark-tertiary rounded-full text-text-muted text-sm">Escrever posts sociais</span>
          <span class="inline-block px-4 py-2 bg-dark-secondary border border-dark-tertiary rounded-full text-text-muted text-sm">Criar apresentações</span>
          <span class="inline-block px-4 py-2 bg-dark-secondary border border-dark-tertiary rounded-full text-text-muted text-sm">Encontrar melhores preços online</span>
          <span class="inline-block px-4 py-2 bg-dark-secondary border border-dark-tertiary rounded-full text-text-muted text-sm">Ler e resumir email</span>
          <span class="inline-block px-4 py-2 bg-dark-secondary border border-dark-tertiary rounded-full text-text-muted text-sm">Redigir respostas automaticamente</span>
          <span class="inline-block px-4 py-2 bg-dark-secondary border border-dark-tertiary rounded-full text-text-muted text-sm">Traduzir mensagens</span>
          <span class="inline-block px-4 py-2 bg-dark-secondary border border-dark-tertiary rounded-full text-text-muted text-sm">Monitorar preços de ações</span>
          <span class="inline-block px-4 py-2 bg-dark-secondary border border-dark-tertiary rounded-full text-text-muted text-sm">Rastrear notícias de concorrentes</span>
          <span class="inline-block px-4 py-2 bg-dark-secondary border border-dark-tertiary rounded-full text-text-muted text-sm">Resumir relatórios</span>
          <span class="inline-block px-4 py-2 bg-dark-secondary border border-dark-tertiary rounded-full text-text-muted text-sm">Agendar reuniões</span>
          <span class="inline-block px-4 py-2 bg-dark-secondary border border-dark-tertiary rounded-full text-text-muted text-sm">Gerar faturas</span>
          <span class="inline-block px-4 py-2 bg-dark-secondary border border-dark-tertiary rounded-full text-text-muted text-sm">Pesquisar concorrentes</span>
          <span class="inline-block px-4 py-2 bg-dark-secondary border border-dark-tertiary rounded-full text-text-muted text-sm">Escrever posts sociais</span>
          <span class="inline-block px-4 py-2 bg-dark-secondary border border-dark-tertiary rounded-full text-text-muted text-sm">Criar apresentações</span>
          <span class="inline-block px-4 py-2 bg-dark-secondary border border-dark-tertiary rounded-full text-text-muted text-sm">Encontrar melhores preços online</span>
        </div>
      </div>
    </section>
    <section class="py-12 lg:py-20">
      <div class="max-w-5xl mx-auto px-6 lg:px-20">
        <div class="font-mono text-accent text-xs font-semibold tracking-[0.3em] mb-4 text-center">// A FORMA ANTIGA VS A NOVA</div>
        <h2 class="text-white text-2xl md:text-3xl font-bold mb-12 text-center">Pare de fazer tudo manualmente</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="bg-dark-secondary rounded-2xl border border-dark-tertiary p-8">
            <div class="text-error font-mono text-xs font-bold mb-4">SEM AGENTPUTER</div>
            <ul class="space-y-4 text-sm">
              <li class="flex items-start gap-3 text-text-muted"><span class="text-error mt-0.5">✗</span><span>Verificar sites de notícias manualmente toda manhã</span></li>
              <li class="flex items-start gap-3 text-text-muted"><span class="text-error mt-0.5">✗</span><span>Copiar e colar entre apps para traduzir mensagens</span></li>
              <li class="flex items-start gap-3 text-text-muted"><span class="text-error mt-0.5">✗</span><span>Gastar horas lendo e resumindo relatórios</span></li>
              <li class="flex items-start gap-3 text-text-muted"><span class="text-error mt-0.5">✗</span><span>Perder atualizações importantes quando você está ausente</span></li>
              <li class="flex items-start gap-3 text-text-muted"><span class="text-error mt-0.5">✗</span><span>A IA só funciona quando você está no computador</span></li>
            </ul>
          </div>
          <div class="bg-dark-secondary rounded-2xl border-2 border-accent/50 p-8">
            <div class="text-accent font-mono text-xs font-bold mb-4">COM AGENTPUTER</div>
            <ul class="space-y-4 text-sm">
              <li class="flex items-start gap-3 text-text-muted"><span class="text-accent mt-0.5">✓</span><span>A IA monitora notícias e envia um briefing diário</span></li>
              <li class="flex items-start gap-3 text-text-muted"><span class="text-accent mt-0.5">✓</span><span>Mensagens auto-traduzidas em todos os seus canais</span></li>
              <li class="flex items-start gap-3 text-text-muted"><span class="text-accent mt-0.5">✓</span><span>Envie um PDF, receba um resumo em segundos</span></li>
              <li class="flex items-start gap-3 text-text-muted"><span class="text-accent mt-0.5">✓</span><span>A IA trabalha 24/7 — mesmo nos fins de semana</span></li>
              <li class="flex items-start gap-3 text-text-muted"><span class="text-accent mt-0.5">✓</span><span>Seu agente roda no próprio cloud — sempre ligado</span></li>
            </ul>
          </div>
        </div>
      </div>
    </section>
    <section class="py-12 lg:py-20">
      <div class="max-w-7xl mx-auto px-6 lg:px-20">
        <div class="font-mono text-accent text-xs font-semibold tracking-[0.3em] mb-4 text-center">// CASOS DE USO</div>
        <h2 class="text-white text-2xl md:text-3xl font-bold mb-4 text-center">Um agente, centenas de casos de uso</h2>
        <p class="text-text-muted text-center text-sm mb-12 max-w-lg mx-auto">Ensine novas tarefas ao seu agente IA em linguagem natural. Sem código.</p>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {useCases.map((category) => (
            <div class="bg-dark-secondary rounded-2xl border border-dark-tertiary p-6 hover:border-accent/30 transition-colors">
              <div class="flex items-center gap-3 mb-4">
                <h3 class="text-white font-bold">{category.category}</h3>
              </div>
              <ul class="space-y-2.5">
                {category.items.map((item) => (
                  <li class="text-text-muted text-sm flex items-start gap-2">
                    <span class="text-accent mt-0.5 text-xs">●</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <p class="text-text-dark text-xs font-mono text-center mt-8">// Você pode adicionar quantos casos de uso quiser por meio de linguagem natural</p>
      </div>
    </section>
    <section class="py-12 lg:py-20 bg-dark-secondary/50">
      <div class="max-w-4xl mx-auto px-6 lg:px-20">
        <div class="font-mono text-accent text-xs font-semibold tracking-[0.3em] mb-4 text-center">// COMO FUNCIONA</div>
        <h2 class="text-white text-2xl md:text-3xl font-bold mb-12 text-center">3 passos. 2 minutos. Pronto.</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="text-center">
            <div class="w-16 h-16 rounded-full bg-accent/10 border border-accent/30 flex items-center justify-center mx-auto mb-4"><span class="text-accent font-mono font-bold text-xl">1</span></div>
            <h3 class="text-white font-bold mb-2">Cadastre-se</h3><p class="text-text-muted text-sm">Crie sua conta. Não precisa de cartão de crédito para explorar.</p>
          </div>
          <div class="text-center">
            <div class="w-16 h-16 rounded-full bg-terminal-cyan/10 border border-terminal-cyan/30 flex items-center justify-center mx-auto mb-4"><span class="text-terminal-cyan font-mono font-bold text-xl">2</span></div>
            <h3 class="text-white font-bold mb-2">Conecte seus apps</h3><p class="text-text-muted text-sm">Vincule Telegram, WhatsApp, Slack ou qualquer um dos 15+ canais.</p>
          </div>
          <div class="text-center">
            <div class="w-16 h-16 rounded-full bg-terminal-magenta/10 border border-terminal-magenta/30 flex items-center justify-center mx-auto mb-4"><span class="text-terminal-magenta font-mono font-bold text-xl">3</span></div>
            <h3 class="text-white font-bold mb-2">Diga o que fazer</h3><p class="text-text-muted text-sm">Descreva tarefas em linguagem simples. Seu agente IA cuida do resto — 24/7.</p>
          </div>
        </div>
      </div>
    </section>
    <section class="py-12 lg:py-20">
      <div class="max-w-5xl mx-auto px-6 lg:px-20 text-center">
        <div class="font-mono text-accent text-xs font-semibold tracking-[0.3em] mb-4">// FUNCIONA ONDE VOCÊ TRABALHA</div>
        <h2 class="text-white text-2xl md:text-3xl font-bold mb-4">Conecta a 15+ canais</h2>
        <p class="text-text-muted text-sm mb-10 max-w-lg mx-auto">Seu agente IA vai até onde você já está — sem novos apps para aprender.</p>
        <div class="flex flex-wrap items-center justify-center gap-4">
          <span class="px-5 py-2.5 bg-dark-secondary border border-accent/30 rounded-full text-accent text-sm font-medium">Telegram</span>
          <span class="px-5 py-2.5 bg-dark-secondary border border-accent/30 rounded-full text-accent text-sm font-medium">WhatsApp</span>
          <span class="px-5 py-2.5 bg-dark-secondary border border-accent/30 rounded-full text-accent text-sm font-medium">Slack</span>
          <span class="px-5 py-2.5 bg-dark-secondary border border-accent/30 rounded-full text-accent text-sm font-medium">Discord</span>
          <span class="px-5 py-2.5 bg-dark-secondary border border-dark-tertiary rounded-full text-text-muted text-sm">Email</span>
          <span class="px-5 py-2.5 bg-dark-secondary border border-dark-tertiary rounded-full text-text-muted text-sm">Web Chat</span>
          <span class="px-5 py-2.5 bg-dark-secondary border border-dark-tertiary rounded-full text-text-muted text-sm">SMS</span>
          <span class="px-5 py-2.5 bg-dark-secondary border border-dark-tertiary rounded-full text-text-muted text-sm">Line</span>
          <span class="px-5 py-2.5 bg-dark-secondary border border-dark-tertiary rounded-full text-text-muted text-sm">WeChat</span>
          <span class="px-5 py-2.5 bg-dark-secondary border border-dark-tertiary rounded-full text-text-muted text-sm">Twitter/X</span>
          <span class="px-5 py-2.5 bg-dark-secondary border border-dark-tertiary rounded-full text-text-muted text-sm">Instagram</span>
          <span class="px-5 py-2.5 bg-dark-secondary border border-dark-tertiary rounded-full text-text-muted text-sm">+4 more</span>
        </div>
      </div>
    </section>
    <section class="py-16 lg:py-24">
      <div class="max-w-7xl mx-auto px-6 lg:px-20">
        <div class="relative overflow-hidden rounded-2xl bg-dark-secondary border-2 border-accent/50 p-8 md:p-16 glow-accent neon-box">
          <div class="absolute inset-0 opacity-5"><div class="absolute inset-0" style="background-image: linear-gradient(rgba(0,255,65,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(0,255,65,0.1) 1px, transparent 1px); background-size: 20px 20px;"></div></div>
          <div class="relative text-center">
            <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-accent text-glow-strong mb-4 font-mono">Seu agente IA está esperando</h2>
            <p class="text-text-secondary text-lg mb-10 max-w-xl mx-auto" set:html="$29.99/mês. Configuração em 2 minutos. Funciona 24/7.<br />Sem programação. Sem chaves API. Tudo incluído."></p>
            <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
              <a href={`${APP_URL}/sign-up`} class="btn-primary text-sm py-4 px-10 font-mono">[COMEÇAR — $29.99/mês]</a>
              <a href="/pt-br/pricing" class="btn-secondary text-sm py-4 px-10 font-mono">[VER PREÇOS]</a>
            </div>
            <p class="text-text-muted text-xs font-mono mt-6">// Cancele quando quiser · Sem programação · Sem taxas ocultas</p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
<style>
  @keyframes scroll-left { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
  .animate-scroll-left { animation: scroll-left 30s linear infinite; }
</style>