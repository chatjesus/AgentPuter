---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const otherScenarios = [
  { slug: "financial-report",  icon: "📊", tag: "FINANCE",      title: "Automatisierung von Quartalsfinanzberichten" },
  { slug: "system-diagram",    icon: "📐", tag: "ENGINEERING",  title: "Automatische Erstellung von Systemarchitekturen" },
  { slug: "audio-production",  icon: "🎵", tag: "AUDIO",        title: "Podcast- & Audio-Postproduktion" },
  { slug: "tech-docs",         icon: "📝", tag: "DOCS",         title: "Generator für technische Dokumentationen" },
];
---

<Layout
  title="Marketing-Poster Stapelverarbeitung — AgentPuter"
  description="Beschreiben Sie Ihre Kampagne, erhalten Sie pixelgenaue SVG/PNG-Poster in Sekunden. AgentPuter nutzt die Inkscape CLI für die Stapelausgabe von Vektordesigns."
>
  <Header activePage="features" />
  <main class="relative z-10">

    <!-- Hero -->
    <section class="relative pt-32 pb-16 lg:pt-40 lg:pb-20 overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-[#0A0A0A] to-[#0D0D14]"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_left,rgba(167,139,250,0.05),transparent_60%)]"></div>
      <div class="relative max-w-5xl mx-auto px-6 lg:px-20">
        <a href="/de/features" class="inline-flex items-center gap-2 text-xs font-mono text-[#4B5563] hover:text-[#A78BFA] transition-colors mb-8">
          ← zurück zu Funktionen
        </a>
        <div class="flex flex-wrap gap-3 mb-5">
          <span class="text-xs font-bold font-mono px-2.5 py-1 rounded text-[#A78BFA] bg-[#A78BFA]/10">DESIGN</span>
          <span class="text-xs font-mono text-[#4A4A6A] px-2.5 py-1 rounded border border-[#1E1E2E]">ap-design</span>
          <span class="text-xs font-mono text-[#4A4A6A] px-2.5 py-1 rounded border border-[#1E1E2E]">Inkscape</span>
        </div>
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-5 leading-tight">
          Marketing-Poster<br/>Stapelverarbeitung
        </h1>
        <p class="text-[#9CA3AF] text-lg mb-10 max-w-2xl">
          Ein Satz → KI erstellt Design → Export hochauflösender PNG/SVG
        </p>
        <div class="flex flex-wrap gap-3">
          {["① Thema & Text beschreiben", "② Agent erstellt SVG-Layout", "③ Stapel-Export PNG/SVG"].map((step) => (
            <span class="inline-flex items-center gap-2 px-4 py-2 bg-[#111111] border border-[#A78BFA]/20 rounded-full text-xs text-[#94A3B8] font-mono">
              {step}
            </span>
          ))}
        </div>
      </div>
    </section>

    <!-- Session Log -->
    <section class="py-12 lg:py-20">
      <div class="max-w-5xl mx-auto px-6 lg:px-20">
        <p class="font-mono text-xs text-[#A78BFA] font-semibold tracking-[0.2em] mb-8">// AGENT SESSION LOG</p>
        <div class="flex flex-col gap-4">

          <div class="flex items-start gap-4">
            <div class="shrink-0 w-8 h-8 rounded-full bg-[#1E293B] flex items-center justify-center text-xs font-mono text-[#94A3B8]">U</div>
            <div class="bg-[#111827] border border-[#1E293B] rounded-2xl rounded-tl-sm px-5 py-4 max-w-xl">
              <p class="text-[#E2E8F0] text-sm">"Erstelle Summer-Sale-Poster in 3 Größen: 1080×1920, 1200×628, 1080×1080. Markenfarbe ist #FF6B35, Überschrift fett weiß, inklusive Promo-Code SUMMER25."</p>
            </div>
          </div>

          <div class="flex items-start gap-4 flex-row-reverse">
            <div class="shrink-0 w-8 h-8 rounded-full bg-[#16101F] border border-[#A78BFA]/30 flex items-center justify-center text-xs font-mono text-[#A78BFA]">AP</div>
            <div class="bg-[#100D18] border border-[#A78BFA]/15 rounded-2xl rounded-tr-sm px-5 py-4 max-w-xl">
              <p class="text-[#94A3B8] text-xs font-mono mb-3">// Planning 3-variant batch design</p>
              <ul class="text-[#CBD5E1] text-sm space-y-1.5">
                <li class="flex gap-2"><span class="text-[#A78BFA]">→</span> Basis-SVG-Leinwand mit Markenpalette erstellen</li>
                <li class="flex gap-2"><span class="text-[#A78BFA]">→</span> Textebenen zusammenstellen: Überschrift, Untertitel, Promo-Code</li>
                <li class="flex gap-2"><span class="text-[#A78BFA]">→</span> Verlaufshintergrund + dekorative Elemente anwenden</li>
                <li class="flex gap-2"><span class="text-[#A78BFA]">→</span> 3 Größenvarianten in 2-facher Auflösung exportieren</li>
              </ul>
            </div>
          </div>

          <div class="bg-[#080810] border border-[#1E1E2E] rounded-2xl p-6 font-mono text-xs">
            <div class="flex items-center gap-2 mb-5">
              <span class="w-3 h-3 rounded-full bg-[#FF5F57]"></span>
              <span class="w-3 h-3 rounded-full bg-[#FEBC2E]"></span>
              <span class="w-3 h-3 rounded-full bg-[#28C840]"></span>
              <span class="text-[#4B5563] ml-2">agentputer — ap-design executor</span>
            </div>
            <div class="space-y-1.5">
              <p><span class="text-[#2A2A3A]">$ </span><span class="text-[#94A3B8]">ap-design canvas --size 1080x1920 --bg "#FF6B35"</span></p>
              <p class="text-[#4ADE80] pl-4">✓ Leinwand erstellt: 1080×1920px, Basis in Marken-Orange</p>
              <p class="mt-3"><span class="text-[#2A2A3A]">$ </span><span class="text-[#94A3B8]">ap-design text --content "SUMMER SALE" --weight bold --color white --size 96</span></p>
              <p class="text-[#4ADE80] pl-4">✓ Textebene: Überschrift positioniert bei y=340, zentriert</p>
              <p class="mt-3"><span class="text-[#2A2A3A]">$ </span><span class="text-[#94A3B8]">ap-design text --content "UP TO 50% OFF" --size 48 --color "rgba(255,255,255,0.85)"</span></p>
              <p class="text-[#4ADE80] pl-4">✓ Untertitel-Ebene mit Deckkraft-Effekt hinzugefügt</p>
              <p class="mt-3"><span class="text-[#2A2A3A]">$ </span><span class="text-[#94A3B8]">ap-design badge --text "SUMMER25" --style pill --color white --bg "#1A1A1A"</span></p>
              <p class="text-[#4ADE80] pl-4">✓ Promo-Badge-Element eingefügt</p>
              <p class="mt-3"><span class="text-[#2A2A3A]">$ </span><span class="text-[#94A3B8]">ap-design batch --variants 3 --sizes "1080x1920,1200x628,1080x1080" --export png 2x</span></p>
              <p class="text-[#4ADE80] pl-4">✓ Exportiert: 3 PNG-Dateien, 3 SVG-Master</p>
            </div>
            <div class="mt-5 pt-4 border-t border-[#1E1E2E] flex items-center justify-between">
              <span class="text-[#4B5563]">elapsed: 23s · 6 files</span>
              <div class="flex items-center gap-2 bg-[#100D18] border border-[#A78BFA]/20 rounded-lg px-3 py-1.5">
                <span class="text-[#A78BFA]">🎨</span>
                <span class="text-[#A78BFA]">summer-sale-poster × 3</span>
                <span class="text-[#4B5563] ml-2">PNG + SVG</span>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Capabilities -->
    <section class="py-12 lg:py-16 bg-[#080810]">
      <div class="max-w-5xl mx-auto px-6 lg:px-20">
        <p class="font-mono text-xs text-[#A78BFA] font-semibold tracking-[0.2em] mb-8">// WHAT THIS SCENARIO SUPPORTS</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {[
            { icon: "🖼️", title: "Jede Leinwandgröße", desc: "Instagram, Facebook, Twitter/X, LinkedIn, Druckformate — alles aus einem einzigen Basisdesign." },
            { icon: "✏️", title: "Vollständige Textkontrolle", desc: "Schriftfamilie, Stärke, Größe, Farbe, Zeilenhöhe, Zeichenabstand — alles skriptbar." },
            { icon: "🎨", title: "Vektorpfad-Operationen", desc: "Formen zeichnen, Verläufe anwenden, Pfade beschneiden, Filter — vollständige SVG-Knoten-Manipulation." },
            { icon: "📦", title: "Stapel-Export von Varianten", desc: "Erstellen Sie 50 Sprachvarianten, Farbschemata oder A/B-Testversionen mit einem Befehl." },
            { icon: "📐", title: "Pixelgenaue Ausrichtung", desc: "Koordinatenbasierte Positionierung — kein Raten, keine Drag-and-Drop-Ausrichtungsprobleme." },
            { icon: "🔁", title: "Vorlagen-Wiederverwendung", desc: "Definieren Sie einmal eine Markenvorlage, tauschen Sie Inhaltsvariablen für jede Kampagne aus." },
          ].map((cap) => (
            <div class="flex gap-4 bg-[#0D0D1A] border border-[#1E1E2E] rounded-xl p-5">
              <span class="text-2xl shrink-0 mt-0.5">{cap.icon}</span>
              <div>
                <h3 class="text-white text-sm font-semibold mb-1">{cap.title}</h3>
                <p class="text-[#6B7280] text-xs leading-relaxed">{cap.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Other Scenarios -->
    <section class="py-12 lg:py-16">
      <div class="max-w-5xl mx-auto px-6 lg:px-20">
        <p class="font-mono text-xs text-[#4B5563] font-semibold tracking-[0.2em] mb-6">// OTHER SCENARIOS</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {otherScenarios.map((s) => (
            <a href={`/de/features/${s.slug}`} class="group flex items-center gap-4 bg-[#111111] hover:bg-[#161622] border border-[#1E1E2E] hover:border-[#A78BFA]/20 rounded-xl px-5 py-4 transition-all">
              <span class="text-2xl">{s.icon}</span>
              <div class="flex-1 min-w-0">
                <span class="text-xs font-mono text-[#4A4A6A] block mb-0.5">{s.tag}</span>
                <span class="text-sm text-[#94A3B8] group-hover:text-white transition-colors truncate block">{s.title}</span>
              </div>
              <span class="text-[#2A2A3A] group-hover:text-[#A78BFA] transition-colors">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-12 lg:py-20">
      <div class="max-w-5xl mx-auto px-6 lg:px-20">
        <div class="bg-[#100D18] border border-[#A78BFA]/20 rounded-2xl p-8 md:p-12 text-center">
          <p class="font-mono text-xs text-[#A78BFA] tracking-[0.2em] mb-4">// DEPLOY YOUR AGENT</p>
          <h2 class="text-white text-2xl md:text-3xl font-bold mb-4">Bereit, Ihren Design-Workflow zu automatisieren?</h2>
          <p class="text-[#6B7280] text-sm mb-8 max-w-md mx-auto">Einmal beschreiben, sofort 50 Varianten generieren. Keine Figma-Plugins, keine manuelle Größenanpassung.</p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a href="https://app.agentputer.com/sign-up" class="btn-primary text-sm py-3 px-8 font-mono">[JETZT STARTEN]</a>
            <a href="/de/features" class="btn-secondary text-sm py-3 px-8 font-mono">[ALLE SZENARIEN]</a>
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>