---
// ユースケース - 4つの使用シナリオカード
const cases = [
  {
    icon: '📊', name: 'オフィスワーク',
    desc: '「先週の売上データを集計し、レポートを作成して、マネージャーにメールで送って」\n\nエージェントがデータを取得、分析、整形して送信。あなたはレビューするだけです。',
  },
  {
    icon: '🔬', name: 'リサーチ',
    desc: '「2025年のEV市場のトレンドを調査して」\n\n検索、読解、要点抽出を行い、ノートブックを作成。後で確認できるように保存します。',
  },
  {
    icon: '💻', name: '開発',
    desc: '「私たちの製品のランディングページを構築して」\n\n専用の開発環境で、コードを書き、テストを実行し、バグを修正してデプロイ。行き詰まったらあなたに質問します。',
  },
  {
    icon: '🎨', name: 'クリエイティブ',
    desc: '「第1四半期のソーシャルメディアキャンペーンをデザインして」\n\n専用のキャンバスとアセットで、下書きを生成し、修正を繰り返し、バージョンを保存。あなたが指示を出します。',
  },
];
---

<section class="relative py-20 bg-[#111111]">
  <div class="max-w-7xl mx-auto px-6 lg:px-20">
    <span class="block text-xs font-mono font-semibold tracking-[2px] text-accent mb-6">ユースケース</span>
    <h2 class="text-2xl md:text-[32px] font-bold text-white mb-12">エージェントでできること</h2>
    
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {cases.map((c) => (
        <div class="bg-[#1A1A1A] rounded-xl border border-[#222222] p-6 transition-all duration-300 hover:border-accent/30 hover:-translate-y-1">
          <span class="text-[28px] block mb-3">{c.icon}</span>
          <h3 class="text-lg font-semibold text-white mb-3">{c.name}</h3>
          <p class="text-[13px] text-[#999999] leading-relaxed whitespace-pre-line">{c.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>