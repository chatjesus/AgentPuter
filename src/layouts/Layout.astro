---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
  publishedDate?: string;
  modifiedDate?: string;
  author?: string;
  tags?: string[];
  noindex?: boolean;
  lang?: string;
}

const {
  title = 'AgentPuter - Your AI Never Sleeps',
  description = 'Your AI Agent\'s dedicated cloud runtime. AgentPuter keeps your AI running 24/7 — so you don\'t have to.',
  image = '/og-default.png',
  type = 'website',
  publishedDate,
  modifiedDate,
  author = 'AgentPuter Lab',
  tags = [],
  noindex = false,
  lang: langProp,
} = Astro.props;

// 多语言配置：所有支持的语言
const SUPPORTED_LANGS = {
  en:      { hreflang: 'en',    ogLocale: 'en_US', prefix: '',        keywords: 'AI Agent, AgentPuter, Cloud Runtime, AI Automation, 24/7 AI, OpenClaw, ClawBot, AI Assistant, Agent Computer' },
  'zh-CN': { hreflang: 'zh-CN', ogLocale: 'zh_CN', prefix: '/zh',    keywords: 'AI Agent, AgentPuter, 云端运行时, AI 自动化, 7×24 AI, OpenClaw, ClawBot, AI 助手, Agent 电脑, 人工智能代理' },
  ja:      { hreflang: 'ja',    ogLocale: 'ja_JP', prefix: '/ja',    keywords: 'AI Agent, AgentPuter, クラウドランタイム, AI自動化, 24時間365日AI, OpenClaw, ClawBot, AIアシスタント, AIエージェント' },
  ko:      { hreflang: 'ko',    ogLocale: 'ko_KR', prefix: '/ko',    keywords: 'AI Agent, AgentPuter, 클라우드 런타임, AI 자동화, 24/7 AI, OpenClaw, ClawBot, AI 에이전트, AI 비서' },
  es:      { hreflang: 'es',    ogLocale: 'es_ES', prefix: '/es',    keywords: 'AI Agent, AgentPuter, Runtime en la nube, Automatización IA, IA 24/7, OpenClaw, ClawBot, Asistente IA, Agente IA' },
  'pt-BR': { hreflang: 'pt-BR', ogLocale: 'pt_BR', prefix: '/pt-br', keywords: 'AI Agent, AgentPuter, Runtime na nuvem, Automação IA, IA 24/7, OpenClaw, ClawBot, Assistente IA, Agente IA' },
  de:      { hreflang: 'de',    ogLocale: 'de_DE', prefix: '/de',    keywords: 'AI Agent, AgentPuter, Cloud-Laufzeit, KI-Automatisierung, 24/7 KI, OpenClaw, ClawBot, KI-Assistent, KI-Agent' },
  fr:      { hreflang: 'fr',    ogLocale: 'fr_FR', prefix: '/fr',    keywords: 'AI Agent, AgentPuter, Runtime cloud, Automatisation IA, IA 24/7, OpenClaw, ClawBot, Assistant IA, Agent IA' },
  'zh-TW': { hreflang: 'zh-TW', ogLocale: 'zh_TW', prefix: '/zh-tw', keywords: 'AI Agent, AgentPuter, 雲端執行環境, AI 自動化, 7×24 AI, OpenClaw, ClawBot, AI 助理, Agent 電腦, 人工智慧代理' },
};

// 自动检测语言：优先使用 prop，否则根据 URL 路径判断
const currentPath = Astro.url.pathname;
const langPrefixMatch = currentPath.match(/^\/(zh-tw|zh|ja|ko|es|pt-br|de|fr)(\/|$)/);
const detectedLangKey = langPrefixMatch
  ? Object.keys(SUPPORTED_LANGS).find(k => SUPPORTED_LANGS[k].prefix === `/${langPrefixMatch[1]}`)
  : 'en';
const lang = langProp || detectedLangKey || 'en';
const langConfig = SUPPORTED_LANGS[lang] || SUPPORTED_LANGS.en;
const ogLocale = langConfig.ogLocale;

const canonicalURL = new URL(currentPath, Astro.site || 'https://www.agentputer.com');
const ogImageURL = new URL(image, Astro.site || 'https://www.agentputer.com');

// hreflang：为所有支持的语言生成对应路径
const siteBase = Astro.site?.href || 'https://www.agentputer.com';
// 去掉当前语言前缀得到英文路径
const enPath = langConfig.prefix
  ? (currentPath.replace(new RegExp(`^${langConfig.prefix.replace('-', '\\-')}`), '') || '/')
  : currentPath;
// 为每种语言生成 URL
const hreflangs = Object.entries(SUPPORTED_LANGS).map(([lk, lv]) => ({
  lang: lv.hreflang,
  url: new URL(lv.prefix ? `${lv.prefix}${enPath === '/' ? '/' : enPath}` : enPath, siteBase).href,
}));

// 组织结构化数据
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'AgentPuter',
  url: 'https://www.agentputer.com',
  logo: 'https://www.agentputer.com/favicon.svg',
  description: 'Your AI Agent\'s dedicated cloud runtime. AgentPuter keeps your AI running 24/7.',
  sameAs: [
    'https://twitter.com/agentputer',
    'https://github.com/agentputer',
    'https://discord.gg/agentputer',
  ],
};

// 网站结构化数据（多语言适配）
const LANG_NAMES: Record<string, string> = {
  en: 'English', 'zh-CN': '中文', 'zh-TW': '繁體中文', ja: '日本語', ko: '한국어',
  es: 'Español', 'pt-BR': 'Português', de: 'Deutsch', fr: 'Français',
};
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'AgentPuter',
  url: 'https://www.agentputer.com',
  inLanguage: lang,
  availableLanguage: Object.entries(LANG_NAMES).map(([code, name]) => ({
    '@type': 'Language',
    name,
    alternateName: code,
  })),
  description: 'Your AI Agent\'s dedicated cloud runtime.',
};

// BreadcrumbList 结构化数据（帮助搜索引擎理解多语言站点层级）
const pathSegments = enPath.split('/').filter(Boolean);
const breadcrumbItems = [
  { '@type': 'ListItem', position: 1, name: 'Home', item: new URL(langConfig.prefix ? `${langConfig.prefix}/` : '/', siteBase).href },
];
if (pathSegments.length > 0) {
  pathSegments.forEach((seg, i) => {
    const pathSoFar = '/' + pathSegments.slice(0, i + 1).join('/') + '/';
    const fullPath = langConfig.prefix ? `${langConfig.prefix}${pathSoFar}` : pathSoFar;
    breadcrumbItems.push({
      '@type': 'ListItem',
      position: i + 2,
      name: seg.charAt(0).toUpperCase() + seg.slice(1).replace(/-/g, ' '),
      item: new URL(fullPath, siteBase).href,
    });
  });
}
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems,
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0D0D0D" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL.href} />

    <!-- hreflang 多语言标签 -->
    {hreflangs.map(h => (
      <link rel="alternate" hreflang={h.lang} href={h.url} />
    ))}
    <link rel="alternate" hreflang="x-default" href={hreflangs.find(h => h.lang === 'en')?.url} />

    <!-- Keywords（各语言本地化） -->
    {tags.length > 0 && <meta name="keywords" content={tags.join(', ')} />}
    {tags.length === 0 && <meta name="keywords" content={langConfig.keywords} />}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={ogImageURL.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="AgentPuter" />
    <meta property="og:locale" content={ogLocale} />
    {Object.values(SUPPORTED_LANGS).filter(l => l.ogLocale !== ogLocale).map(l => (
      <meta property="og:locale:alternate" content={l.ogLocale} />
    ))}

    <!-- Article-specific OG tags -->
    {type === 'article' && publishedDate && (
      <meta property="article:published_time" content={publishedDate} />
    )}
    {type === 'article' && modifiedDate && (
      <meta property="article:modified_time" content={modifiedDate} />
    )}
    {type === 'article' && author && (
      <meta property="article:author" content={author} />
    )}
    {type === 'article' && tags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@agentputer" />
    <meta name="twitter:creator" content="@agentputer" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL.href} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- 字体：preconnect + LCP 关键字体直接预加载 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- 直接预加载 LCP 关键字体文件（JetBrains Mono Bold Latin，H1 使用） -->
    <link rel="preload" as="font" type="font/woff2" crossorigin href="https://fonts.gstatic.com/s/jetbrainsmono/v24/tDbY2o-flEEny0FZhsfKu5WU4zr3E_BX0PnT8RD8L6tTOlOVk6OThhvA.woff2" />
    <!-- 字体 CSS 阻塞加载（配合 preconnect 延迟极低，确保 LCP 时字体可用） -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

    <!-- 页面专属结构化数据插槽 -->
    <slot name="head" />

    <!-- 浏览器语言自动检测：移到 head 阻塞执行，避免渲染后跳转导致 CLS -->
    <script is:inline>
    (function() {
      if (localStorage.getItem('agentputer-lang')) return;

      var langMap = {
        'zh': '/zh', 'zh-cn': '/zh', 'zh-tw': '/zh-tw', 'zh-hk': '/zh-tw',
        'ja': '/ja', 'ko': '/ko',
        'es': '/es', 'es-419': '/es',
        'pt': '/pt-br', 'pt-br': '/pt-br',
        'de': '/de', 'fr': '/fr',
      };

      var path = window.location.pathname;
      if (/^\/(zh-tw|zh|ja|ko|es|pt-br|de|fr)(\/|$)/.test(path)) {
        var m = path.match(/^\/(zh-tw|zh|ja|ko|es|pt-br|de|fr)/);
        if (m) localStorage.setItem('agentputer-lang', m[1]);
        return;
      }

      var langs = navigator.languages || [navigator.language];
      for (var i = 0; i < langs.length; i++) {
        var bl = langs[i].toLowerCase();
        if (langMap[bl]) {
          var target = path === '/' ? langMap[bl] + '/' : langMap[bl] + path;
          localStorage.setItem('agentputer-lang', bl);
          window.location.replace(target);
          return;
        }
        var primary = bl.split('-')[0];
        if (primary !== bl && langMap[primary]) {
          var target2 = path === '/' ? langMap[primary] + '/' : langMap[primary] + path;
          localStorage.setItem('agentputer-lang', primary);
          window.location.replace(target2);
          return;
        }
      }
      localStorage.setItem('agentputer-lang', 'en');
    })();
    </script>

    <!-- Google Analytics 4 -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-9M2T6GQJ0L"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-9M2T6GQJ0L');
    </script>

    <title>{title}</title>
  </head>
  <body class="min-h-screen">
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
