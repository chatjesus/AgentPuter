---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/es/Header.astro';
import Footer from '../../../components/es/Footer.astro';
---

<Layout
  title="Postproducción de Podcast y Audio — AgentPuter"
  description="Upload raw recordings, get broadcast-quality MP3 in seconds."
>
  <Header activePage="features" />
  <main class="relative z-10">

    <!-- Hero -->
    <section class="relative pt-32 pb-16 lg:pt-40 lg:pb-20 overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-[#0A0A0A] to-[#0D0D14]"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_left,rgba(4ADE804D,transparent_60%)]" style="background: radial-gradient(ellipse at top left, #4ADE800D, transparent 60%)"></div>
      <div class="relative max-w-5xl mx-auto px-6 lg:px-20">
        <a href="/es/features" class="inline-flex items-center gap-2 text-xs font-mono text-[#4B5563] hover:text-[#4ADE80] transition-colors mb-8">
          ← volver a funciones
        </a>
        <div class="flex flex-wrap gap-3 mb-5">
          <span class="text-xs font-bold font-mono px-2.5 py-1 rounded text-[#4ADE80] bg-[#4ADE80]/10">AUDIO</span>
          <span class="text-xs font-mono text-[#4A4A6A] px-2.5 py-1 rounded border border-[#1E1E2E]">ap-audio</span>
          <span class="text-xs font-mono text-[#4A4A6A] px-2.5 py-1 rounded border border-[#1E1E2E]">sox + ffmpeg</span>
        </div>
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-5 leading-tight">
          Postproducción de<br/>Podcast y Audio
        </h1>
        <p class="text-[#9CA3AF] text-lg mb-10 max-w-2xl">Subir grabación → IA limpia y edita → Exportar MP3 para difusión</p>
        <div class="flex flex-wrap gap-3">
              <span class="inline-flex items-center gap-2 px-4 py-2 bg-[#111111] border border-[#4ADE80]/20 rounded-full text-xs text-[#94A3B8] font-mono">① Subir WAV/MP3 bruto</span>
              <span class="inline-flex items-center gap-2 px-4 py-2 bg-[#111111] border border-[#4ADE80]/20 rounded-full text-xs text-[#94A3B8] font-mono">② El agente limpia y normaliza</span>
              <span class="inline-flex items-center gap-2 px-4 py-2 bg-[#111111] border border-[#4ADE80]/20 rounded-full text-xs text-[#94A3B8] font-mono">③ MP3 listo para difusión</span>
        </div>
      </div>
    </section>

    <!-- Session Log -->
    <section class="py-12 lg:py-20">
      <div class="max-w-5xl mx-auto px-6 lg:px-20">
        <p class="font-mono text-xs font-semibold tracking-[0.2em] mb-8" style="color:#4ADE80">// REGISTRO DE SESIÓN DEL AGENTE</p>
        <div class="flex flex-col gap-4">

          <div class="flex items-start gap-4">
            <div class="shrink-0 w-8 h-8 rounded-full bg-[#1E293B] flex items-center justify-center text-xs font-mono text-[#94A3B8]">U</div>
            <div class="bg-[#111827] border border-[#1E293B] rounded-2xl rounded-tl-sm px-5 py-4 max-w-xl">
              <p class="text-[#E2E8F0] text-sm">"Limpia el episodio 12. Eliminar ruido de fondo, normalizar a -14 LUFS, recortar silencios mayores a 2 segundos, exportar MP3 128 kbps."</p>
            </div>
          </div>

          <div class="flex items-start gap-4 flex-row-reverse">
            <div class="shrink-0 w-8 h-8 rounded-full border flex items-center justify-center text-xs font-mono" style="background:#0C1020;border-color:#4ADE804D;color:#4ADE80">AP</div>
            <div class="rounded-2xl rounded-tr-sm px-5 py-4 max-w-xl border" style="background:#0D1020;border-color:#4ADE8026">
              <p class="text-[#94A3B8] text-xs font-mono mb-3">// Planificando secuencia de ejecución</p>
              <ul class="text-[#CBD5E1] text-sm space-y-1.5">
                <li class="flex gap-2"><span class="text-[#4ADE80]">→</span> Detectar perfil de ruido de secciones en silencio</li>
                <li class="flex gap-2"><span class="text-[#4ADE80]">→</span> Aplicar reducción de ruido (sox noisered)</li>
                <li class="flex gap-2"><span class="text-[#4ADE80]">→</span> Normalización de volumen EBU R128 a -14 LUFS</li>
                <li class="flex gap-2"><span class="text-[#4ADE80]">→</span> Recortar segmentos de silencio > 2s</li>
                <li class="flex gap-2"><span class="text-[#4ADE80]">→</span> Convertir a MP3 128 kbps con ffmpeg</li>
              </ul>
            </div>
          </div>

          
          <div class="bg-[#080810] border border-[#1E1E2E] rounded-2xl p-6 font-mono text-xs">
            <div class="flex items-center gap-2 mb-5">
              <span class="w-3 h-3 rounded-full bg-[#FF5F57]"></span><span class="w-3 h-3 rounded-full bg-[#FEBC2E]"></span><span class="w-3 h-3 rounded-full bg-[#28C840]"></span>
              <span class="text-[#4B5563] ml-2">agentputer — ap-audio executor</span>
            </div>
            <div class="space-y-1.5">
              <p><span class="text-[#2A2A3A]">$ </span><span class="text-[#94A3B8]">ap-audio analyze --input ep12-raw.wav</span></p>
              <p class="text-[#4ADE80] pl-4">✓ Duration: 47m 23s · Peak: -2.1 dBFS · Noise floor: -45 dB</p>
              <p class="mt-3"><span class="text-[#2A2A3A]">$ </span><span class="text-[#94A3B8]">ap-audio denoise --input ep12-raw.wav --profile auto</span></p>
              <p class="text-[#4ADE80] pl-4">✓ Noise profile sampled · Applied: -18dB noise reduction</p>
              <p class="mt-3"><span class="text-[#2A2A3A]">$ </span><span class="text-[#94A3B8]">ap-audio loudnorm --target -14 --tp -1.5 --lra 11</span></p>
              <p class="text-[#4ADE80] pl-4">✓ Integrated loudness: -23.4 LUFS → -14.0 LUFS (EBU R128)</p>
              <p class="mt-3"><span class="text-[#2A2A3A]">$ </span><span class="text-[#94A3B8]">ap-audio trim --remove-silence --threshold 0.02 --min-duration 2.0</span></p>
              <p class="text-[#4ADE80] pl-4">✓ Removed 4m 12s of silence · Final: 43m 11s</p>
              <p class="mt-3"><span class="text-[#2A2A3A]">$ </span><span class="text-[#94A3B8]">ap-audio convert --mp3 128k --output podcast-ep12-final.mp3</span></p>
              <p class="text-[#4ADE80] pl-4">✓ Exported: podcast-ep12-final.mp3 · 128kbps</p>
            </div>
            <div class="mt-5 pt-4 border-t border-[#1E1E2E] flex items-center justify-between">
              <span class="text-[#4B5563]">elapsed: 2m 18s</span>
              <div class="flex items-center gap-2 rounded-lg px-3 py-1.5 border" style="background:#07100A;border-color:#4ADE8033">
                <span style="color:#4ADE80">🎵</span><span style="color:#4ADE80">podcast-ep12-final.mp3</span><span class="text-[#4B5563] ml-2">128kbps · 43m 11s</span>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Capabilities -->
    <section class="py-12 lg:py-16 bg-[#080810]">
      <div class="max-w-5xl mx-auto px-6 lg:px-20">
        <p class="font-mono text-xs font-semibold tracking-[0.2em] mb-8" style="color:#4ADE80">// QUÉ ADMITE ESTE ESCENARIO</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="flex gap-4 bg-[#0D0D1A] border border-[#1E1E2E] rounded-xl p-5">
              <span class="text-2xl shrink-0 mt-0.5">🔇</span>
              <div>
                <h3 class="text-white text-sm font-semibold mb-1">Reducción de ruido adaptativa</h3>
                <p class="text-[#6B7280] text-xs leading-relaxed">Perfil de ruido desde secciones en silencio. Para zumbido HVAC, ruido de sala, silbido.</p>
              </div>
            </div>
            <div class="flex gap-4 bg-[#0D0D1A] border border-[#1E1E2E] rounded-xl p-5">
              <span class="text-2xl shrink-0 mt-0.5">📊</span>
              <div>
                <h3 class="text-white text-sm font-semibold mb-1">Volumen EBU R128</h3>
                <p class="text-[#6B7280] text-xs leading-relaxed">Estándar de la industria para plataformas de podcasts (Spotify -14 LUFS, Apple -16 LUFS).</p>
              </div>
            </div>
            <div class="flex gap-4 bg-[#0D0D1A] border border-[#1E1E2E] rounded-xl p-5">
              <span class="text-2xl shrink-0 mt-0.5">✂️</span>
              <div>
                <h3 class="text-white text-sm font-semibold mb-1">Detección y recorte de silencios</h3>
                <p class="text-[#6B7280] text-xs leading-relaxed">Umbral configurable. Eliminar aire muerto sin tocar el habla.</p>
              </div>
            </div>
            <div class="flex gap-4 bg-[#0D0D1A] border border-[#1E1E2E] rounded-xl p-5">
              <span class="text-2xl shrink-0 mt-0.5">🔄</span>
              <div>
                <h3 class="text-white text-sm font-semibold mb-1">Conversión de formato</h3>
                <p class="text-[#6B7280] text-xs leading-relaxed">WAV, FLAC, OGG, AAC, MP3 — cualquier códec, cualquier bitrate.</p>
              </div>
            </div>
            <div class="flex gap-4 bg-[#0D0D1A] border border-[#1E1E2E] rounded-xl p-5">
              <span class="text-2xl shrink-0 mt-0.5">🎚️</span>
              <div>
                <h3 class="text-white text-sm font-semibold mb-1">Mezcla multipista</h3>
                <p class="text-[#6B7280] text-xs leading-relaxed">Mezclar música de intro/outro con pista de voz.</p>
              </div>
            </div>
            <div class="flex gap-4 bg-[#0D0D1A] border border-[#1E1E2E] rounded-xl p-5">
              <span class="text-2xl shrink-0 mt-0.5">📋</span>
              <div>
                <h3 class="text-white text-sm font-semibold mb-1">Informe de análisis de audio</h3>
                <p class="text-[#6B7280] text-xs leading-relaxed">Duración, niveles de pico, volumen y estadísticas de clipping.</p>
              </div>
            </div>
        </div>
      </div>
    </section>

    <!-- Other Scenarios -->
    <section class="py-12 lg:py-16">
      <div class="max-w-5xl mx-auto px-6 lg:px-20">
        <p class="font-mono text-xs text-[#4B5563] font-semibold tracking-[0.2em] mb-6">// OTROS ESCENARIOS</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <a href="/es/features/financial-report" class="group flex items-center gap-4 bg-[#111111] hover:bg-[#161622] border border-[#1E1E2E] hover:border-[#4ADE80]/20 rounded-xl px-5 py-4 transition-all">
              <span class="text-2xl">📊</span>
              <div class="flex-1 min-w-0">
                <span class="text-xs font-mono text-[#4A4A6A] block mb-0.5">FINANCE</span>
                <span class="text-sm text-[#94A3B8] group-hover:text-white transition-colors truncate block">Automatización de Informes Financieros Trimestrales</span>
              </div>
              <span class="text-[#2A2A3A] group-hover:text-[#4ADE80] transition-colors">→</span>
            </a>
            <a href="/es/features/design-poster" class="group flex items-center gap-4 bg-[#111111] hover:bg-[#161622] border border-[#1E1E2E] hover:border-[#4ADE80]/20 rounded-xl px-5 py-4 transition-all">
              <span class="text-2xl">🎨</span>
              <div class="flex-1 min-w-0">
                <span class="text-xs font-mono text-[#4A4A6A] block mb-0.5">DESIGN</span>
                <span class="text-sm text-[#94A3B8] group-hover:text-white transition-colors truncate block">Generación de Pósters de Marketing en Lote</span>
              </div>
              <span class="text-[#2A2A3A] group-hover:text-[#4ADE80] transition-colors">→</span>
            </a>
            <a href="/es/features/system-diagram" class="group flex items-center gap-4 bg-[#111111] hover:bg-[#161622] border border-[#1E1E2E] hover:border-[#4ADE80]/20 rounded-xl px-5 py-4 transition-all">
              <span class="text-2xl">📐</span>
              <div class="flex-1 min-w-0">
                <span class="text-xs font-mono text-[#4A4A6A] block mb-0.5">ENGINEERING</span>
                <span class="text-sm text-[#94A3B8] group-hover:text-white transition-colors truncate block">Dibujo Automático de Arquitectura de Sistema</span>
              </div>
              <span class="text-[#2A2A3A] group-hover:text-[#4ADE80] transition-colors">→</span>
            </a>
            <a href="/es/features/tech-docs" class="group flex items-center gap-4 bg-[#111111] hover:bg-[#161622] border border-[#1E1E2E] hover:border-[#4ADE80]/20 rounded-xl px-5 py-4 transition-all">
              <span class="text-2xl">📝</span>
              <div class="flex-1 min-w-0">
                <span class="text-xs font-mono text-[#4A4A6A] block mb-0.5">DOCS</span>
                <span class="text-sm text-[#94A3B8] group-hover:text-white transition-colors truncate block">Generador de Documentación Técnica</span>
              </div>
              <span class="text-[#2A2A3A] group-hover:text-[#4ADE80] transition-colors">→</span>
            </a>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-12 lg:py-20">
      <div class="max-w-5xl mx-auto px-6 lg:px-20">
        <div class="rounded-2xl p-8 md:p-12 text-center border" style="background:#0D1020;border-color:#4ADE8033">
          <p class="font-mono text-xs tracking-[0.2em] mb-4" style="color:#4ADE80">// DESPLEGAR TU AGENTE</p>
          <h2 class="text-white text-2xl md:text-3xl font-bold mb-4">Audio profesional. Cero edición manual.</h2>
          <p class="text-[#6B7280] text-sm mb-8 max-w-md mx-auto">Sube la grabación bruta. Obtén audio listo para difusión. Sin DAW, sin plugins.</p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a href="https://app.agentputer.com/sign-up" class="btn-primary text-sm py-3 px-8 font-mono">[COMENZAR]</a>
            <a href="/es/features" class="btn-secondary text-sm py-3 px-8 font-mono">[TODOS LOS ESCENARIOS]</a>
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>
