---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MatrixRain from '../components/MatrixRain.astro';

// 从 URL 拿 session_id（可选，用于展示或后续查询订单）
const sessionId = Astro.url.searchParams.get('session_id') ?? '';
const APP_URL = 'https://app.agentputer.com';
---

<Layout
  title="Payment Successful — AgentPuter"
  description="Your AgentPuter Pro subscription is active. Your AI agent is ready to run 24/7."
  noindex={true}
>
  <MatrixRain />
  <Header />

  <main class="relative z-10 min-h-screen flex flex-col items-center justify-center px-6 py-24">
    <!-- 成功卡片 -->
    <div class="max-w-xl w-full text-center">
      <!-- 动态图标 -->
      <div class="relative mx-auto w-24 h-24 mb-8">
        <div class="absolute inset-0 rounded-full bg-accent/10 animate-ping"></div>
        <div class="relative w-24 h-24 rounded-full bg-accent/15 border border-accent/30 flex items-center justify-center">
          <svg class="w-12 h-12 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
        </div>
      </div>

      <div class="font-mono text-accent text-xs font-semibold tracking-[0.25em] mb-4">
        PAYMENT_CONFIRMED
      </div>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">
        You're all set!
      </h1>
      <p class="text-text-secondary text-lg mb-2">
        Your AgentPuter Pro subscription is now active.
      </p>
      <p class="text-text-muted text-sm mb-10 font-mono">
        // Your AI agent starts running 24/7 — right now.
      </p>

      <!-- 步骤提示 -->
      <div class="bg-dark-secondary border border-accent/20 rounded-xl p-6 mb-8 text-left">
        <p class="text-accent font-semibold text-sm mb-4 font-mono">&gt; next_steps</p>
        <ol class="space-y-3 text-sm text-text-muted">
          <li class="flex items-start gap-3">
            <span class="text-accent font-mono font-bold mt-0.5">01</span>
            <span>Check your inbox for the confirmation email from Stripe + AgentPuter.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-accent font-mono font-bold mt-0.5">02</span>
            <span>Log in to your AgentPuter dashboard — your cloud environment is ready.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-accent font-mono font-bold mt-0.5">03</span>
            <span>Connect Telegram, WhatsApp, or Slack — 2 minutes, no code needed.</span>
          </li>
        </ol>
      </div>

      <!-- CTA -->
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href={`${APP_URL}/dashboard`}
          class="btn-primary text-sm py-4 px-8 font-mono"
        >
          [GO TO DASHBOARD]
        </a>
        <a
          href="/"
          class="btn-secondary text-sm py-4 px-8 font-mono"
        >
          [BACK TO HOME]
        </a>
      </div>

      {sessionId && (
        <p class="text-text-dark text-xs font-mono mt-8">
          // session: {sessionId.slice(0, 24)}...
        </p>
      )}
    </div>
  </main>

  <Footer />
</Layout>
