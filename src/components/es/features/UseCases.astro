---
// Casos de uso - 4 tarjetas de casos de uso
const cases = [
  {
    icon: '📊', name: 'Trabajo de oficina',
    desc: '"Recopila los datos de ventas de la semana pasada, escribe un informe y envíalo por correo a mi jefe."\n\nEl agente extrae datos, los analiza, les da formato y los envía. Tú solo revisas.',
  },
  {
    icon: '🔬', name: 'Investigación',
    desc: '"Investiga las tendencias del mercado de vehículos eléctricos para 2025."\n\nBusca, lee, extrae los puntos clave y genera un cuaderno de notas, guardado para seguimiento.',
  },
  {
    icon: '💻', name: 'Desarrollo',
    desc: '"Crea una página de aterrizaje para nuestro producto."\n\nEntorno de desarrollo propio. Escribe código, ejecuta pruebas, corrige errores, hace deploy y te pregunta si se atasca.',
  },
  {
    icon: '🎨', name: 'Creatividad',
    desc: '"Diseña una campaña de redes sociales para el primer trimestre."\n\nLienzo y recursos propios. Genera borradores, itera, guarda versiones. Tú diriges.',
  },
];
---

<section class="relative py-20 bg-[#111111]">
  <div class="max-w-7xl mx-auto px-6 lg:px-20">
    <span class="block text-xs font-mono font-semibold tracking-[2px] text-accent mb-6">CASOS DE USO</span>
    <h2 class="text-2xl md:text-[32px] font-bold text-white mb-12">¿Qué puede hacer realmente tu agente?</h2>
    
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {cases.map((c) => (
        <div class="bg-[#1A1A1A] rounded-xl border border-[#222222] p-6 transition-all duration-300 hover:border-accent/30 hover:-translate-y-1">
          <span class="text-[28px] block mb-3">{c.icon}</span>
          <h3 class="text-lg font-semibold text-white mb-3">{c.name}</h3>
          <p class="text-[13px] text-[#999999] leading-relaxed whitespace-pre-line">{c.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>