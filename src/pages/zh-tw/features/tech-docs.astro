---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
---

<Layout
  title="技術文件一鍵生成 — AgentPuter"
  description="Paste API specs, get enterprise-formatted Word/PDF documentation."
>
  <Header activePage="features" />
  <main class="relative z-10">

    <!-- Hero -->
    <section class="relative pt-32 pb-16 lg:pt-40 lg:pb-20 overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-[#0A0A0A] to-[#0D0D14]"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_left,rgba(38BDF84D,transparent_60%)]" style="background: radial-gradient(ellipse at top left, #38BDF80D, transparent 60%)"></div>
      <div class="relative max-w-5xl mx-auto px-6 lg:px-20">
        <a href="/zh-tw/features" class="inline-flex items-center gap-2 text-xs font-mono text-[#4B5563] hover:text-[#38BDF8] transition-colors mb-8">
          ← 返回功能頁
        </a>
        <div class="flex flex-wrap gap-3 mb-5">
          <span class="text-xs font-bold font-mono px-2.5 py-1 rounded text-[#38BDF8] bg-[#38BDF8]/10">DOCS</span>
          <span class="text-xs font-mono text-[#4A4A6A] px-2.5 py-1 rounded border border-[#1E1E2E]">ap-docs</span>
          <span class="text-xs font-mono text-[#4A4A6A] px-2.5 py-1 rounded border border-[#1E1E2E]">LibreOffice Writer</span>
        </div>
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-5 leading-tight">
          技術文件<br/>一鍵生成
        </h1>
        <p class="text-[#9CA3AF] text-lg mb-10 max-w-2xl">API 規格 → AI 排版 → 匯出 Word/PDF</p>
        <div class="flex flex-wrap gap-3">
              <span class="inline-flex items-center gap-2 px-4 py-2 bg-[#111111] border border-[#38BDF8]/20 rounded-full text-xs text-[#94A3B8] font-mono">① 貼上 API 規格 / 大綱</span>
              <span class="inline-flex items-center gap-2 px-4 py-2 bg-[#111111] border border-[#38BDF8]/20 rounded-full text-xs text-[#94A3B8] font-mono">② Agent 排版 & 結構化</span>
              <span class="inline-flex items-center gap-2 px-4 py-2 bg-[#111111] border border-[#38BDF8]/20 rounded-full text-xs text-[#94A3B8] font-mono">③ 匯出 DOCX + PDF</span>
        </div>
      </div>
    </section>

    <!-- Session Log -->
    <section class="py-12 lg:py-20">
      <div class="max-w-5xl mx-auto px-6 lg:px-20">
        <p class="font-mono text-xs font-semibold tracking-[0.2em] mb-8" style="color:#38BDF8">// Agent 工作階段日誌</p>
        <div class="flex flex-col gap-4">

          <div class="flex items-start gap-4">
            <div class="shrink-0 w-8 h-8 rounded-full bg-[#1E293B] flex items-center justify-center text-xs font-mono text-[#94A3B8]">U</div>
            <div class="bg-[#111827] border border-[#1E293B] rounded-2xl rounded-tl-sm px-5 py-4 max-w-xl">
              <p class="text-[#E2E8F0] text-sm">"從我們的 OpenAPI 規格生成 API 參考文件。企業格式，包含 Python 和 JS 範例，變更日誌章節，匯出 DOCX 和 PDF。"</p>
            </div>
          </div>

          <div class="flex items-start gap-4 flex-row-reverse">
            <div class="shrink-0 w-8 h-8 rounded-full border flex items-center justify-center text-xs font-mono" style="background:#0C1020;border-color:#38BDF84D;color:#38BDF8">AP</div>
            <div class="rounded-2xl rounded-tr-sm px-5 py-4 max-w-xl border" style="background:#0D1020;border-color:#38BDF826">
              <p class="text-[#94A3B8] text-xs font-mono mb-3">// 規劃執行順序</p>
              <ul class="text-[#CBD5E1] text-sm space-y-1.5">
                <li class="flex gap-2"><span class="text-[#38BDF8]">→</span> 解析 openapi.yaml — 提取端點和 Schema</li>
                <li class="flex gap-2"><span class="text-[#38BDF8]">→</span> 套用企業 .dotx 範本</li>
                <li class="flex gap-2"><span class="text-[#38BDF8]">→</span> 生成含參數和回應的端點章節</li>
                <li class="flex gap-2"><span class="text-[#38BDF8]">→</span> 插入 Python + JS 程式碼範例</li>
                <li class="flex gap-2"><span class="text-[#38BDF8]">→</span> 自動生成目錄 + 索引 + changelog</li>
              </ul>
            </div>
          </div>

          
          <div class="bg-[#080810] border border-[#1E1E2E] rounded-2xl p-6 font-mono text-xs">
            <div class="flex items-center gap-2 mb-5">
              <span class="w-3 h-3 rounded-full bg-[#FF5F57]"></span><span class="w-3 h-3 rounded-full bg-[#FEBC2E]"></span><span class="w-3 h-3 rounded-full bg-[#28C840]"></span>
              <span class="text-[#4B5563] ml-2">agentputer — ap-docs executor</span>
            </div>
            <div class="space-y-1.5">
              <p><span class="text-[#2A2A3A]">$ </span><span class="text-[#94A3B8]">ap-docs new --type api-reference --template enterprise-docs</span></p>
              <p class="text-[#4ADE80] pl-4">✓ Document created from enterprise template</p>
              <p class="mt-3"><span class="text-[#2A2A3A]">$ </span><span class="text-[#94A3B8]">ap-docs parse-openapi --input openapi.yaml --sections endpoints,schemas</span></p>
              <p class="text-[#4ADE80] pl-4">✓ Parsed: 42 endpoints, 18 request/response schemas</p>
              <p class="mt-3"><span class="text-[#2A2A3A]">$ </span><span class="text-[#94A3B8]">ap-docs generate-sections --code-examples python,javascript</span></p>
              <p class="text-[#4ADE80] pl-4">✓ 42 endpoint sections with dual-language code blocks</p>
              <p class="mt-3"><span class="text-[#2A2A3A]">$ </span><span class="text-[#94A3B8]">ap-docs export --word --pdf --toc --index</span></p>
              <p class="text-[#4ADE80] pl-4">✓ api-reference-v2.docx (84 pages) · api-reference-v2.pdf</p>
            </div>
            <div class="mt-5 pt-4 border-t border-[#1E1E2E] flex items-center justify-between">
              <span class="text-[#4B5563]">elapsed: 54s</span>
              <div class="flex items-center gap-2 rounded-lg px-3 py-1.5 border" style="background:#0A1520;border-color:#38BDF833">
                <span style="color:#38BDF8">📝</span><span style="color:#38BDF8">api-reference-v2.docx</span><span class="text-[#4B5563] ml-2">84 pages · enterprise</span>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Capabilities -->
    <section class="py-12 lg:py-16 bg-[#080810]">
      <div class="max-w-5xl mx-auto px-6 lg:px-20">
        <p class="font-mono text-xs font-semibold tracking-[0.2em] mb-8" style="color:#38BDF8">// 此情境支援的功能</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="flex gap-4 bg-[#0D0D1A] border border-[#1E1E2E] rounded-xl p-5">
              <span class="text-2xl shrink-0 mt-0.5">📋</span>
              <div>
                <h3 class="text-white text-sm font-semibold mb-1">OpenAPI / Swagger 匯入</h3>
                <p class="text-[#6B7280] text-xs leading-relaxed">解析 YAML 或 JSON 規格檔案，自動生成端點章節。</p>
              </div>
            </div>
            <div class="flex gap-4 bg-[#0D0D1A] border border-[#1E1E2E] rounded-xl p-5">
              <span class="text-2xl shrink-0 mt-0.5">💻</span>
              <div>
                <h3 class="text-white text-sm font-semibold mb-1">多語言程式碼範例</h3>
                <p class="text-[#6B7280] text-xs leading-relaxed">為每個端點自動生成 curl、Python、JavaScript、Go、Java 範例。</p>
              </div>
            </div>
            <div class="flex gap-4 bg-[#0D0D1A] border border-[#1E1E2E] rounded-xl p-5">
              <span class="text-2xl shrink-0 mt-0.5">📑</span>
              <div>
                <h3 class="text-white text-sm font-semibold mb-1">自動目錄 + 索引</h3>
                <p class="text-[#6B7280] text-xs leading-relaxed">從標題生成目錄和全文索引，PDF 中可點擊導覽。</p>
              </div>
            </div>
            <div class="flex gap-4 bg-[#0D0D1A] border border-[#1E1E2E] rounded-xl p-5">
              <span class="text-2xl shrink-0 mt-0.5">🏢</span>
              <div>
                <h3 class="text-white text-sm font-semibold mb-1">企業範本支援</h3>
                <p class="text-[#6B7280] text-xs leading-relaxed">套用含公司 Logo、頁首和頁尾的 .dotx 範本。</p>
              </div>
            </div>
            <div class="flex gap-4 bg-[#0D0D1A] border border-[#1E1E2E] rounded-xl p-5">
              <span class="text-2xl shrink-0 mt-0.5">📄</span>
              <div>
                <h3 class="text-white text-sm font-semibold mb-1">多格式輸出</h3>
                <p class="text-[#6B7280] text-xs leading-relaxed">匯出為 DOCX、PDF、ODT 或 HTML。</p>
              </div>
            </div>
            <div class="flex gap-4 bg-[#0D0D1A] border border-[#1E1E2E] rounded-xl p-5">
              <span class="text-2xl shrink-0 mt-0.5">🔄</span>
              <div>
                <h3 class="text-white text-sm font-semibold mb-1">規格變更自動更新</h3>
                <p class="text-[#6B7280] text-xs leading-relaxed">以更新後的規格檔案重新執行，文件增量更新。</p>
              </div>
            </div>
        </div>
      </div>
    </section>

    <!-- Other Scenarios -->
    <section class="py-12 lg:py-16">
      <div class="max-w-5xl mx-auto px-6 lg:px-20">
        <p class="font-mono text-xs text-[#4B5563] font-semibold tracking-[0.2em] mb-6">// 其他情境</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <a href="/zh-tw/features/financial-report" class="group flex items-center gap-4 bg-[#111111] hover:bg-[#161622] border border-[#1E1E2E] hover:border-[#38BDF8]/20 rounded-xl px-5 py-4 transition-all">
              <span class="text-2xl">📊</span>
              <div class="flex-1 min-w-0">
                <span class="text-xs font-mono text-[#4A4A6A] block mb-0.5">FINANCE</span>
                <span class="text-sm text-[#94A3B8] group-hover:text-white transition-colors truncate block">季度財務報告 自動化</span>
              </div>
              <span class="text-[#2A2A3A] group-hover:text-[#38BDF8] transition-colors">→</span>
            </a>
            <a href="/zh-tw/features/design-poster" class="group flex items-center gap-4 bg-[#111111] hover:bg-[#161622] border border-[#1E1E2E] hover:border-[#38BDF8]/20 rounded-xl px-5 py-4 transition-all">
              <span class="text-2xl">🎨</span>
              <div class="flex-1 min-w-0">
                <span class="text-xs font-mono text-[#4A4A6A] block mb-0.5">DESIGN</span>
                <span class="text-sm text-[#94A3B8] group-hover:text-white transition-colors truncate block">行銷海報 批次生成</span>
              </div>
              <span class="text-[#2A2A3A] group-hover:text-[#38BDF8] transition-colors">→</span>
            </a>
            <a href="/zh-tw/features/system-diagram" class="group flex items-center gap-4 bg-[#111111] hover:bg-[#161622] border border-[#1E1E2E] hover:border-[#38BDF8]/20 rounded-xl px-5 py-4 transition-all">
              <span class="text-2xl">📐</span>
              <div class="flex-1 min-w-0">
                <span class="text-xs font-mono text-[#4A4A6A] block mb-0.5">ENGINEERING</span>
                <span class="text-sm text-[#94A3B8] group-hover:text-white transition-colors truncate block">系統架構圖 自動繪製</span>
              </div>
              <span class="text-[#2A2A3A] group-hover:text-[#38BDF8] transition-colors">→</span>
            </a>
            <a href="/zh-tw/features/audio-production" class="group flex items-center gap-4 bg-[#111111] hover:bg-[#161622] border border-[#1E1E2E] hover:border-[#38BDF8]/20 rounded-xl px-5 py-4 transition-all">
              <span class="text-2xl">🎵</span>
              <div class="flex-1 min-w-0">
                <span class="text-xs font-mono text-[#4A4A6A] block mb-0.5">AUDIO</span>
                <span class="text-sm text-[#94A3B8] group-hover:text-white transition-colors truncate block">Podcast 與音訊 後期處理</span>
              </div>
              <span class="text-[#2A2A3A] group-hover:text-[#38BDF8] transition-colors">→</span>
            </a>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-12 lg:py-20">
      <div class="max-w-5xl mx-auto px-6 lg:px-20">
        <div class="rounded-2xl p-8 md:p-12 text-center border" style="background:#0D1020;border-color:#38BDF833">
          <p class="font-mono text-xs tracking-[0.2em] mb-4" style="color:#38BDF8">// 部署你的 Agent</p>
          <h2 class="text-white text-2xl md:text-3xl font-bold mb-4">你的 API 規格，一分鐘內生成企業級文件。</h2>
          <p class="text-[#6B7280] text-sm mb-8 max-w-md mx-auto">不再從 Notion 複製貼上到 Word。AgentPuter 直接從規格檔案生成格式完美的技術文件。</p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a href="https://app.agentputer.com/sign-up" class="btn-primary text-sm py-3 px-8 font-mono">[立即開始]</a>
            <a href="/zh-tw/features" class="btn-secondary text-sm py-3 px-8 font-mono">[全部場景]</a>
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>
