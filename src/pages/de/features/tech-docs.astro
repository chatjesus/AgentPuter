---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const otherScenarios = [
  { slug: "financial-report",  icon: "📊", tag: "FINANCE",      title: "Automatisierung von Quartalsfinanzberichten" },
  { slug: "design-poster",     icon: "🎨", tag: "DESIGN",       title: "Stapelgenerierung von Marketing-Postern" },
  { slug: "system-diagram",    icon: "📐", tag: "ENGINEERING",  title: "Automatisches Zeichnen von Systemarchitekturen" },
  { slug: "audio-production",  icon: "🎵", tag: "AUDIO",        title: "Podcast- & Audio-Postproduktion" },
];
---

<Layout
  title="Generator für technische Dokumentation — AgentPuter"
  description="API-Spezifikationen einfügen, Word/PDF-Dokumentation im Enterprise-Format mit Inhaltsverzeichnis, Code-Blöcken und Tabellen erhalten. Unterstützt durch LibreOffice headless via ap-docs."
>
  <Header activePage="features" />
  <main class="relative z-10">

    <!-- Hero -->
    <section class="relative pt-32 pb-16 lg:pt-40 lg:pb-20 overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-[#0A0A0A] to-[#0D0D14]"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_left,rgba(56,189,248,0.04),transparent_60%)]"></div>
      <div class="relative max-w-5xl mx-auto px-6 lg:px-20">
        <a href="/de/features" class="inline-flex items-center gap-2 text-xs font-mono text-[#4B5563] hover:text-[#38BDF8] transition-colors mb-8">
          ← zurück zu Funktionen
        </a>
        <div class="flex flex-wrap gap-3 mb-5">
          <span class="text-xs font-bold font-mono px-2.5 py-1 rounded text-[#38BDF8] bg-[#38BDF8]/10">DOCS</span>
          <span class="text-xs font-mono text-[#4A4A6A] px-2.5 py-1 rounded border border-[#1E1E2E]">ap-docs</span>
          <span class="text-xs font-mono text-[#4A4A6A] px-2.5 py-1 rounded border border-[#1E1E2E]">LibreOffice Writer</span>
        </div>
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-5 leading-tight">
          Generator für technische<br/>Dokumentation
        </h1>
        <p class="text-[#9CA3AF] text-lg mb-10 max-w-2xl">
          API-Spezifikationen → KI-Formatierung → Word/PDF-Export
        </p>
        <div class="flex flex-wrap gap-3">
          {["① API-Spezifikation / Entwurf einfügen", "② Agent formatiert & strukturiert", "③ DOCX + PDF exportieren"].map((step) => (
            <span class="inline-flex items-center gap-2 px-4 py-2 bg-[#111111] border border-[#38BDF8]/20 rounded-full text-xs text-[#94A3B8] font-mono">
              {step}
            </span>
          ))}
        </div>
      </div>
    </section>

    <!-- Session Log -->
    <section class="py-12 lg:py-20">
      <div class="max-w-5xl mx-auto px-6 lg:px-20">
        <p class="font-mono text-xs text-[#38BDF8] font-semibold tracking-[0.2em] mb-8">// AGENT SESSION LOG</p>
        <div class="flex flex-col gap-4">

          <div class="flex items-start gap-4">
            <div class="shrink-0 w-8 h-8 rounded-full bg-[#1E293B] flex items-center justify-center text-xs font-mono text-[#94A3B8]">U</div>
            <div class="bg-[#111827] border border-[#1E293B] rounded-2xl rounded-tl-sm px-5 py-4 max-w-xl">
              <p class="text-[#E2E8F0] text-sm">"Erstelle eine API-Referenzdokumentation aus unserer OpenAPI-Spezifikation. Enterprise-Format, inklusive Code-Beispielen in Python und JS, füge einen Changelog-Abschnitt hinzu, Export als DOCX und PDF."</p>
            </div>
          </div>

          <div class="flex items-start gap-4 flex-row-reverse">
            <div class="shrink-0 w-8 h-8 rounded-full bg-[#0C1929] border border-[#38BDF8]/30 flex items-center justify-center text-xs font-mono text-[#38BDF8]">AP</div>
            <div class="bg-[#0D1520] border border-[#38BDF8]/15 rounded-2xl rounded-tr-sm px-5 py-4 max-w-xl">
              <p class="text-[#94A3B8] text-xs font-mono mb-3">// Analysiere OpenAPI-Spezifikation: 42 Endpunkte, 18 Schemata</p>
              <ul class="text-[#CBD5E1] text-sm space-y-1.5">
                <li class="flex gap-2"><span class="text-[#38BDF8]">→</span> openapi.yaml analysieren — Endpunkte & Schemata extrahieren</li>
                <li class="flex gap-2"><span class="text-[#38BDF8]">→</span> Enterprise .dotx-Vorlage anwenden</li>
                <li class="flex gap-2"><span class="text-[#38BDF8]">→</span> Endpunkt-Abschnitte mit Parametern + Antworten generieren</li>
                <li class="flex gap-2"><span class="text-[#38BDF8]">→</span> Python + JS Code-Beispiele pro Endpunkt einfügen</li>
                <li class="flex gap-2"><span class="text-[#38BDF8]">→</span> Inhaltsverzeichnis + Index + Changelog automatisch generieren</li>
                <li class="flex gap-2"><span class="text-[#38BDF8]">→</span> DOCX + PDF exportieren</li>
              </ul>
            </div>
          </div>

          <div class="bg-[#080810] border border-[#1E1E2E] rounded-2xl p-6 font-mono text-xs">
            <div class="flex items-center gap-2 mb-5">
              <span class="w-3 h-3 rounded-full bg-[#FF5F57]"></span>
              <span class="w-3 h-3 rounded-full bg-[#FEBC2E]"></span>
              <span class="w-3 h-3 rounded-full bg-[#28C840]"></span>
              <span class="text-[#4B5563] ml-2">agentputer — ap-docs executor</span>
            </div>
            <div class="space-y-1.5">
              <p><span class="text-[#2A2A3A]">$ </span><span class="text-[#94A3B8]">ap-docs new --type api-reference --template enterprise-docs</span></p>
              <p class="text-[#4ADE80] pl-4">✓ Dokument aus Enterprise-Vorlage erstellt (Unternehmens-Branding angewendet)</p>
              <p class="mt-3"><span class="text-[#2A2A3A]">$ </span><span class="text-[#94A3B8]">ap-docs parse-openapi --input openapi.yaml --sections endpoints,schemas</span></p>
              <p class="text-[#4ADE80] pl-4">✓ Analysiert: 42 Endpunkte, 18 Anfrage-/Antwort-Schemata</p>
              <p class="mt-3"><span class="text-[#2A2A3A]">$ </span><span class="text-[#94A3B8]">ap-docs generate-sections --code-examples python,javascript</span></p>
              <p class="text-[#4ADE80] pl-4">✓ 42 Endpunkt-Abschnitte mit zweisprachigen Code-Blöcken generiert</p>
              <p class="mt-3"><span class="text-[#2A2A3A]">$ </span><span class="text-[#94A3B8]">ap-docs add-section --type changelog --heading "Version History"</span></p>
              <p class="text-[#4ADE80] pl-4">✓ Changelog-Abschnitt angehängt</p>
              <p class="mt-3"><span class="text-[#2A2A3A]">$ </span><span class="text-[#94A3B8]">ap-docs export --word --pdf --toc --index</span></p>
              <p class="text-[#4ADE80] pl-4">✓ api-reference-v2.docx (84 pages) · api-reference-v2.pdf (84 pages)</p>
            </div>
            <div class="mt-5 pt-4 border-t border-[#1E1E2E] flex items-center justify-between">
              <span class="text-[#4B5563]">elapsed: 54s</span>
              <div class="flex items-center gap-2 bg-[#0A1A0F] border border-[#38BDF8]/20 rounded-lg px-3 py-1.5">
                <span class="text-[#38BDF8]">📝</span>
                <span class="text-[#38BDF8]">api-reference-v2.docx</span>
                <span class="text-[#4B5563] ml-2">84 pages · enterprise format</span>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Capabilities -->
    <section class="py-12 lg:py-16 bg-[#080810]">
      <div class="max-w-5xl mx-auto px-6 lg:px-20">
        <p class="font-mono text-xs text-[#38BDF8] font-semibold tracking-[0.2em] mb-8">// WHAT THIS SCENARIO SUPPORTS</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {[
            { icon: "📋", title: "OpenAPI / Swagger Import", desc: "YAML- oder JSON-Spezifikationsdateien analysieren. Automatische Generierung von Endpunkt-Abschnitten, Parametern und Antwort-Schemata." },
            { icon: "💻", title: "Mehrsprachige Code-Beispiele", desc: "Automatische Generierung von curl, Python, JavaScript, Go, Java Beispielen für jeden Endpunkt." },
            { icon: "📑", title: "Automatisches Inhaltsverzeichnis + Index", desc: "Inhaltsverzeichnis und Volltextindex aus Dokumentüberschriften generiert. Klickbar navigierbar im PDF." },
            { icon: "🏢", title: "Unterstützung für Enterprise-Vorlagen", desc: "Anwendung von gebrandeten .dotx-Vorlagen mit Firmenlogo, Kopf- und Fußzeilen sowie Styleguides." },
            { icon: "📄", title: "Multi-Format-Ausgabe", desc: "Export als DOCX, PDF, ODT oder HTML. Beibehaltung von Code-Blöcken, Tabellen und Formatierung über alle Formate hinweg." },
            { icon: "🔄", title: "Automatisches Update bei Spezifikationsänderungen", desc: "Erneute Ausführung mit aktualisierter Spezifikationsdatei — Dokumente werden inkrementell aktualisiert, Änderungen werden verfolgt." },
          ].map((cap) => (
            <div class="flex gap-4 bg-[#0D0D1A] border border-[#1E1E2E] rounded-xl p-5">
              <span class="text-2xl shrink-0 mt-0.5">{cap.icon}</span>
              <div>
                <h3 class="text-white text-sm font-semibold mb-1">{cap.title}</h3>
                <p class="text-[#6B7280] text-xs leading-relaxed">{cap.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Other Scenarios -->
    <section class="py-12 lg:py-16">
      <div class="max-w-5xl mx-auto px-6 lg:px-20">
        <p class="font-mono text-xs text-[#4B5563] font-semibold tracking-[0.2em] mb-6">// OTHER SCENARIOS</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {otherScenarios.map((s) => (
            <a href={`/de/features/${s.slug}`} class="group flex items-center gap-4 bg-[#111111] hover:bg-[#161622] border border-[#1E1E2E] hover:border-[#38BDF8]/20 rounded-xl px-5 py-4 transition-all">
              <span class="text-2xl">{s.icon}</span>
              <div class="flex-1 min-w-0">
                <span class="text-xs font-mono text-[#4A4A6A] block mb-0.5">{s.tag}</span>
                <span class="text-sm text-[#94A3B8] group-hover:text-white transition-colors truncate block">{s.title}</span>
              </div>
              <span class="text-[#2A2A3A] group-hover:text-[#38BDF8] transition-colors">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-12 lg:py-20">
      <div class="max-w-5xl mx-auto px-6 lg:px-20">
        <div class="bg-[#0D1520] border border-[#38BDF8]/20 rounded-2xl p-8 md:p-12 text-center">
          <p class="font-mono text-xs text-[#38BDF8] tracking-[0.2em] mb-4">// DEPLOY YOUR AGENT</p>
          <h2 class="text-white text-2xl md:text-3xl font-bold mb-4">Ihre API-Spezifikation. Enterprise-Dokumente in weniger als einer Minute.</h2>
          <p class="text-[#6B7280] text-sm mb-8 max-w-md mx-auto">Kein Kopieren und Einfügen mehr von Notion nach Word. AgentPuter generiert perfekt formatierte Dokumentation direkt aus Ihrer Spezifikation.</p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a href="https://app.agentputer.com/sign-up" class="btn-primary text-sm py-3 px-8 font-mono">[JETZT STARTEN]</a>
            <a href="/de/features" class="btn-secondary text-sm py-3 px-8 font-mono">[ALLE SZENARIEN]</a>
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>