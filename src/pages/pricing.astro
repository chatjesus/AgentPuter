---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MatrixRain from '../components/MatrixRain.astro';

// Pricing page structured data
const pricingSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'AgentPuter Pro',
  description: 'Your own AI agent that works 24/7. Claude 4.5 included. Set up in 2 minutes.',
  brand: { '@type': 'Brand', name: 'AgentPuter' },
  offers: {
    '@type': 'Offer',
    price: '29.00',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    priceValidUntil: '2027-12-31',
    url: 'https://app.agentputer.com/subscribe',
  },
};

const APP_URL = 'https://app.agentputer.com';
---

<Layout
  title="Pricing - AgentPuter | Your Always-On AI Agent"
  description="AgentPuter Pro: $29.99/month. Your own AI agent that works 24/7. Claude 4.5 included. 15+ messaging channels. 500+ skills. No coding needed."
  tags={['AgentPuter', 'Pricing', 'AI Agent', 'AI Automation', 'No Code']}
>
  <fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(pricingSchema)} />
  </fragment>

  <MatrixRain />
  <Header activePage="pricing" />

  <main class="relative z-10">
    <!-- Pricing Hero -->
    <section class="relative pt-32 pb-12 lg:pt-40 lg:pb-16 overflow-hidden">
