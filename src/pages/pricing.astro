<script is:inline>
  // ── FAQ accordion ────────────────────────────────────────────
  document.querySelectorAll('.faq-toggle').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var item = btn.closest('.faq-item');
      var content = item.querySelector('.faq-content');
      var icon = item.querySelector('.faq-icon');
      document.querySelectorAll('.faq-item').forEach(function(other) {
        if (other !== item) {
          other.querySelector('.faq-content').classList.add('hidden');
          other.querySelector('.faq-icon').textContent = '+';
        }
      });
      content.classList.toggle('hidden');
      icon.textContent = content.classList.contains('hidden') ? '+' : '−';
    });
  });

  // ── Stripe Checkout ──────────────────────────────────────────
  async function startCheckout(btn) {
    if (!btn) return;
    var originalText = btn.textContent;
    btn.disabled = true;
    btn.textContent = 'Redirecting...';

    try {
      var res = await fetch('/api/create-checkout-session', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({}),
      });

      var data = await res.json();

      if (!res.ok || !data.url) {
        throw new Error(data.error || 'Failed to create checkout session');
      }

      window.location.href = data.url;
    } catch (err) {
      console.error('[Stripe]', err);
      alert('Something went wrong. Please try again or contact support.');
      btn.disabled = false;
      btn.textContent = originalText;
    }
  }

  var proBtn = document.getElementById('pro-subscribe-btn');
  var bottomBtn = document.getElementById('bottom-cta-btn');

  if (proBtn) proBtn.addEventListener('click', function() { startCheckout(proBtn); });
  if (bottomBtn) bottomBtn.addEventListener('click', function() { startCheckout(bottomBtn); });

  // 如果从 Stripe 取消返回，短暂提示
  if (window.location.search.includes('canceled=1')) {
    var notice = document.createElement('div');
    notice.style.cssText = 'position:fixed;top:80px;left:50%;transform:translateX(-50%);background:#1a1a2e;border:1px solid #444;color:#aaa;padding:12px 24px;border-radius:8px;font-size:13px;z-index:9999;font-family:monospace;';
    notice.textContent = '// Checkout canceled — nothing was charged.';
    document.body.appendChild(notice);
    setTimeout(function() { notice.remove(); }, 4000);
  }
</script>
