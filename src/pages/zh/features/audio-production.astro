---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/zh/Header.astro';
import Footer from '../../../components/zh/Footer.astro';
---

<Layout
  title="播客与音频后期处理 — AgentPuter"
  description="Upload raw recordings, get broadcast-quality MP3 in seconds."
>
  <Header activePage="features" />
  <main class="relative z-10">

    <!-- Hero -->
    <section class="relative pt-32 pb-16 lg:pt-40 lg:pb-20 overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-[#0A0A0A] to-[#0D0D14]"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_left,rgba(4ADE804D,transparent_60%)]" style="background: radial-gradient(ellipse at top left, #4ADE800D, transparent 60%)"></div>
      <div class="relative max-w-5xl mx-auto px-6 lg:px-20">
        <a href="/zh/features" class="inline-flex items-center gap-2 text-xs font-mono text-[#4B5563] hover:text-[#4ADE80] transition-colors mb-8">
          ← 返回功能页
        </a>
        <div class="flex flex-wrap gap-3 mb-5">
          <span class="text-xs font-bold font-mono px-2.5 py-1 rounded text-[#4ADE80] bg-[#4ADE80]/10">AUDIO</span>
          <span class="text-xs font-mono text-[#4A4A6A] px-2.5 py-1 rounded border border-[#1E1E2E]">ap-audio</span>
          <span class="text-xs font-mono text-[#4A4A6A] px-2.5 py-1 rounded border border-[#1E1E2E]">sox + ffmpeg</span>
        </div>
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-5 leading-tight">
          播客与音频<br/>后期处理
        </h1>
        <p class="text-[#9CA3AF] text-lg mb-10 max-w-2xl">上传录音 → AI 降噪剪辑 → 导出广播级 MP3</p>
        <div class="flex flex-wrap gap-3">
              <span class="inline-flex items-center gap-2 px-4 py-2 bg-[#111111] border border-[#4ADE80]/20 rounded-full text-xs text-[#94A3B8] font-mono">① 上传原始 WAV/MP3</span>
              <span class="inline-flex items-center gap-2 px-4 py-2 bg-[#111111] border border-[#4ADE80]/20 rounded-full text-xs text-[#94A3B8] font-mono">② Agent 降噪 & 响度标准化</span>
              <span class="inline-flex items-center gap-2 px-4 py-2 bg-[#111111] border border-[#4ADE80]/20 rounded-full text-xs text-[#94A3B8] font-mono">③ 广播级 MP3 完成</span>
        </div>
      </div>
    </section>

    <!-- Session Log -->
    <section class="py-12 lg:py-20">
      <div class="max-w-5xl mx-auto px-6 lg:px-20">
        <p class="font-mono text-xs font-semibold tracking-[0.2em] mb-8" style="color:#4ADE80">// Agent 会话日志</p>
        <div class="flex flex-col gap-4">

          <div class="flex items-start gap-4">
            <div class="shrink-0 w-8 h-8 rounded-full bg-[#1E293B] flex items-center justify-center text-xs font-mono text-[#94A3B8]">U</div>
            <div class="bg-[#111827] border border-[#1E293B] rounded-2xl rounded-tl-sm px-5 py-4 max-w-xl">
              <p class="text-[#E2E8F0] text-sm">"处理播客第 12 集。去除背景噪音，标准化至 -14 LUFS，修剪 2 秒以上的静音段，导出 128kbps MP3。"</p>
            </div>
          </div>

          <div class="flex items-start gap-4 flex-row-reverse">
            <div class="shrink-0 w-8 h-8 rounded-full border flex items-center justify-center text-xs font-mono" style="background:#0C1020;border-color:#4ADE804D;color:#4ADE80">AP</div>
            <div class="rounded-2xl rounded-tr-sm px-5 py-4 max-w-xl border" style="background:#0D1020;border-color:#4ADE8026">
              <p class="text-[#94A3B8] text-xs font-mono mb-3">// 规划执行顺序</p>
              <ul class="text-[#CBD5E1] text-sm space-y-1.5">
                <li class="flex gap-2"><span class="text-[#4ADE80]">→</span> 从静音段采样噪声特征</li>
                <li class="flex gap-2"><span class="text-[#4ADE80]">→</span> 应用降噪（sox noisered）</li>
                <li class="flex gap-2"><span class="text-[#4ADE80]">→</span> EBU R128 响度标准化至 -14 LUFS</li>
                <li class="flex gap-2"><span class="text-[#4ADE80]">→</span> 修剪 2 秒以上的静音段</li>
                <li class="flex gap-2"><span class="text-[#4ADE80]">→</span> 通过 ffmpeg 转换为 128kbps MP3</li>
              </ul>
            </div>
          </div>

          
          <div class="bg-[#080810] border border-[#1E1E2E] rounded-2xl p-6 font-mono text-xs">
            <div class="flex items-center gap-2 mb-5">
              <span class="w-3 h-3 rounded-full bg-[#FF5F57]"></span><span class="w-3 h-3 rounded-full bg-[#FEBC2E]"></span><span class="w-3 h-3 rounded-full bg-[#28C840]"></span>
              <span class="text-[#4B5563] ml-2">agentputer — ap-audio executor</span>
            </div>
            <div class="space-y-1.5">
              <p><span class="text-[#2A2A3A]">$ </span><span class="text-[#94A3B8]">ap-audio analyze --input ep12-raw.wav</span></p>
              <p class="text-[#4ADE80] pl-4">✓ Duration: 47m 23s · Peak: -2.1 dBFS · Noise floor: -45 dB</p>
              <p class="mt-3"><span class="text-[#2A2A3A]">$ </span><span class="text-[#94A3B8]">ap-audio denoise --input ep12-raw.wav --profile auto</span></p>
              <p class="text-[#4ADE80] pl-4">✓ Noise profile sampled · Applied: -18dB noise reduction</p>
              <p class="mt-3"><span class="text-[#2A2A3A]">$ </span><span class="text-[#94A3B8]">ap-audio loudnorm --target -14 --tp -1.5 --lra 11</span></p>
              <p class="text-[#4ADE80] pl-4">✓ Integrated loudness: -23.4 LUFS → -14.0 LUFS (EBU R128)</p>
              <p class="mt-3"><span class="text-[#2A2A3A]">$ </span><span class="text-[#94A3B8]">ap-audio trim --remove-silence --threshold 0.02 --min-duration 2.0</span></p>
              <p class="text-[#4ADE80] pl-4">✓ Removed 4m 12s of silence · Final: 43m 11s</p>
              <p class="mt-3"><span class="text-[#2A2A3A]">$ </span><span class="text-[#94A3B8]">ap-audio convert --mp3 128k --output podcast-ep12-final.mp3</span></p>
              <p class="text-[#4ADE80] pl-4">✓ Exported: podcast-ep12-final.mp3 · 128kbps</p>
            </div>
            <div class="mt-5 pt-4 border-t border-[#1E1E2E] flex items-center justify-between">
              <span class="text-[#4B5563]">elapsed: 2m 18s</span>
              <div class="flex items-center gap-2 rounded-lg px-3 py-1.5 border" style="background:#07100A;border-color:#4ADE8033">
                <span style="color:#4ADE80">🎵</span><span style="color:#4ADE80">podcast-ep12-final.mp3</span><span class="text-[#4B5563] ml-2">128kbps · 43m 11s</span>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Capabilities -->
    <section class="py-12 lg:py-16 bg-[#080810]">
      <div class="max-w-5xl mx-auto px-6 lg:px-20">
        <p class="font-mono text-xs font-semibold tracking-[0.2em] mb-8" style="color:#4ADE80">// 此场景支持的能力</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="flex gap-4 bg-[#0D0D1A] border border-[#1E1E2E] rounded-xl p-5">
              <span class="text-2xl shrink-0 mt-0.5">🔇</span>
              <div>
                <h3 class="text-white text-sm font-semibold mb-1">自适应降噪</h3>
                <p class="text-[#6B7280] text-xs leading-relaxed">从静音段自动采样噪声轮廓，适用于空调噪声、室内本底噪声等。</p>
              </div>
            </div>
            <div class="flex gap-4 bg-[#0D0D1A] border border-[#1E1E2E] rounded-xl p-5">
              <span class="text-2xl shrink-0 mt-0.5">📊</span>
              <div>
                <h3 class="text-white text-sm font-semibold mb-1">EBU R128 响度标准</h3>
                <p class="text-[#6B7280] text-xs leading-relaxed">播客平台行业标准（Spotify -14 LUFS、Apple -16 LUFS）。</p>
              </div>
            </div>
            <div class="flex gap-4 bg-[#0D0D1A] border border-[#1E1E2E] rounded-xl p-5">
              <span class="text-2xl shrink-0 mt-0.5">✂️</span>
              <div>
                <h3 class="text-white text-sm font-semibold mb-1">静音检测与修剪</h3>
                <p class="text-[#6B7280] text-xs leading-relaxed">可配置阈值，精准去除死寂片段而不影响语音。</p>
              </div>
            </div>
            <div class="flex gap-4 bg-[#0D0D1A] border border-[#1E1E2E] rounded-xl p-5">
              <span class="text-2xl shrink-0 mt-0.5">🔄</span>
              <div>
                <h3 class="text-white text-sm font-semibold mb-1">格式转换</h3>
                <p class="text-[#6B7280] text-xs leading-relaxed">WAV、FLAC、OGG、AAC、MP3 — 任意编解码器、任意码率。</p>
              </div>
            </div>
            <div class="flex gap-4 bg-[#0D0D1A] border border-[#1E1E2E] rounded-xl p-5">
              <span class="text-2xl shrink-0 mt-0.5">🎚️</span>
              <div>
                <h3 class="text-white text-sm font-semibold mb-1">多轨道混音</h3>
                <p class="text-[#6B7280] text-xs leading-relaxed">将片头/片尾音乐与人声轨道混合，独立调节音量。</p>
              </div>
            </div>
            <div class="flex gap-4 bg-[#0D0D1A] border border-[#1E1E2E] rounded-xl p-5">
              <span class="text-2xl shrink-0 mt-0.5">📋</span>
              <div>
                <h3 class="text-white text-sm font-semibold mb-1">音频分析报告</h3>
                <p class="text-[#6B7280] text-xs leading-relaxed">获取时长、峰值电平、响度和削波统计。</p>
              </div>
            </div>
        </div>
      </div>
    </section>

    <!-- Other Scenarios -->
    <section class="py-12 lg:py-16">
      <div class="max-w-5xl mx-auto px-6 lg:px-20">
        <p class="font-mono text-xs text-[#4B5563] font-semibold tracking-[0.2em] mb-6">// 其他场景</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <a href="/zh/features/financial-report" class="group flex items-center gap-4 bg-[#111111] hover:bg-[#161622] border border-[#1E1E2E] hover:border-[#4ADE80]/20 rounded-xl px-5 py-4 transition-all">
              <span class="text-2xl">📊</span>
              <div class="flex-1 min-w-0">
                <span class="text-xs font-mono text-[#4A4A6A] block mb-0.5">FINANCE</span>
                <span class="text-sm text-[#94A3B8] group-hover:text-white transition-colors truncate block">季度财务报告 自动化</span>
              </div>
              <span class="text-[#2A2A3A] group-hover:text-[#4ADE80] transition-colors">→</span>
            </a>
            <a href="/zh/features/design-poster" class="group flex items-center gap-4 bg-[#111111] hover:bg-[#161622] border border-[#1E1E2E] hover:border-[#4ADE80]/20 rounded-xl px-5 py-4 transition-all">
              <span class="text-2xl">🎨</span>
              <div class="flex-1 min-w-0">
                <span class="text-xs font-mono text-[#4A4A6A] block mb-0.5">DESIGN</span>
                <span class="text-sm text-[#94A3B8] group-hover:text-white transition-colors truncate block">营销海报 批量生成</span>
              </div>
              <span class="text-[#2A2A3A] group-hover:text-[#4ADE80] transition-colors">→</span>
            </a>
            <a href="/zh/features/system-diagram" class="group flex items-center gap-4 bg-[#111111] hover:bg-[#161622] border border-[#1E1E2E] hover:border-[#4ADE80]/20 rounded-xl px-5 py-4 transition-all">
              <span class="text-2xl">📐</span>
              <div class="flex-1 min-w-0">
                <span class="text-xs font-mono text-[#4A4A6A] block mb-0.5">ENGINEERING</span>
                <span class="text-sm text-[#94A3B8] group-hover:text-white transition-colors truncate block">系统架构图 自动绘制</span>
              </div>
              <span class="text-[#2A2A3A] group-hover:text-[#4ADE80] transition-colors">→</span>
            </a>
            <a href="/zh/features/tech-docs" class="group flex items-center gap-4 bg-[#111111] hover:bg-[#161622] border border-[#1E1E2E] hover:border-[#4ADE80]/20 rounded-xl px-5 py-4 transition-all">
              <span class="text-2xl">📝</span>
              <div class="flex-1 min-w-0">
                <span class="text-xs font-mono text-[#4A4A6A] block mb-0.5">DOCS</span>
                <span class="text-sm text-[#94A3B8] group-hover:text-white transition-colors truncate block">技术文档 一键生成</span>
              </div>
              <span class="text-[#2A2A3A] group-hover:text-[#4ADE80] transition-colors">→</span>
            </a>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-12 lg:py-20">
      <div class="max-w-5xl mx-auto px-6 lg:px-20">
        <div class="rounded-2xl p-8 md:p-12 text-center border" style="background:#0D1020;border-color:#4ADE8033">
          <p class="font-mono text-xs tracking-[0.2em] mb-4" style="color:#4ADE80">// 部署你的 Agent</p>
          <h2 class="text-white text-2xl md:text-3xl font-bold mb-4">专业音频，零手动编辑。</h2>
          <p class="text-[#6B7280] text-sm mb-8 max-w-md mx-auto">上传原始录音，获得广播级音频。无需 DAW、无需插件、无需音频工程师。</p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a href="https://app.agentputer.com/sign-up" class="btn-primary text-sm py-3 px-8 font-mono">[立即开始]</a>
            <a href="/zh/features" class="btn-secondary text-sm py-3 px-8 font-mono">[全部场景]</a>
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>
