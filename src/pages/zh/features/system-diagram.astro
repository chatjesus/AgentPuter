---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/zh/Header.astro';
import Footer from '../../../components/zh/Footer.astro';
---

<Layout
  title="系统架构图自动绘制 — AgentPuter"
  description="Describe your microservices, get production-ready SVG diagrams via Draw.io CLI."
>
  <Header activePage="features" />
  <main class="relative z-10">

    <!-- Hero -->
    <section class="relative pt-32 pb-16 lg:pt-40 lg:pb-20 overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-[#0A0A0A] to-[#0D0D14]"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_left,rgba(FBBF244D,transparent_60%)]" style="background: radial-gradient(ellipse at top left, #FBBF240D, transparent 60%)"></div>
      <div class="relative max-w-5xl mx-auto px-6 lg:px-20">
        <a href="/zh/features" class="inline-flex items-center gap-2 text-xs font-mono text-[#4B5563] hover:text-[#FBBF24] transition-colors mb-8">
          ← 返回功能页
        </a>
        <div class="flex flex-wrap gap-3 mb-5">
          <span class="text-xs font-bold font-mono px-2.5 py-1 rounded text-[#FBBF24] bg-[#FBBF24]/10">ENGINEERING</span>
          <span class="text-xs font-mono text-[#4A4A6A] px-2.5 py-1 rounded border border-[#1E1E2E]">ap-diagrams</span>
          <span class="text-xs font-mono text-[#4A4A6A] px-2.5 py-1 rounded border border-[#1E1E2E]">Draw.io CLI</span>
        </div>
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-5 leading-tight">
          系统架构图<br/>自动绘制
        </h1>
        <p class="text-[#9CA3AF] text-lg mb-10 max-w-2xl">描述架构 → AI 布局 → 导出 SVG/PNG</p>
        <div class="flex flex-wrap gap-3">
              <span class="inline-flex items-center gap-2 px-4 py-2 bg-[#111111] border border-[#FBBF24]/20 rounded-full text-xs text-[#94A3B8] font-mono">① 用自然语言描述</span>
              <span class="inline-flex items-center gap-2 px-4 py-2 bg-[#111111] border border-[#FBBF24]/20 rounded-full text-xs text-[#94A3B8] font-mono">② Agent 构建 draw.io 图形</span>
              <span class="inline-flex items-center gap-2 px-4 py-2 bg-[#111111] border border-[#FBBF24]/20 rounded-full text-xs text-[#94A3B8] font-mono">③ 导出 SVG/PNG/PDF</span>
        </div>
      </div>
    </section>

    <!-- Session Log -->
    <section class="py-12 lg:py-20">
      <div class="max-w-5xl mx-auto px-6 lg:px-20">
        <p class="font-mono text-xs font-semibold tracking-[0.2em] mb-8" style="color:#FBBF24">// Agent 会话日志</p>
        <div class="flex flex-col gap-4">

          <div class="flex items-start gap-4">
            <div class="shrink-0 w-8 h-8 rounded-full bg-[#1E293B] flex items-center justify-center text-xs font-mono text-[#94A3B8]">U</div>
            <div class="bg-[#111827] border border-[#1E293B] rounded-2xl rounded-tl-sm px-5 py-4 max-w-xl">
              <p class="text-[#E2E8F0] text-sm">"绘制微服务架构：API 网关 → 认证、用户、订单服务。订单服务连接支付和通知服务。所有服务共享 Redis 缓存。"</p>
            </div>
          </div>

          <div class="flex items-start gap-4 flex-row-reverse">
            <div class="shrink-0 w-8 h-8 rounded-full border flex items-center justify-center text-xs font-mono" style="background:#0C1020;border-color:#FBBF244D;color:#FBBF24">AP</div>
            <div class="rounded-2xl rounded-tr-sm px-5 py-4 max-w-xl border" style="background:#0D1020;border-color:#FBBF2426">
              <p class="text-[#94A3B8] text-xs font-mono mb-3">// 规划执行顺序</p>
              <ul class="text-[#CBD5E1] text-sm space-y-1.5">
                <li class="flex gap-2"><span class="text-[#FBBF24]">→</span> 创建微服务图模板</li>
                <li class="flex gap-2"><span class="text-[#FBBF24]">→</span> 添加 6 个带图标的服务节点</li>
                <li class="flex gap-2"><span class="text-[#FBBF24]">→</span> 用方向箭头连接各节点</li>
                <li class="flex gap-2"><span class="text-[#FBBF24]">→</span> 添加 Redis 缓存作为共享基础设施层</li>
                <li class="flex gap-2"><span class="text-[#FBBF24]">→</span> 应用暗色主题，导出 SVG + PNG</li>
              </ul>
            </div>
          </div>

          
          <div class="bg-[#080810] border border-[#1E1E2E] rounded-2xl p-6 font-mono text-xs">
            <div class="flex items-center gap-2 mb-5">
              <span class="w-3 h-3 rounded-full bg-[#FF5F57]"></span><span class="w-3 h-3 rounded-full bg-[#FEBC2E]"></span><span class="w-3 h-3 rounded-full bg-[#28C840]"></span>
              <span class="text-[#4B5563] ml-2">agentputer — ap-diagrams executor</span>
            </div>
            <div class="space-y-1.5">
              <p><span class="text-[#2A2A3A]">$ </span><span class="text-[#94A3B8]">ap-diagrams new --type microservice --theme dark</span></p>
              <p class="text-[#4ADE80] pl-4">✓ Diagram initialized with microservice template</p>
              <p class="mt-3"><span class="text-[#2A2A3A]">$ </span><span class="text-[#94A3B8]">ap-diagrams add node --labels "Auth,User,Order" --row 2 --spacing 200</span></p>
              <p class="text-[#4ADE80] pl-4">✓ 3 service nodes auto-positioned in row 2</p>
              <p class="mt-3"><span class="text-[#2A2A3A]">$ </span><span class="text-[#94A3B8]">ap-diagrams connect "API Gateway" --to "Auth,User,Order" --style arrow</span></p>
              <p class="text-[#4ADE80] pl-4">✓ 3 connections wired with directional arrows</p>
              <p class="mt-3"><span class="text-[#2A2A3A]">$ </span><span class="text-[#94A3B8]">ap-diagrams export --svg --png --fit-page</span></p>
              <p class="text-[#4ADE80] pl-4">✓ Exported: microservice-arch.svg + microservice-arch.png</p>
            </div>
            <div class="mt-5 pt-4 border-t border-[#1E1E2E] flex items-center justify-between">
              <span class="text-[#4B5563]">elapsed: 31s</span>
              <div class="flex items-center gap-2 rounded-lg px-3 py-1.5 border" style="background:#120F05;border-color:#FBBF2433">
                <span style="color:#FBBF24">📐</span><span style="color:#FBBF24">microservice-arch.svg</span><span class="text-[#4B5563] ml-2">Vector editable</span>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Capabilities -->
    <section class="py-12 lg:py-16 bg-[#080810]">
      <div class="max-w-5xl mx-auto px-6 lg:px-20">
        <p class="font-mono text-xs font-semibold tracking-[0.2em] mb-8" style="color:#FBBF24">// 此场景支持的能力</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="flex gap-4 bg-[#0D0D1A] border border-[#1E1E2E] rounded-xl p-5">
              <span class="text-2xl shrink-0 mt-0.5">☁️</span>
              <div>
                <h3 class="text-white text-sm font-semibold mb-1">云图标库</h3>
                <p class="text-[#6B7280] text-xs leading-relaxed">内置 AWS、GCP、Azure 和 Kubernetes 图标集，无需手动导入。</p>
              </div>
            </div>
            <div class="flex gap-4 bg-[#0D0D1A] border border-[#1E1E2E] rounded-xl p-5">
              <span class="text-2xl shrink-0 mt-0.5">🔗</span>
              <div>
                <h3 class="text-white text-sm font-semibold mb-1">智能自动路由</h3>
                <p class="text-[#6B7280] text-xs leading-relaxed">连接线自动绕过节点，无需手动拖拽连接。</p>
              </div>
            </div>
            <div class="flex gap-4 bg-[#0D0D1A] border border-[#1E1E2E] rounded-xl p-5">
              <span class="text-2xl shrink-0 mt-0.5">📊</span>
              <div>
                <h3 class="text-white text-sm font-semibold mb-1">多种图表类型</h3>
                <p class="text-[#6B7280] text-xs leading-relaxed">微服务、ER、网络拓扑、时序、UML、C4 模型全支持。</p>
              </div>
            </div>
            <div class="flex gap-4 bg-[#0D0D1A] border border-[#1E1E2E] rounded-xl p-5">
              <span class="text-2xl shrink-0 mt-0.5">🎨</span>
              <div>
                <h3 class="text-white text-sm font-semibold mb-1">深色 & 浅色主题</h3>
                <p class="text-[#6B7280] text-xs leading-relaxed">专业图表主题，视觉风格统一。</p>
              </div>
            </div>
            <div class="flex gap-4 bg-[#0D0D1A] border border-[#1E1E2E] rounded-xl p-5">
              <span class="text-2xl shrink-0 mt-0.5">📄</span>
              <div>
                <h3 class="text-white text-sm font-semibold mb-1">从代码/Schema 生成</h3>
                <p class="text-[#6B7280] text-xs leading-relaxed">直接从 SQL Schema 文件自动生成 ER 图。</p>
              </div>
            </div>
            <div class="flex gap-4 bg-[#0D0D1A] border border-[#1E1E2E] rounded-xl p-5">
              <span class="text-2xl shrink-0 mt-0.5">✏️</span>
              <div>
                <h3 class="text-white text-sm font-semibold mb-1">可编辑的 SVG 输出</h3>
                <p class="text-[#6B7280] text-xs leading-relaxed">标准 SVG 文件，可在任何矢量工具中打开编辑。</p>
              </div>
            </div>
        </div>
      </div>
    </section>

    <!-- Other Scenarios -->
    <section class="py-12 lg:py-16">
      <div class="max-w-5xl mx-auto px-6 lg:px-20">
        <p class="font-mono text-xs text-[#4B5563] font-semibold tracking-[0.2em] mb-6">// 其他场景</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <a href="/zh/features/financial-report" class="group flex items-center gap-4 bg-[#111111] hover:bg-[#161622] border border-[#1E1E2E] hover:border-[#FBBF24]/20 rounded-xl px-5 py-4 transition-all">
              <span class="text-2xl">📊</span>
              <div class="flex-1 min-w-0">
                <span class="text-xs font-mono text-[#4A4A6A] block mb-0.5">FINANCE</span>
                <span class="text-sm text-[#94A3B8] group-hover:text-white transition-colors truncate block">季度财务报告 自动化</span>
              </div>
              <span class="text-[#2A2A3A] group-hover:text-[#FBBF24] transition-colors">→</span>
            </a>
            <a href="/zh/features/design-poster" class="group flex items-center gap-4 bg-[#111111] hover:bg-[#161622] border border-[#1E1E2E] hover:border-[#FBBF24]/20 rounded-xl px-5 py-4 transition-all">
              <span class="text-2xl">🎨</span>
              <div class="flex-1 min-w-0">
                <span class="text-xs font-mono text-[#4A4A6A] block mb-0.5">DESIGN</span>
                <span class="text-sm text-[#94A3B8] group-hover:text-white transition-colors truncate block">营销海报 批量生成</span>
              </div>
              <span class="text-[#2A2A3A] group-hover:text-[#FBBF24] transition-colors">→</span>
            </a>
            <a href="/zh/features/audio-production" class="group flex items-center gap-4 bg-[#111111] hover:bg-[#161622] border border-[#1E1E2E] hover:border-[#FBBF24]/20 rounded-xl px-5 py-4 transition-all">
              <span class="text-2xl">🎵</span>
              <div class="flex-1 min-w-0">
                <span class="text-xs font-mono text-[#4A4A6A] block mb-0.5">AUDIO</span>
                <span class="text-sm text-[#94A3B8] group-hover:text-white transition-colors truncate block">播客与音频 后期处理</span>
              </div>
              <span class="text-[#2A2A3A] group-hover:text-[#FBBF24] transition-colors">→</span>
            </a>
            <a href="/zh/features/tech-docs" class="group flex items-center gap-4 bg-[#111111] hover:bg-[#161622] border border-[#1E1E2E] hover:border-[#FBBF24]/20 rounded-xl px-5 py-4 transition-all">
              <span class="text-2xl">📝</span>
              <div class="flex-1 min-w-0">
                <span class="text-xs font-mono text-[#4A4A6A] block mb-0.5">DOCS</span>
                <span class="text-sm text-[#94A3B8] group-hover:text-white transition-colors truncate block">技术文档 一键生成</span>
              </div>
              <span class="text-[#2A2A3A] group-hover:text-[#FBBF24] transition-colors">→</span>
            </a>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-12 lg:py-20">
      <div class="max-w-5xl mx-auto px-6 lg:px-20">
        <div class="rounded-2xl p-8 md:p-12 text-center border" style="background:#0D1020;border-color:#FBBF2433">
          <p class="font-mono text-xs tracking-[0.2em] mb-4" style="color:#FBBF24">// 部署你的 Agent</p>
          <h2 class="text-white text-2xl md:text-3xl font-bold mb-4">停止手动画架构图。</h2>
          <p class="text-[#6B7280] text-sm mb-8 max-w-md mx-auto">描述你的系统，AgentPuter 生成精准、专业、可导出的架构图。</p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a href="https://app.agentputer.com/sign-up" class="btn-primary text-sm py-3 px-8 font-mono">[立即开始]</a>
            <a href="/zh/features" class="btn-secondary text-sm py-3 px-8 font-mono">[全部场景]</a>
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>
