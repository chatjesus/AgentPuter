---
// Plantilla de página de detalle de artículo de blog en español
import Layout from './Layout.astro';
import Header from '../components/es/Header.astro';
import Footer from '../components/es/Footer.astro';

interface Props {
  title: string;
  description: string;
  date: string;
  author: string;
  readingTime?: string;
  tags?: string[];
}

const { title, description, date, author, readingTime, tags = [] } = Astro.props;

// Formatear la fecha para su visualización (formato español)
const formattedDate = new Date(date).toLocaleDateString('es', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Datos estructurados del artículo (JSON-LD BlogPosting)
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://www.agentputer.com');
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description,
  datePublished: date,
  dateModified: date,
  inLanguage: 'es',
  author: {
    '@type': 'Organization',
    name: author,
    url: 'https://www.agentputer.com',
  },
  publisher: {
    '@type': 'Organization',
    name: 'AgentPuter',
    url: 'https://www.agentputer.com',
    logo: {
      '@type': 'ImageObject',
      url: 'https://www.agentputer.com/favicon.svg',
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalURL.href,
  },
  keywords: tags.join(', '),
};

// Datos estructurados de migas de pan (Breadcrumb)
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://www.agentputer.com/es/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://www.agentputer.com/es/blog/' },
    { '@type': 'ListItem', position: 3, name: title },
  ],
};
---

<Layout
  title={`${title} | Blog de AgentPuter`}
  description={description}
  type="article"
  publishedDate={date}
  author={author}
  tags={tags}
>
  <!-- Datos estructurados del artículo -->
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <Header />
  <main class="relative z-10 pt-28 pb-20">
    <article class="max-w-4xl mx-auto px-6 lg:px-8">
      <!-- Navegación de migas de pan -->
      <nav class="mb-8 font-mono text-sm">
        <a href="/es/" class="text-text-muted hover:text-accent transition-colors">~</a>
        <span class="text-text-dark mx-2">/</span>
        <a href="/es/blog/" class="text-text-muted hover:text-accent transition-colors">Blog</a>
        <span class="text-text-dark mx-2">/</span>
        <span class="text-accent">Artículo</span>
      </nav>

      <!-- Cabecera de metadatos del artículo -->
      <header class="mb-12">
        <!-- Etiquetas -->
        {tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mb-6">
            {tags.map((tag) => (
              <span class="px-3 py-1 text-xs font-mono bg-accent/10 text-accent border border-accent/20 rounded-full">
                #{tag}
              </span>
            ))}
          </div>
        )}

        <!-- Título -->
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white leading-tight mb-6">
          {title}
        </h1>

        <!-- Descripción -->
        <p class="text-lg text-text-secondary leading-relaxed mb-8">
          {description}
        </p>

        <!-- Fila de metadatos -->
        <div class="flex flex-wrap items-center gap-6 text-sm font-mono text-text-muted border-t border-b border-accent/20 py-4">
          <div class="flex items-center gap-2">
            <span class="text-terminal-cyan">@</span>
            <span class="text-text-secondary">{author}</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-terminal-orange">$</span>
            <time datetime={date} class="text-text-secondary">{formattedDate}</time>
          </div>
          {readingTime && (
            <div class="flex items-center gap-2">
              <span class="text-terminal-blue">~</span>
              <span class="text-text-secondary">Lectura de {readingTime}</span>
            </div>
          )}
        </div>
      </header>

      <!-- Cuerpo del artículo -->
      <div class="prose prose-invert prose-terminal max-w-none">
        <slot />
      </div>

      <!-- Volver a la lista del blog -->
      <footer class="mt-16 pt-8 border-t border-accent/20">
        <a 
          href="/es/blog/" 
          class="inline-flex items-center gap-2 font-mono text-sm text-text-muted hover:text-accent transition-colors group"
        >
          <span class="group-hover:-translate-x-1 transition-transform">&lt;-</span>
          <span>Volver a todos los artículos</span>
        </a>
      </footer>
    </article>
  </main>
  <Footer />
</Layout>

<style is:global>
  /* Estilos de tipografía para el cuerpo del artículo del blog - Estilo terminal */
  .prose-terminal {
    color: #E0E0E0;
  }

  .prose-terminal h2 {
    @apply text-2xl md:text-3xl font-bold text-white mt-16 mb-6 pb-3 border-b border-accent/20;
    font-family: 'JetBrains Mono', monospace;
  }

  .prose-terminal h2::before {
    content: '## ';
    @apply text-accent;
  }

  .prose-terminal h3 {
    @apply text-xl md:text-2xl font-semibold text-white mt-10 mb-4;
    font-family: 'JetBrains Mono', monospace;
  }

  .prose-terminal h3::before {
    content: '### ';
    @apply text-terminal-orange;
  }

  .prose-terminal p {
    @apply text-text-primary leading-relaxed mb-6 text-base md:text-lg;
  }

  .prose-terminal strong {
    @apply text-white font-semibold;
  }

  .prose-terminal a {
    @apply text-accent underline underline-offset-4 decoration-accent/50 hover:decoration-accent transition-colors;
  }

  .prose-terminal ul {
    @apply space-y-3 mb-6 pl-0;
    list-style: none;
  }

  .prose-terminal ul li {
    @apply text-text-primary pl-6 relative text-base md:text-lg;
  }

  .prose-terminal ul li::before {
    content: '>';
    @apply absolute left-0 text-accent font-mono font-bold;
  }

  .prose-terminal ol {
    @apply space-y-3 mb-6;
    counter-reset: item;
    list-style: none;
    padding-left: 0;
  }

  .prose-terminal ol li {
    @apply text-text-primary pl-8 relative text-base md:text-lg;
    counter-increment: item;
  }

  .prose-terminal ol li::before {
    content: counter(item) '.';
    @apply absolute left-0 text-terminal-orange font-mono font-bold;
  }

  .prose-terminal blockquote {
    @apply border-l-4 border-accent/50 pl-6 py-2 my-8 bg-accent/5 rounded-r-lg;
  }

  .prose-terminal blockquote p {
    @apply text-text-secondary italic;
  }

  .prose-terminal code:not(pre code) {
    @apply px-2 py-0.5 bg-dark-tertiary text-terminal-orange rounded text-sm font-mono;
  }

  .prose-terminal pre {
    @apply bg-dark-secondary border border-dark-tertiary rounded-xl p-6 overflow-x-auto mb-6 text-sm;
  }

  .prose-terminal pre code {
    @apply text-text-primary font-mono;
  }

  .prose-terminal hr {
    @apply border-accent/20 my-12;
  }

  .prose-terminal table {
    @apply w-full border-collapse mb-8 text-sm;
  }

  .prose-terminal thead {
    @apply border-b-2 border-accent/30;
  }

  .prose-terminal th {
    @apply text-left py-3 px-4 text-accent font-mono font-semibold bg-dark-secondary;
  }

  .prose-terminal td {
    @apply py-3 px-4 border-b border-dark-tertiary text-text-secondary;
  }

  .prose-terminal tr:hover td {
    @apply bg-dark-tertiary/50;
  }

  .prose-terminal img {
    @apply rounded-xl border border-dark-tertiary;
    max-width: 100%;
    height: auto;
  }

  /* Optimización de renderizado diferido para contenido plegado */
  .prose-terminal h2 ~ *,
  .prose-terminal h3 ~ * {
    content-visibility: auto;
    contain-intrinsic-size: auto 200px;
  }
</style>