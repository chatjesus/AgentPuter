            <p class="text-xs"><span class="text-[#2A2A3A]">$ </span><span class="text-[#94A3B8]">ap-diagrams export --svg --theme dark</span></p>
            <p class="text-xs"><span class="text-[#2A2A3A]">$ </span><span class="text-[#94A3B8]">ap-diagrams from-schema --input db.sql</span></p>
          </div>
