---
// Section des points de friction - Mise en évidence des problèmes avec les agents IA locaux

const painPoints = [
  {
    icon: '[!]',
    title: 'Ordinateur Éteint = Agent Inactif',
    description: 'Fermez le capot de votre MacBook et votre IA se déconnecte. Aucune véritable automatisation 24/7 possible.',
  },
  {
    icon: '[x]',
    title: 'Auth Perdue = Tout Recommencer',
    description: 'Les tokens OAuth expirent, les sessions meurent. Chaque redémarrage implique de se reconnecter et de ré-autoriser.',
  },
  {
    icon: '[~]',
    title: 'Ressources Locales = PC Surchargé',
    description: 'Les agents monopolisent le CPU/la mémoire, ralentissant votre travail. Vous voulez plusieurs agents ? Oubliez.',
  },
  {
    icon: '[@]',
    title: 'Pas d\'Accès Distant = Verrouillé Localement',
    description: "Impossible d'accéder à votre Agent en déplacement. Vous manquez des infos critiques, impossible de répondre à temps.",
  },
];
---

<section id="problems" class="py-20 lg:py-32 bg-dark-secondary matrix-grid relative">
  <div class="max-w-7xl mx-auto px-6 lg:px-20">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <span class="inline-block px-4 py-2 text-xs font-mono font-bold tracking-widest text-terminal-orange border border-terminal-orange/30 bg-terminal-orange/10 rounded mb-6">
        AVERTISSEMENT : LIMITATION_SYSTÈME
      </span>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold font-mono text-text-primary leading-tight">
        Les Agents IA Aujourd'hui Sont Piégés<br />
        <span class="text-terminal-orange text-glow-orange">Sur Votre Machine Locale</span>
      </h2>
    </div>
    
    <!-- Pain Point Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {painPoints.map((point, index) => (
        <div 
          class="bg-dark-tertiary rounded-lg p-6 border border-terminal-orange/30 group hover:border-terminal-orange transition-colors hover-lift"
          style={`animation-delay: ${index * 100}ms`}
        >
          <div class="mb-4">
            <span class="text-terminal-orange font-mono text-2xl font-bold">{point.icon}</span>
          </div>
          <h3 class="text-lg font-mono font-semibold text-text-primary mb-3 group-hover:text-terminal-orange transition-colors">
            {point.title}
          </h3>
          <p class="text-text-secondary text-sm leading-relaxed font-mono">
            {point.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>