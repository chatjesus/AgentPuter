---
// 5가지 핵심 역할 - 각 역할은 터미널 시뮬레이션을 포함합니다
const roles = [
  {
    icon: '🔒', name: '프라이버시 프록시', color: '#00FF41', colorClass: 'text-accent',
    slogan: '// 당신의 데이터는 당신의 통제하에 있습니다',
    desc: "ChatGPT에 은행 계좌 정보를 붙여넣지는 않을 겁니다. AgentPuter는 당신과 LLM 사이의 방화벽 역할을 합니다. 데이터를 정화하고, 권한을 관리하며, 데이터 소유권이 당신에게 있도록 보장합니다.",
    terminal: {
      title: 'agentputer — 프라이버시 프록시',
      borderColor: '#00FF4130',
      lines: [
        { text: '$ agentputer privacy status', color: '#00FF41' },
        { text: '' },
        { text: '  데이터 흐름: 사용자 → AgentPuter → [정화됨] → LLM', color: '#94A3B8' },
        { text: '  자격 증명: 저장 시 암호화 (AES-256)', color: '#94A3B8' },
        { text: '  API 키: 관리되며, 모델에 노출되지 않음', color: '#94A3B8' },
        { text: '  PII 탐지: 활성, 자동 수정 활성화', color: '#94A3B8' },
        { text: '✓ 당신의 데이터는 당신의 것입니다', color: '#00FF41' },
      ],
    },
  },
  {
    icon: '🧠', name: '컨텍스트 매니저', color: '#00BFFF', colorClass: 'text-[#00BFFF]',
    slogan: '// 절대 잊지 않는 메모리',
    desc: "LLM은 기억 상실증에 걸리기 쉽습니다. AgentPuter는 에이전트에게 장기 기억을 제공합니다. 워크플로우, 환경설정, 파일 히스토리를 구조화된 컨텍스트로 변환하여 정확도를 높이면서 토큰을 절약합니다.",
    reverse: true,
    terminal: {
      title: 'agentputer — 컨텍스트 매니저',
      borderColor: '#00BFFF30',
      lines: [
        { text: '$ agentputer context show', color: '#00FF41' },
        { text: '' },
        { text: '  장기 기억:       847개 항목', color: '#94A3B8' },
        { text: '  환경설정:         23개 규칙 로드됨', color: '#94A3B8' },
        { text: '  파일 히스토리:    156개 파일 추적 중', color: '#94A3B8' },
        { text: '  토큰 절약:        ~62% (스마트 컨텍스트)', color: '#94A3B8' },
        { text: '  마지막 동기화:    2분 전', color: '#94A3B8' },
        { text: '✓ 중단했던 부분부터 바로 시작', color: '#00FF41' },
      ],
    },
  },
  {
    icon: '🔌', name: '통합 인터페이스', color: '#A855F7', colorClass: 'text-[#A855F7]',
    slogan: '// 에이전트에게 필요한 모든 것을 위한 단 하나의 API',
    desc: "문서, 이메일, 웹, 코드 등 모든 기능이 표준화된 'Tool'로 래핑됩니다. 에이전트는 각 API를 배울 필요 없이, 마치 사람이 마우스를 사용하듯 자연스럽게 기능을 호출합니다.",
    terminal: {
      title: 'agentputer — 통합 인터페이스',
      borderColor: '#A855F730',
      lines: [
        { text: '$ agentputer tools list', color: '#00FF41' },
        { text: '' },
        { text: '  ├── 문서         (읽기, 쓰기, 변환)', color: '#94A3B8' },
        { text: '  ├── 이메일       (보내기, 읽기, 검색)', color: '#94A3B8' },
        { text: '  ├── 웹           (브라우징, 스크래핑, API)', color: '#94A3B8' },
        { text: '  ├── 캘린더       (이벤트, 리마인더)', color: '#94A3B8' },
        { text: '  ├── 코드         (실행, 테스트, deploy)', color: '#94A3B8' },
        { text: '  ├── 파일         (CRUD, 정리)', color: '#94A3B8' },
        { text: '  └── 사용자 정의  (Skills 마켓플레이스)', color: '#94A3B8' },
        { text: '✓ 7개 핵심 도구 + 무제한 Skills', color: '#00FF41' },
      ],
    },
  },
  {
    icon: '💾', name: '영구 워크스페이스', color: '#FFD700', colorClass: 'text-[#FFD700]',
    slogan: "// 당신의 에이전트 전용 데스크톱",
    desc: "에이전트는 자체 파일 시스템, 코드 저장소, 리서치 노트를 가집니다. 작업하던 내용은 저장되고, 다음 세션은 이전 세션이 끝난 지점에서 정확히 다시 시작됩니다.",
    reverse: true,
    terminal: {
      title: 'agentputer — 영구 워크스페이스',
      borderColor: '#FFD70030',
      lines: [
        { text: '$ agentputer workspace status', color: '#00FF41' },
        { text: '' },
        { text: '  ~/workspace/', color: '#94A3B8' },
        { text: '  ├── projects/     (3개 활성)', color: '#94A3B8' },
        { text: '  ├── research/     (12개 노트)', color: '#94A3B8' },
        { text: '  ├── drafts/       (5개 진행 중)', color: '#94A3B8' },
        { text: '  └── exports/      (8개 완료)', color: '#94A3B8' },
        { text: '' },
        { text: '  저장 공간: 2.1 GB / 40 GB', color: '#94A3B8' },
        { text: "✓ 당신의 에이전트를 위한 영구적인 공간", color: '#00FF41' },
      ],
    },
  },
  {
    icon: '📋', name: '책임 추적 로그', color: '#FF6B6B', colorClass: 'text-[#FF6B6B]',
    slogan: '// 모든 활동을 기록하고 검토 가능',
    desc: "에이전트가 무엇을, 언제, 왜 했는지 정확히 확인하세요. 전체 의사 결정 과정이 기록됩니다. 민감한 작업은 자동으로 일시 중지되어 사람의 확인을 기다립니다. 투명성을 통해 신뢰를 구축합니다.",
    terminal: {
      title: 'agentputer — 책임 추적 로그',
      borderColor: '#FF6B6B30',
      lines: [
        { text: '$ agentputer logs --last 5', color: '#00FF41' },
        { text: '' },
        { text: "[14:23:01] [agent] 수신: '영업 보고서 작성'", color: '#94A3B8' },
        { text: '[14:23:02] [agent] 계획: 데이터 가져오기 → 분석 → 서식 지정', color: '#94A3B8' },
        { text: '[14:23:05] [tool]  데이터베이스 쿼리: sales_q4_2025', color: '#94A3B8' },
        { text: '[14:23:08] [agent] 보고서 초안 생성', color: '#94A3B8' },
        { text: '[14:23:09] [⚠ 확인 필요] 관리자에게 이메일을 보낼까요?', color: '#94A3B8' },
        { text: '[14:23:15] [사람] 승인됨 ✓', color: '#94A3B8' },
        { text: '✓ 민감한 작업에는 사람의 개입', color: '#00FF41' },
      ],
    },
  },
];
---

<section class="relative py-20 bg-[#0A0A0A]">
  <div class="max-w-7xl mx-auto px-6 lg:px-20">
    <div class="mb-16">
      <span class="block text-xs font-mono font-semibold tracking-[2px] text-accent mb-6">하나의 플랫폼, 다섯 가지 역할</span>
      <p class="text-lg md:text-2xl font-semibold text-white leading-snug max-w-[800px]">
        AgentPuter는 단순한 기능 목록이 아닙니다.<br/>AI 워크플로우에서 다섯 가지 핵심적인 역할을 수행합니다.
      </p>
    </div>
    
    <div class="space-y-24">
      {roles.map((role) => (
        <div class={`flex flex-col ${role.reverse ? 'lg:flex-row-reverse' : 'lg:flex-row'} items-center gap-10 lg:gap-12`}>
          <!-- 텍스트 부분 -->
          <div class="w-full lg:w-5/12 space-y-3">
            <span class={`font-mono text-[28px] font-bold ${role.colorClass}`}>[{role.icon}]</span>
            <h3 class="text-2xl md:text-[28px] font-bold text-white">{role.name}</h3>
            <p class="font-mono text-[13px] font-semibold" style={`color: ${role.color}`}>{role.slogan}</p>
            <p class="text-[15px] text-[#999999] leading-relaxed pt-1">{role.desc}</p>
          </div>
          
          <!-- 터미널 부분 -->
          <div class="w-full lg:w-7/12">
            <div class="rounded-xl border overflow-hidden" style={`border-color: ${role.terminal.borderColor}; background: #0D1117;`}>
              <!-- 터미널 헤더 -->
              <div class="flex items-center gap-2 px-3 h-9 bg-[#252525]">
                <span class="w-2.5 h-2.5 rounded-full bg-[#EF4444]"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-[#F59E0B]"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-[#22C55E]"></span>
                <span class="ml-2 text-[#64748B] font-mono text-[11px]">{role.terminal.title}</span>
              </div>
              <!-- 터미널 콘텐츠 -->
              <div class="p-4 space-y-1">
                {role.terminal.lines.map((line) => (
                  <p class="font-mono text-xs leading-relaxed" style={`color: ${line.color || '#94A3B8'}`}>
                    {line.text || '\u00A0'}
                  </p>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>