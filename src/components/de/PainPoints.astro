---
// Abschnitt "Pain Points" - Probleme mit lokalen KI-Agenten werden hervorgehoben

const painPoints = [
  {
    icon: '[!]',
    title: 'Computer aus = Agent offline',
    description: 'Klappst du dein MacBook zu, verliert dein KI-Agent die Verbindung. Echte 24/7-Automatisierung ist unmöglich.',
  },
  {
    icon: '[x]',
    title: 'Auth verloren = Neustart',
    description: 'OAuth-Token laufen ab, Sitzungen enden. Jeder Neustart erfordert erneutes Anmelden und Autorisieren.',
  },
  {
    icon: '[~]',
    title: 'Lokale Ressourcen = PC blockiert',
    description: 'Agenten blockieren CPU/Speicher und verlangsamen deine Arbeit. Mehrere Agenten gleichzeitig? Vergiss es.',
  },
  {
    icon: '[@]',
    title: 'Kein Fernzugriff = Ortsgebunden',
    description: 'Unterwegs kein Zugriff auf deinen Agenten. Wichtige Infos gehen verloren, keine rechtzeitige Reaktion möglich.',
  },
];
---

<section id="problems" class="py-20 lg:py-32 bg-dark-secondary matrix-grid relative">
  <div class="max-w-7xl mx-auto px-6 lg:px-20">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <span class="inline-block px-4 py-2 text-xs font-mono font-bold tracking-widest text-terminal-orange border border-terminal-orange/30 bg-terminal-orange/10 rounded mb-6">
        WARNUNG: SYSTEM_LIMITATION
      </span>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold font-mono text-text-primary leading-tight">
        KI-Agenten sind heute gefangen<br />
        <span class="text-terminal-orange text-glow-orange">Auf deinem lokalen Rechner</span>
      </h2>
    </div>
    
    <!-- Pain Point Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {painPoints.map((point, index) => (
        <div 
          class="bg-dark-tertiary rounded-lg p-6 border border-terminal-orange/30 group hover:border-terminal-orange transition-colors hover-lift"
          style={`animation-delay: ${index * 100}ms`}
        >
          <div class="mb-4">
            <span class="text-terminal-orange font-mono text-2xl font-bold">{point.icon}</span>
          </div>
          <h3 class="text-lg font-mono font-semibold text-text-primary mb-3 group-hover:text-terminal-orange transition-colors">
            {point.title}
          </h3>
          <p class="text-text-secondary text-sm leading-relaxed font-mono">
            {point.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>