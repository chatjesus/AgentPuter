---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/pt-br/Header.astro';
import Footer from '../../../components/pt-br/Footer.astro';
import DocsSidebar from '../../../components/pt-br/docs/DocsSidebar.astro';
import DocsChannels from '../../../components/pt-br/docs/DocsChannels.astro';
import AddChannelDashboard from '../../../components/pt-br/docs/AddChannelDashboard.astro';
---

<Layout
  title="Adicionar Canais - Documentação do AgentPuter | Conecte Telegram, WhatsApp, Slack e mais"
  description="Guia passo a passo: conecte o OpenClaw a mais de 15 canais de chat, como Telegram, WhatsApp, Slack e Discord. Explicação detalhada do mecanismo de segurança DM Pairing."
  tags={['Canais do AgentPuter', 'Configuração de Bot do Telegram', 'Canais do OpenClaw', 'DM Pairing', 'IA para WhatsApp', 'Bot para Slack']}
>
  <Header />
  <main class="relative z-10 pt-20">
    <!-- Visualização da documentação -->
    <div class="flex flex-col lg:flex-row min-h-[calc(100vh-80px)]">
      <DocsSidebar activeItem="add-channels" />
      <DocsChannels />
    </div>

    <!-- Pré-visualização do Dashboard -->
    <section class="border-t border-[#222222]">
      <div class="max-w-7xl mx-auto px-6 py-10">
        <div class="inline-block bg-[#00BFFF]/10 border border-[#00BFFF]/30 rounded px-3 py-1 mb-6">
          <span class="text-[#00BFFF] font-mono text-[10px] font-semibold tracking-[2px]">
            PRÉ-VISUALIZAÇÃO DO DASHBOARD
          </span>
        </div>
        <p class="text-[#666] text-[14px] mb-6">
          A seguir, uma demonstração da interface real para adicionar canais no Dashboard do AgentPuter.
        </p>
      </div>
      <AddChannelDashboard />
    </section>
  </main>
  <Footer />
</Layout>