---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import PainPoints from '../components/PainPoints.astro';
import Solution from '../components/Solution.astro';
import HowItWorks from '../components/HowItWorks.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
import MatrixRain from '../components/MatrixRain.astro';
---

<Layout
  title="AgentPuter - Your AI Agent's 24/7 Cloud Runtime"
  description="AgentPuter gives your AI Agent a dedicated cloud computer that never shuts down. Run OpenClaw, ClawBot, MoltBot 24/7 with persistent auth, multi-agent support, and remote access."
  tags={['AgentPuter', 'AI Agent', 'Cloud Runtime', 'OpenClaw', 'ClawBot', '24/7 AI', 'AI Automation', 'Agent Computer']}
>
  <MatrixRain />
  <Header />
  <main class="relative z-10">
    <Hero />
    <PainPoints />
    <Solution />
    <HowItWorks />
    <CTA />
  </main>
  <Footer />
</Layout>
