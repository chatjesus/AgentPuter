---
// Pain Points section - Highlighting problems with local AI agents

const painPoints = [
  {
    icon: '[!]',
    title: 'Computer Off = Agent Down',
    description: 'Close your MacBook lid and your AI disconnects. No true 24/7 automation possible.',
  },
  {
    icon: '[x]',
    title: 'Auth Lost = Start Over',
    description: 'OAuth tokens expire, sessions die. Every restart means re-login and re-authorize.',
  },
  {
    icon: '[~]',
    title: 'Local Resources = Hogged PC',
    description: 'Agents hog CPU/memory, slowing your work. Want multiple agents? Forget it.',
  },
  {
    icon: '[@]',
    title: 'No Remote = Location Locked',
    description: "Can't access your Agent on the go. Miss critical info, can't respond in time.",
  },
];
---

<section id="problems" class="py-20 lg:py-32 bg-dark-secondary matrix-grid relative">
  <div class="max-w-7xl mx-auto px-6 lg:px-20">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <span class="inline-block px-4 py-2 text-xs font-mono font-bold tracking-widest text-terminal-orange border border-terminal-orange/30 bg-terminal-orange/10 rounded mb-6">
        WARNING: SYSTEM_LIMITATION
      </span>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold font-mono text-text-primary leading-tight">
        AI Agents Today Are Trapped<br />
        <span class="text-terminal-orange text-glow-orange">On Your Local Machine</span>
      </h2>
    </div>
    
    <!-- Pain Point Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {painPoints.map((point, index) => (
        <div 
          class="bg-dark-tertiary rounded-lg p-6 border border-terminal-orange/30 group hover:border-terminal-orange transition-colors hover-lift"
          style={`animation-delay: ${index * 100}ms`}
        >
          <div class="mb-4">
            <span class="text-terminal-orange font-mono text-2xl font-bold">{point.icon}</span>
          </div>
          <h3 class="text-lg font-mono font-semibold text-text-primary mb-3 group-hover:text-terminal-orange transition-colors">
            {point.title}
          </h3>
          <p class="text-text-secondary text-sm leading-relaxed font-mono">
            {point.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
