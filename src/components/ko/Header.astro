---
// 헤더 컴포넌트 - 네비게이션 바
import LanguageSwitcher from '../LanguageSwitcher.astro';
interface Props {
  activePage?: string;
}
const { activePage = '' } = Astro.props;
---

<header class="fixed top-0 left-0 right-0 z-50 bg-dark-primary md:bg-dark-primary/95 md:backdrop-blur-lg border-b border-accent/20">
  <nav class="max-w-7xl mx-auto px-6 lg:px-20 h-20 flex items-center justify-between">
    <!-- Logo -->
    <a href="/ko/" class="flex items-center gap-2 group">
      <span class="font-mono text-xl font-bold">
        <span class="text-terminal-cyan">&gt;</span><span class="text-terminal-orange">_</span> <span class="text-accent">AgentPuter</span>
      </span>
    </a>
    
    <!-- Desktop Navigation -->
    <div class="hidden md:flex items-center gap-8 font-mono">
      <a href="/ko/features" class={`hover:text-accent transition-colors text-sm ${activePage === 'features' ? 'text-accent font-bold' : 'text-text-secondary'}`}>
        /기능
      </a>
      <a href="/tools" class={`hover:text-accent transition-colors text-sm ${activePage === 'tools' ? 'text-accent font-bold' : 'text-text-secondary'}`}>
        /도구
      </a>
      <a href="#pricing" class={`hover:text-accent transition-colors text-sm ${activePage === 'pricing' ? 'text-accent font-bold' : 'text-text-secondary'}`}>
        /가격
      </a>
      <a href="/ko/blog/" class={`hover:text-accent transition-colors text-sm ${activePage === 'blog' ? 'text-accent font-bold' : 'text-text-secondary'}`}>
        /블로그
      </a>
      <a href="/ko/docs" class={`hover:text-accent transition-colors text-sm ${activePage === 'docs' ? 'text-accent font-bold' : 'text-text-secondary'}`}>
        /문서
      </a>
      <LanguageSwitcher />
      <a href="https://app.agentputer.com/sign-up" class="text-sm py-2.5 px-6 bg-accent text-dark-primary font-bold rounded hover:bg-accent-dark transition-colors">
        [시작하기]
      </a>
    </div>
    
    <!-- Mobile Menu Button -->
    <button 
      id="mobile-menu-btn-ko"
      class="md:hidden p-2 text-text-secondary hover:text-white"
      aria-label="메뉴 열기"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>
  
  <!-- Mobile Menu -->
  <div id="mobile-menu-ko" class="hidden md:hidden bg-dark-secondary border-t border-dark-tertiary">
    <div class="px-6 py-4 space-y-4">
      <a href="/ko/features" class={`block hover:text-white transition-colors ${activePage === 'features' ? 'text-accent font-bold' : 'text-text-secondary'}`}>
        기능
      </a>
      <a href="/tools" class={`block hover:text-white transition-colors ${activePage === 'tools' ? 'text-accent font-bold' : 'text-text-secondary'}`}>
        도구
      </a>
      <a href="#pricing" class={`block hover:text-white transition-colors ${activePage === 'pricing' ? 'text-accent font-bold' : 'text-text-secondary'}`}>
        가격
      </a>
      <a href="/ko/blog/" class={`block hover:text-white transition-colors ${activePage === 'blog' ? 'text-accent font-bold' : 'text-text-secondary'}`}>
        블로그
      </a>
      <a href="/ko/docs" class={`block hover:text-white transition-colors ${activePage === 'docs' ? 'text-accent font-bold' : 'text-text-secondary'}`}>
        문서
      </a>
      <div class="lang-mobile-wrapper"></div>
      <a href="https://app.agentputer.com/sign-up" class="btn-primary w-full justify-center text-sm py-3">
        시작하기
      </a>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn-ko');
  const mobileMenu = document.getElementById('mobile-menu-ko');
  
  menuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
</script>