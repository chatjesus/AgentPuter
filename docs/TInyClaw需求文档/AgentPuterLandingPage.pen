            {
              "type": "frame",
              "id": "PrCgnat",
              "width": 780,
              "fill": "#EF444410",
              "cornerRadius": 10,
              "stroke": {
                "thickness": 2,
                "fill": "#EF444440"
              },
              "layout": "vertical",
