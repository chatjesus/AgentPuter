---
// Sección de Puntos Débiles - Resaltando los problemas con los agentes de IA locales

const painPoints = [
  {
    icon: '[!]',
    title: 'Ordenador Apagado = Agente Caído',
    description: 'Cierras la tapa de tu MacBook y tu IA se desconecta. Imposible una verdadera automatización 24/7.',
  },
  {
    icon: '[x]',
    title: 'Autenticación Perdida = Empezar de Nuevo',
    description: 'Los tokens OAuth expiran, las sesiones mueren. Cada reinicio significa volver a iniciar sesión y autorizar.',
  },
  {
    icon: '[~]',
    title: 'Recursos Locales = PC Acaparado',
    description: 'Los agentes acaparan CPU/memoria, ralentizando tu trabajo. ¿Quieres varios agentes? Olvídalo.',
  },
  {
    icon: '[@]',
    title: 'Sin Acceso Remoto = Atado a un Lugar',
    description: 'No puedes acceder a tu Agente sobre la marcha. Pierdes información crítica, no puedes responder a tiempo.',
  },
];
---

<section id="problems" class="py-20 lg:py-32 bg-dark-secondary matrix-grid relative">
  <div class="max-w-7xl mx-auto px-6 lg:px-20">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <span class="inline-block px-4 py-2 text-xs font-mono font-bold tracking-widest text-terminal-orange border border-terminal-orange/30 bg-terminal-orange/10 rounded mb-6">
        ADVERTENCIA: LIMITACIÓN_DEL_SISTEMA
      </span>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold font-mono text-text-primary leading-tight">
        Los Agentes de IA Hoy Están Atrapados<br />
        <span class="text-terminal-orange text-glow-orange">En Tu Máquina Local</span>
      </h2>
    </div>
    
    <!-- Pain Point Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {painPoints.map((point, index) => (
        <div 
          class="bg-dark-tertiary rounded-lg p-6 border border-terminal-orange/30 group hover:border-terminal-orange transition-colors hover-lift"
          style={`animation-delay: ${index * 100}ms`}
        >
          <div class="mb-4">
            <span class="text-terminal-orange font-mono text-2xl font-bold">{point.icon}</span>
          </div>
          <h3 class="text-lg font-mono font-semibold text-text-primary mb-3 group-hover:text-terminal-orange transition-colors">
            {point.title}
          </h3>
          <p class="text-text-secondary text-sm leading-relaxed font-mono">
            {point.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>