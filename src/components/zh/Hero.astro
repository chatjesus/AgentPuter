---
// Hero section - Chinese version
---

<section class="relative pt-32 pb-20 lg:pt-40 lg:pb-32 overflow-hidden scanlines crt-flicker">
  <!-- Background effects -->
  <div class="absolute inset-0 bg-gradient-to-b from-dark-primary via-dark-primary to-dark-secondary"></div>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(0,255,65,0.08),transparent_50%)]"></div>
  <div class="absolute inset-0 matrix-grid"></div>
  <div class="absolute inset-0 particles"></div>
  
  <div class="relative max-w-7xl mx-auto px-6 lg:px-20">
    <div class="flex flex-col items-center text-center">
      <!-- System status indicator -->
      <div class="flex items-center gap-4 mb-8 font-mono text-xs text-text-muted">
        <span class="flex items-center gap-2">
          <span class="w-2 h-2 bg-accent rounded-full animate-pulse"></span>
          <span class="text-terminal-orange">系统</span> 在线
        </span>
        <span class="text-terminal-blue">|</span>
        <span id="status-time-zh" class="text-terminal-cyan"></span>
        <span class="text-terminal-blue">|</span>
        <span>智能体: <span class="text-accent">就绪</span></span>
      </div>
      
      <!-- Headline - HTML 直出（LCP 关键元素） -->
      <h1 class="text-5xl md:text-7xl lg:text-8xl font-bold leading-tight mb-6 font-mono">
        <span class="block text-text-primary" id="title-line1-zh">你的 AI</span>
        <span class="block text-accent text-glow-strong glitch" data-text="永不休眠" id="title-line2-zh">永不休眠</span>
      </h1>
      
      <!-- Subline -->
      <div class="text-base md:text-lg lg:text-xl text-text-secondary leading-relaxed mb-10 font-mono text-center">
        <p class="mb-2">电脑关机、会话过期、Token 失效…</p>
        <p><span class="text-accent">AgentPuter</span> 让 <a href="https://openclaw.ai/" target="_blank" class="text-terminal-orange hover:underline">OpenClaw</a>、<a href="https://openclaw.ai/" target="_blank" class="text-terminal-cyan hover:underline">ClawBot</a>、<a href="https://openclaw.ai/" target="_blank" class="text-terminal-magenta hover:underline">MoltBot</a> 24/7 全天候运行</p>
      </div>
      
      <!-- CTA Buttons - Terminal style -->
      <div class="flex flex-col sm:flex-row items-center gap-4 mb-16">
        <a href="https://app.agentputer.com/sign-up" class="inline-flex items-center gap-2 px-8 py-4 bg-accent text-dark-primary font-mono font-bold rounded transition-all hover:bg-accent-dark hover:shadow-lg hover:shadow-accent/25">
          <span>./启动云舱</span>
          <span>_</span>
        </a>
      </div>
      
      <!-- Terminal Preview -->
      <div class="w-full max-w-2xl terminal glow-accent neon-box hover-lift">
        <div class="terminal-header">
          <span class="terminal-dot terminal-dot-red"></span>
          <span class="terminal-dot terminal-dot-yellow"></span>
          <span class="terminal-dot terminal-dot-green"></span>
          <span class="text-text-muted font-mono text-xs ml-2">终端</span>
        </div>
        <div class="terminal-body space-y-2">
          <div class="flex">
            <span class="terminal-prompt">$ </span>
            <span class="terminal-prompt" id="cmd1-zh"></span>
          </div>
          <div class="terminal-success hidden" id="output1-zh">✓ 云舱创建成功</div>
          <div class="h-2"></div>
          <div class="flex hidden" id="line2-zh">
            <span class="terminal-prompt">$ </span>
            <span class="terminal-prompt" id="cmd2-zh"></span>
          </div>
          <div class="terminal-success hidden" id="output2-zh">✓ OpenClaw 已部署并 24/7 运行</div>
          <div class="h-2 hidden" id="spacer-zh"></div>
          <div class="flex hidden" id="cursor-line-zh">
            <span class="terminal-prompt">$ </span>
            <span class="cursor-blink"></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    // Title typing animation - Chinese version
    const titleLine1 = document.getElementById('title-line1-zh');
    const titleLine2 = document.getElementById('title-line2-zh');
    const titleTexts = ['你的AI', '永不休眠'];
    
    async function typeTitle() {
      // FIX: 同时清空两行，避免 line2 闪现
      if (titleLine1) titleLine1.textContent = '';
      if (titleLine2) titleLine2.textContent = '';

      // 打 line1
      if (titleLine1) {
        for (let i = 0; i <= titleTexts[0].length; i++) {
          titleLine1.textContent = titleTexts[0].substring(0, i) + (i < titleTexts[0].length ? '█' : '');
          await new Promise(function(r) { setTimeout(r, 100); });
        }
        titleLine1.textContent = titleTexts[0];
      }
      
      await new Promise(function(r) { setTimeout(r, 200); });
      
      // 打 line2
      if (titleLine2) {
        for (let i = 0; i <= titleTexts[1].length; i++) {
          titleLine2.textContent = titleTexts[1].substring(0, i) + (i < titleTexts[1].length ? '█' : '');
          await new Promise(function(r) { setTimeout(r, 80); });
        }
        titleLine2.textContent = titleTexts[1];
      }
    }
    
    // Status time update
    var timeElement = document.getElementById('status-time-zh');
    function updateTime() {
      if (!timeElement) return;
      var now = new Date();
      timeElement.textContent = now.toLocaleTimeString('zh-CN', { hour12: false });
    }
    updateTime();
    setInterval(updateTime, 1000);
    
    // Terminal typing animation
    var commands = [
      { id: 'cmd1-zh', text: 'agentputer init openclaw-pod', output: 'output1-zh', next: 'line2-zh' },
      { id: 'cmd2-zh', text: 'agentputer deploy openclaw', output: 'output2-zh', next: 'spacer-zh' }
    ];
    
    async function typeText(elementId, text, speed) {
      speed = speed || 50;
      var element = document.getElementById(elementId);
      if (!element) return;
      
      for (var i = 0; i < text.length; i++) {
        element.textContent = text.substring(0, i + 1);
        await new Promise(function(r) { setTimeout(r, speed); });
      }
    }
    
    function showElement(id) {
      var el = document.getElementById(id);
      if (el) {
        el.classList.remove('hidden');
        el.classList.add('animate-fade-in');
      }
    }
    
    async function runTerminal() {
      // First type the title
      await typeTitle();
      await new Promise(function(r) { setTimeout(r, 800); });
      
      // Then run terminal commands
      for (var i = 0; i < commands.length; i++) {
        var cmd = commands[i];
        await typeText(cmd.id, cmd.text);
        await new Promise(function(r) { setTimeout(r, 300); });
        showElement(cmd.output);
        await new Promise(function(r) { setTimeout(r, 500); });
        showElement(cmd.next);
        await new Promise(function(r) { setTimeout(r, 200); });
      }
      
      showElement('cursor-line-zh');
    }
    
    runTerminal();
  });
</script>
