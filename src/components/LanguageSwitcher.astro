---
// 通用语言切换器组件 — 所有语言 Header 共用
// 自动检测当前页面语言，生成对应各语言的链接

const LANGUAGES = [
  { code: 'en',    prefix: '',        label: 'EN',  native: 'English' },
  { code: 'zh',    prefix: '/zh',     label: '中文', native: '中文' },
  { code: 'ja',    prefix: '/ja',     label: 'JA',  native: '日本語' },
  { code: 'ko',    prefix: '/ko',     label: 'KO',  native: '한국어' },
  { code: 'es',    prefix: '/es',     label: 'ES',  native: 'Español' },
  { code: 'pt-br', prefix: '/pt-br',  label: 'PT',  native: 'Português' },
  { code: 'de',    prefix: '/de',     label: 'DE',  native: 'Deutsch' },
  { code: 'fr',    prefix: '/fr',     label: 'FR',  native: 'Français' },
];

const currentPath = Astro.url.pathname;
const langMatch = currentPath.match(/^\/(zh|ja|ko|es|pt-br|de|fr)(\/|$)/);
const currentLangCode = langMatch ? langMatch[1] : 'en';
const currentLang = LANGUAGES.find(l => l.code === currentLangCode) || LANGUAGES[0];

// 去掉当前语言前缀得到纯路径
const basePath = currentLang.prefix
  ? (currentPath.replace(new RegExp(`^${currentLang.prefix.replace('-', '\\-')}`), '') || '/')
  : currentPath;

// 生成每种语言的链接
const langLinks = LANGUAGES.map(l => ({
  ...l,
  href: l.prefix ? `${l.prefix}${basePath === '/' ? '/' : basePath}` : basePath,
  active: l.code === currentLangCode,
}));
---

<!-- Desktop 语言切换器 -->
<div class="lang-switcher relative">
  <button
    class="lang-btn flex items-center gap-1.5 text-text-secondary hover:text-accent transition-colors text-sm font-mono cursor-pointer"
    aria-label="Switch language"
    aria-expanded="false"
  >
    <svg class="w-3.5 h-3.5 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <circle cx="12" cy="12" r="10" stroke-width="1.5"/>
      <path stroke-width="1.5" d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
    </svg>
    <span>{currentLang.label}</span>
    <svg class="w-3 h-3 opacity-40 transition-transform lang-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
    </svg>
  </button>

  <!-- 下拉菜单 -->
  <div class="lang-dropdown hidden absolute right-0 top-full mt-2 py-1 bg-[#1a1a1a] border border-[#333] rounded-lg shadow-xl min-w-[160px] z-[100]">
    {langLinks.map(l => (
      <a
        href={l.href}
        class={`flex items-center justify-between px-4 py-2 text-sm font-mono transition-colors ${
          l.active
            ? 'text-accent bg-accent/10'
            : 'text-text-secondary hover:text-white hover:bg-white/5'
        }`}
        data-lang={l.code}
      >
        <span>{l.native}</span>
        <span class={`text-xs ${l.active ? 'text-accent' : 'text-text-dark'}`}>{l.label}</span>
      </a>
    ))}
  </div>
</div>

<!-- Mobile 语言列表（平铺，不用下拉） -->
<div class="lang-mobile hidden">
  <div class="flex flex-wrap gap-2">
    {langLinks.map(l => (
      <a
        href={l.href}
        class={`px-3 py-1.5 text-xs font-mono rounded border transition-colors ${
          l.active
            ? 'text-accent border-accent/40 bg-accent/10'
            : 'text-text-muted border-[#333] hover:text-white hover:border-white/20'
        }`}
        data-lang={l.code}
      >
        {l.native}
      </a>
    ))}
  </div>
</div>

<script>
  // Desktop 下拉切换
  document.querySelectorAll('.lang-switcher').forEach(switcher => {
    const btn = switcher.querySelector('.lang-btn');
    const dropdown = switcher.querySelector('.lang-dropdown');
    const chevron = switcher.querySelector('.lang-chevron');
    if (!btn || !dropdown) return;

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = !dropdown.classList.contains('hidden');
      dropdown.classList.toggle('hidden');
      chevron?.classList.toggle('rotate-180');
      btn.setAttribute('aria-expanded', String(!isOpen));
    });

    // 点击外部关闭
    document.addEventListener('click', () => {
      dropdown.classList.add('hidden');
      chevron?.classList.remove('rotate-180');
      btn.setAttribute('aria-expanded', 'false');
    });

    dropdown.addEventListener('click', (e) => e.stopPropagation());
  });

  // 语言选择时记录偏好
  document.querySelectorAll('[data-lang]').forEach(link => {
    link.addEventListener('click', () => {
      const lang = link.getAttribute('data-lang');
      if (lang) localStorage.setItem('agentputer-lang', lang);
    });
  });

  // 把 mobile 语言列表移入 mobile menu wrapper
  document.querySelectorAll('.lang-mobile-wrapper').forEach(wrapper => {
    const mobileLang = document.querySelector('.lang-mobile');
    if (mobileLang) {
      const clone = mobileLang.cloneNode(true);
      clone.classList.remove('hidden');
      wrapper.appendChild(clone);
    }
  });
</script>
