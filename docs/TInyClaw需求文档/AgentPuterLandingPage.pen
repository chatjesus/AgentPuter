        {
          "type": "frame",
          "id": "FtVox",
          "name": "Community Voices",
          "width": "fill_container",
          "fill": "#0A0A0A",
          "layout": "vertical",
          "gap": 40,
          "padding": 80,
          "alignItems": "center",
          "children": [
            {
              "type": "text",
              "id": "FtVxL",
              "fill": "#00FF41",
              "content": "// REAL PAIN, REAL PEOPLE",
              "fontFamily": "JetBrains Mono",
              "fontSize": 12,
              "fontWeight": "600",
              "letterSpacing": 4
            },
            {
              "type": "text",
              "id": "FtVxT",
              "fill": "#999999",
              "content": "These aren't hypothetical problems.\nThey're from Hacker News threads in 2025-2026 —\ndevelopers actively asking how to solve this.",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 15,
              "fontWeight": "normal"
            },
            {
              "type": "frame",
              "id": "FtVxR1",
              "gap": 20,
              "children": [
                {
                  "type": "frame",
                  "id": "FtVx1",
                  "width": 350,
                  "fill": "#111111",
                  "cornerRadius": 12,
                  "stroke": {
                    "thickness": 1,
                    "fill": "#222222"
                  },
                  "layout": "vertical",
                  "gap": 12,
                  "padding": 20,
                  "children": [
                    {
                      "type": "text",
                      "id": "FtVxP1",
                      "fill": "#EF4444",
                      "content": "No standard",
                      "fontFamily": "JetBrains Mono",
                      "fontSize": 10,
                      "fontWeight": "600",
                      "letterSpacing": 2
                    },
                    {
                      "type": "text",
                      "id": "FtVxQ1",
                      "fill": "#E2E8F0",
                      "content": "\"Why are so many rolling out their own AI/LLM agent sandboxing solution?\" — There's no OAuth for syscalls yet.",
                      "lineHeight": 1.5,
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "normal",
                      "fontStyle": "italic"
                    },
                    {
                      "type": "text",
                      "id": "FtVxS1",
                      "fill": "#555555",
                      "content": "— ATechGuy, HN (Feb 2026)",
                      "fontFamily": "Inter",
                      "fontSize": 12,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "FtVx2",
                  "width": 350,
                  "fill": "#111111",
                  "cornerRadius": 12,
                  "stroke": {
                    "thickness": 1,
                    "fill": "#222222"
                  },
                  "layout": "vertical",
                  "gap": 12,
                  "padding": 20,
                  "children": [
                    {
                      "type": "text",
                      "id": "FtVxP2",
                      "fill": "#EF4444",
                      "content": "Environment hell",
                      "fontFamily": "JetBrains Mono",
                      "fontSize": 10,
                      "fontWeight": "600",
                      "letterSpacing": 2
                    },
                    {
                      "type": "text",
                      "id": "FtVxQ2",
                      "fill": "#E2E8F0",
                      "content": "\"Agents fail not from model limits but flaky environments — missing deps, slow setup, unclear feedback.\"",
                      "lineHeight": 1.5,
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "normal",
                      "fontStyle": "italic"
                    },
                    {
                      "type": "text",
                      "id": "FtVxS2",
                      "fill": "#555555",
                      "content": "— HN discussion on agent sandboxes",
                      "fontFamily": "Inter",
                      "fontSize": 12,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "FtVx3",
                  "width": 350,
                  "fill": "#111111",
                  "cornerRadius": 12,
                  "stroke": {
                    "thickness": 1,
                    "fill": "#222222"
                  },
                  "layout": "vertical",
                  "gap": 12,
                  "padding": 20,
                  "children": [
                    {
                      "type": "text",
                      "id": "FtVxP3",
                      "fill": "#EF4444",
                      "content": "Debugging blind",
                      "fontFamily": "JetBrains Mono",
                      "fontSize": 10,
                      "fontWeight": "600",
                      "letterSpacing": 2
                    },
                    {
                      "type": "text",
                      "id": "FtVxQ3",
                      "fill": "#E2E8F0",
                      "content": "\"Finally a good alternative to E2B. Minor nit — it would be good to also have a screenshot on how to debug if stuck.\"",
                      "lineHeight": 1.5,
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "normal",
                      "fontStyle": "italic"
                    },
                    {
                      "type": "text",
                      "id": "FtVxS3",
                      "fill": "#555555",
                      "content": "— deforciant, HN",
                      "fontFamily": "Inter",
                      "fontSize": 12,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            },
            {
              "type": "frame",
              "id": "FtVxR2",
              "gap": 20,
              "children": [
                {
                  "type": "frame",
                  "id": "FtVx4",
                  "width": 350,
                  "fill": "#111111",
                  "cornerRadius": 12,
                  "stroke": {
                    "thickness": 1,
                    "fill": "#222222"
                  },
                  "layout": "vertical",
                  "gap": 12,
                  "padding": 20,
                  "children": [
                    {
                      "type": "text",
                      "id": "FtVxP4",
                      "fill": "#EF4444",
                      "content": "Local chaos",
                      "fontFamily": "JetBrains Mono",
                      "fontSize": 10,
                      "fontWeight": "600",
                      "letterSpacing": 2
                    },
                    {
                      "type": "text",
                      "id": "FtVxQ4",
                      "fill": "#E2E8F0",
                      "content": "\"Running agents locally = git worktrees, multiple terminals, messy context switching that slows everything.\"",
                      "lineHeight": 1.5,
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "normal",
                      "fontStyle": "italic"
                    },
                    {
                      "type": "text",
                      "id": "FtVxS4",
                      "fill": "#555555",
                      "content": "— HN: Run AI Agents on your cloud",
                      "fontFamily": "Inter",
                      "fontSize": 12,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "FtVx5",
                  "width": 350,
                  "fill": "#111111",
                  "cornerRadius": 12,
                  "stroke": {
                    "thickness": 1,
                    "fill": "#222222"
                  },
                  "layout": "vertical",
                  "gap": 12,
                  "padding": 20,
                  "children": [
                    {
                      "type": "text",
                      "id": "FtVxP5",
                      "fill": "#EF4444",
                      "content": "Ephemeral trap",
                      "fontFamily": "JetBrains Mono",
                      "fontSize": 10,
                      "fontWeight": "600",
                      "letterSpacing": 2
                    },
                    {
                      "type": "text",
                      "id": "FtVxQ5",
                      "fill": "#E2E8F0",
                      "content": "\"E2B is $150/mo for Pro. Sandboxes auto-destroy. My agent loses everything every time.\"",
                      "lineHeight": 1.5,
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "normal",
                      "fontStyle": "italic"
                    },
                    {
                      "type": "text",
                      "id": "FtVxS5",
                      "fill": "#555555",
                      "content": "— Developer evaluating sandboxes",
                      "fontFamily": "Inter",
                      "fontSize": 12,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "FtVx6",
                  "width": 350,
                  "fill": "#111111",
                  "cornerRadius": 12,
                  "stroke": {
                    "thickness": 1,
                    "fill": "#222222"
                  },
                  "layout": "vertical",
                  "gap": 12,
                  "padding": 20,
                  "children": [
                    {
                      "type": "text",
                      "id": "FtVxP6",
                      "fill": "#EF4444",
                      "content": "Permission chaos",
                      "fontFamily": "JetBrains Mono",
                      "fontSize": 10,
                      "fontWeight": "600",
                      "letterSpacing": 2
                    },
                    {
                      "type": "text",
                      "id": "FtVxQ6",
                      "fill": "#E2E8F0",
                      "content": "\"I need SSH but not file deletion. Filesystem writes but not network. There's no easy granular permission system.\"",
                      "lineHeight": 1.5,
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "normal",
                      "fontStyle": "italic"
                    },
                    {
                      "type": "text",
                      "id": "FtVxS6",
                      "fill": "#555555",
                      "content": "— HN agent sandboxing thread",
                      "fontFamily": "Inter",
                      "fontSize": 12,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            }
          ]
