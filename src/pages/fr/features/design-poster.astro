---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/fr/Header.astro';
import Footer from '../../../components/fr/Footer.astro';
---

<Layout
  title="Génération de Posters Marketing en Lot — AgentPuter"
  description="Describe your campaign, get pixel-perfect SVG/PNG posters in seconds."
>
  <Header activePage="features" />
  <main class="relative z-10">

    <!-- Hero -->
    <section class="relative pt-32 pb-16 lg:pt-40 lg:pb-20 overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-[#0A0A0A] to-[#0D0D14]"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_left,rgba(A78BFA4D,transparent_60%)]" style="background: radial-gradient(ellipse at top left, #A78BFA0D, transparent 60%)"></div>
      <div class="relative max-w-5xl mx-auto px-6 lg:px-20">
        <a href="/fr/features" class="inline-flex items-center gap-2 text-xs font-mono text-[#4B5563] hover:text-[#A78BFA] transition-colors mb-8">
          ← retour aux fonctionnalités
        </a>
        <div class="flex flex-wrap gap-3 mb-5">
          <span class="text-xs font-bold font-mono px-2.5 py-1 rounded text-[#A78BFA] bg-[#A78BFA]/10">DESIGN</span>
          <span class="text-xs font-mono text-[#4A4A6A] px-2.5 py-1 rounded border border-[#1E1E2E]">ap-design</span>
          <span class="text-xs font-mono text-[#4A4A6A] px-2.5 py-1 rounded border border-[#1E1E2E]">Inkscape</span>
        </div>
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-5 leading-tight">
          Génération de Posters<br/>Marketing en Lot
        </h1>
        <p class="text-[#9CA3AF] text-lg mb-10 max-w-2xl">Une phrase → L'IA crée le design → Exporter PNG/SVG haute résolution</p>
        <div class="flex flex-wrap gap-3">
              <span class="inline-flex items-center gap-2 px-4 py-2 bg-[#111111] border border-[#A78BFA]/20 rounded-full text-xs text-[#94A3B8] font-mono">① Décrire le thème et le texte</span>
              <span class="inline-flex items-center gap-2 px-4 py-2 bg-[#111111] border border-[#A78BFA]/20 rounded-full text-xs text-[#94A3B8] font-mono">② L'agent crée le layout SVG</span>
              <span class="inline-flex items-center gap-2 px-4 py-2 bg-[#111111] border border-[#A78BFA]/20 rounded-full text-xs text-[#94A3B8] font-mono">③ Export en lot PNG/SVG</span>
        </div>
      </div>
    </section>

    <!-- Session Log -->
    <section class="py-12 lg:py-20">
      <div class="max-w-5xl mx-auto px-6 lg:px-20">
        <p class="font-mono text-xs font-semibold tracking-[0.2em] mb-8" style="color:#A78BFA">// JOURNAL DE SESSION DE L'AGENT</p>
        <div class="flex flex-col gap-4">

          <div class="flex items-start gap-4">
            <div class="shrink-0 w-8 h-8 rounded-full bg-[#1E293B] flex items-center justify-center text-xs font-mono text-[#94A3B8]">U</div>
            <div class="bg-[#111827] border border-[#1E293B] rounded-2xl rounded-tl-sm px-5 py-4 max-w-xl">
              <p class="text-[#E2E8F0] text-sm">"Crée des posters de soldes d'été en 3 tailles : 1080×1920, 1200×628, 1080×1080. Couleur de marque #FF6B35, titre en gras blanc, inclure SUMMER25."</p>
            </div>
          </div>

          <div class="flex items-start gap-4 flex-row-reverse">
            <div class="shrink-0 w-8 h-8 rounded-full border flex items-center justify-center text-xs font-mono" style="background:#0C1020;border-color:#A78BFA4D;color:#A78BFA">AP</div>
            <div class="rounded-2xl rounded-tr-sm px-5 py-4 max-w-xl border" style="background:#0D1020;border-color:#A78BFA26">
              <p class="text-[#94A3B8] text-xs font-mono mb-3">// Planification de la séquence d'exécution</p>
              <ul class="text-[#CBD5E1] text-sm space-y-1.5">
                <li class="flex gap-2"><span class="text-[#A78BFA]">→</span> Créer un canvas SVG de base avec la palette de marque</li>
                <li class="flex gap-2"><span class="text-[#A78BFA]">→</span> Composer les calques texte : titre, sous-titre, code promo</li>
                <li class="flex gap-2"><span class="text-[#A78BFA]">→</span> Appliquer l'arrière-plan dégradé + éléments décoratifs</li>
                <li class="flex gap-2"><span class="text-[#A78BFA]">→</span> Exporter 3 variantes de taille en résolution 2x</li>
              </ul>
            </div>
          </div>

          
          <div class="bg-[#080810] border border-[#1E1E2E] rounded-2xl p-6 font-mono text-xs">
            <div class="flex items-center gap-2 mb-5">
              <span class="w-3 h-3 rounded-full bg-[#FF5F57]"></span><span class="w-3 h-3 rounded-full bg-[#FEBC2E]"></span><span class="w-3 h-3 rounded-full bg-[#28C840]"></span>
              <span class="text-[#4B5563] ml-2">agentputer — ap-design executor</span>
            </div>
            <div class="space-y-1.5">
              <p><span class="text-[#2A2A3A]">$ </span><span class="text-[#94A3B8]">ap-design canvas --size 1080x1920 --bg "#FF6B35"</span></p>
              <p class="text-[#4ADE80] pl-4">✓ Canvas created: 1080×1920px, brand orange base</p>
              <p class="mt-3"><span class="text-[#2A2A3A]">$ </span><span class="text-[#94A3B8]">ap-design text --content "SUMMER SALE" --weight bold --color white --size 96</span></p>
              <p class="text-[#4ADE80] pl-4">✓ Text layer: headline positioned at y=340, centered</p>
              <p class="mt-3"><span class="text-[#2A2A3A]">$ </span><span class="text-[#94A3B8]">ap-design badge --text "SUMMER25" --style pill --color white --bg "#1A1A1A"</span></p>
              <p class="text-[#4ADE80] pl-4">✓ Promo badge element inserted</p>
              <p class="mt-3"><span class="text-[#2A2A3A]">$ </span><span class="text-[#94A3B8]">ap-design batch --variants 3 --sizes "1080x1920,1200x628,1080x1080" --export png 2x</span></p>
              <p class="text-[#4ADE80] pl-4">✓ Exported: 3 PNG files, 3 SVG masters</p>
            </div>
            <div class="mt-5 pt-4 border-t border-[#1E1E2E] flex items-center justify-between">
              <span class="text-[#4B5563]">elapsed: 23s · 6 files</span>
              <div class="flex items-center gap-2 rounded-lg px-3 py-1.5 border" style="background:#100D18;border-color:#A78BFA33">
                <span style="color:#A78BFA">🎨</span><span style="color:#A78BFA">summer-sale-poster × 3</span><span class="text-[#4B5563] ml-2">PNG + SVG</span>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Capabilities -->
    <section class="py-12 lg:py-16 bg-[#080810]">
      <div class="max-w-5xl mx-auto px-6 lg:px-20">
        <p class="font-mono text-xs font-semibold tracking-[0.2em] mb-8" style="color:#A78BFA">// CE QUE CE SCÉNARIO PREND EN CHARGE</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="flex gap-4 bg-[#0D0D1A] border border-[#1E1E2E] rounded-xl p-5">
              <span class="text-2xl shrink-0 mt-0.5">🖼️</span>
              <div>
                <h3 class="text-white text-sm font-semibold mb-1">Toute taille de canvas</h3>
                <p class="text-[#6B7280] text-xs leading-relaxed">Instagram, Facebook, Twitter/X, LinkedIn, impression — tout depuis un design de base.</p>
              </div>
            </div>
            <div class="flex gap-4 bg-[#0D0D1A] border border-[#1E1E2E] rounded-xl p-5">
              <span class="text-2xl shrink-0 mt-0.5">✏️</span>
              <div>
                <h3 class="text-white text-sm font-semibold mb-1">Contrôle total du texte</h3>
                <p class="text-[#6B7280] text-xs leading-relaxed">Famille, graisse, taille, couleur, interligne — tout scriptable.</p>
              </div>
            </div>
            <div class="flex gap-4 bg-[#0D0D1A] border border-[#1E1E2E] rounded-xl p-5">
              <span class="text-2xl shrink-0 mt-0.5">🎨</span>
              <div>
                <h3 class="text-white text-sm font-semibold mb-1">Opérations sur les chemins vectoriels</h3>
                <p class="text-[#6B7280] text-xs leading-relaxed">Dessiner des formes, dégradés, masques, filtres — manipulation complète des nœuds SVG.</p>
              </div>
            </div>
            <div class="flex gap-4 bg-[#0D0D1A] border border-[#1E1E2E] rounded-xl p-5">
              <span class="text-2xl shrink-0 mt-0.5">📦</span>
              <div>
                <h3 class="text-white text-sm font-semibold mb-1">Export de variantes en lot</h3>
                <p class="text-[#6B7280] text-xs leading-relaxed">50 variantes de langue, thèmes de couleur ou versions A/B en une commande.</p>
              </div>
            </div>
            <div class="flex gap-4 bg-[#0D0D1A] border border-[#1E1E2E] rounded-xl p-5">
              <span class="text-2xl shrink-0 mt-0.5">📐</span>
              <div>
                <h3 class="text-white text-sm font-semibold mb-1">Alignement au pixel près</h3>
                <p class="text-[#6B7280] text-xs leading-relaxed">Positionnement par coordonnées — pas de devinettes, pas de glisser-déposer.</p>
              </div>
            </div>
            <div class="flex gap-4 bg-[#0D0D1A] border border-[#1E1E2E] rounded-xl p-5">
              <span class="text-2xl shrink-0 mt-0.5">🔁</span>
              <div>
                <h3 class="text-white text-sm font-semibold mb-1">Réutilisation des modèles</h3>
                <p class="text-[#6B7280] text-xs leading-relaxed">Définir un modèle de marque une fois, changer les variables pour chaque campagne.</p>
              </div>
            </div>
        </div>
      </div>
    </section>

    <!-- Other Scenarios -->
    <section class="py-12 lg:py-16">
      <div class="max-w-5xl mx-auto px-6 lg:px-20">
        <p class="font-mono text-xs text-[#4B5563] font-semibold tracking-[0.2em] mb-6">// AUTRES SCÉNARIOS</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <a href="/fr/features/financial-report" class="group flex items-center gap-4 bg-[#111111] hover:bg-[#161622] border border-[#1E1E2E] hover:border-[#A78BFA]/20 rounded-xl px-5 py-4 transition-all">
              <span class="text-2xl">📊</span>
              <div class="flex-1 min-w-0">
                <span class="text-xs font-mono text-[#4A4A6A] block mb-0.5">FINANCE</span>
                <span class="text-sm text-[#94A3B8] group-hover:text-white transition-colors truncate block">Automatisation des Rapports Financiers Trimestriels</span>
              </div>
              <span class="text-[#2A2A3A] group-hover:text-[#A78BFA] transition-colors">→</span>
            </a>
            <a href="/fr/features/system-diagram" class="group flex items-center gap-4 bg-[#111111] hover:bg-[#161622] border border-[#1E1E2E] hover:border-[#A78BFA]/20 rounded-xl px-5 py-4 transition-all">
              <span class="text-2xl">📐</span>
              <div class="flex-1 min-w-0">
                <span class="text-xs font-mono text-[#4A4A6A] block mb-0.5">ENGINEERING</span>
                <span class="text-sm text-[#94A3B8] group-hover:text-white transition-colors truncate block">Dessin Automatique d'Architecture Système</span>
              </div>
              <span class="text-[#2A2A3A] group-hover:text-[#A78BFA] transition-colors">→</span>
            </a>
            <a href="/fr/features/audio-production" class="group flex items-center gap-4 bg-[#111111] hover:bg-[#161622] border border-[#1E1E2E] hover:border-[#A78BFA]/20 rounded-xl px-5 py-4 transition-all">
              <span class="text-2xl">🎵</span>
              <div class="flex-1 min-w-0">
                <span class="text-xs font-mono text-[#4A4A6A] block mb-0.5">AUDIO</span>
                <span class="text-sm text-[#94A3B8] group-hover:text-white transition-colors truncate block">Post-Production Podcast et Audio</span>
              </div>
              <span class="text-[#2A2A3A] group-hover:text-[#A78BFA] transition-colors">→</span>
            </a>
            <a href="/fr/features/tech-docs" class="group flex items-center gap-4 bg-[#111111] hover:bg-[#161622] border border-[#1E1E2E] hover:border-[#A78BFA]/20 rounded-xl px-5 py-4 transition-all">
              <span class="text-2xl">📝</span>
              <div class="flex-1 min-w-0">
                <span class="text-xs font-mono text-[#4A4A6A] block mb-0.5">DOCS</span>
                <span class="text-sm text-[#94A3B8] group-hover:text-white transition-colors truncate block">Générateur de Documentation Technique</span>
              </div>
              <span class="text-[#2A2A3A] group-hover:text-[#A78BFA] transition-colors">→</span>
            </a>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-12 lg:py-20">
      <div class="max-w-5xl mx-auto px-6 lg:px-20">
        <div class="rounded-2xl p-8 md:p-12 text-center border" style="background:#0D1020;border-color:#A78BFA33">
          <p class="font-mono text-xs tracking-[0.2em] mb-4" style="color:#A78BFA">// DÉPLOYER VOTRE AGENT</p>
          <h2 class="text-white text-2xl md:text-3xl font-bold mb-4">Prêt à automatiser votre flux de design ?</h2>
          <p class="text-[#6B7280] text-sm mb-8 max-w-md mx-auto">Décrivez-le une fois, générez 50 variantes instantanément. Pas de plugins Figma, pas de redimensionnement manuel.</p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a href="https://app.agentputer.com/sign-up" class="btn-primary text-sm py-3 px-8 font-mono">[COMMENCER]</a>
            <a href="/fr/features" class="btn-secondary text-sm py-3 px-8 font-mono">[TOUS LES SCÉNARIOS]</a>
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>
