---
// Sección Hero con vista previa de la terminal
---

<section class="relative pt-32 pb-20 lg:pt-40 lg:pb-32 overflow-hidden scanlines crt-flicker">
  <!-- Efectos de fondo -->
  <div class="absolute inset-0 bg-gradient-to-b from-dark-primary via-dark-primary to-dark-secondary"></div>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(0,255,65,0.08),transparent_50%)]"></div>
  <div class="absolute inset-0 matrix-grid"></div>
  <div class="absolute inset-0 particles"></div>
  
  <div class="relative max-w-7xl mx-auto px-6 lg:px-20">
    <div class="flex flex-col items-center text-center">
      <!-- Indicador de estado del sistema -->
      <div class="flex items-center gap-4 mb-8 font-mono text-xs text-text-muted">
        <span class="flex items-center gap-2">
          <span class="w-2 h-2 bg-accent rounded-full animate-pulse"></span>
          <span class="text-terminal-orange">SISTEMA</span> EN LÍNEA
        </span>
        <span class="text-terminal-blue">|</span>
        <span id="status-time" class="text-terminal-cyan"></span>
        <span class="text-terminal-blue">|</span>
        <span>AGENTES: <span class="text-accent">LISTOS</span></span>
      </div>
      
      <!-- Título - Salida HTML directa (elemento clave LCP), JS superpone efecto de escritura -->
      <h1 class="text-5xl md:text-7xl lg:text-8xl font-bold leading-tight mb-6 font-mono">
        <span class="block text-text-primary" id="title-line1">Tu IA</span>
        <span class="block text-accent text-glow-strong glitch" data-text="Nunca Duerme" id="title-line2">Nunca Duerme</span>
      </h1>
      
      <!-- Subtítulo -->
      <div class="text-base md:text-lg lg:text-xl text-text-secondary leading-relaxed mb-10 font-mono text-center">
        <p class="mb-2">Tu ordenador se apaga. Las sesiones expiran. Los tokens desaparecen.</p>
        <p><span class="text-accent">AgentPuter</span> mantiene <a href="https://openclaw.ai/" target="_blank" class="text-terminal-orange hover:underline">OpenClaw</a>, <a href="https://openclaw.ai/" target="_blank" class="text-terminal-cyan hover:underline">ClawBot</a>, <a href="https://openclaw.ai/" target="_blank" class="text-terminal-magenta hover:underline">MoltBot</a> funcionando 24/7.</p>
      </div>
      

      <!-- Botones de llamada a la acción (CTA) -->
      <div class="flex flex-col sm:flex-row items-center gap-4 mb-16">
        <a href="https://app.agentputer.com/sign-up" class="inline-flex items-center gap-2 px-8 py-3.5 bg-accent text-dark-primary font-mono font-bold text-sm rounded transition-all hover:bg-accent-dark">
          [DESPLEGAR AHORA — $29.99/mes]
        </a>
        <a href="/pricing" class="inline-flex items-center gap-2 px-6 py-3 border border-accent/50 text-accent font-mono font-bold text-sm rounded transition-all hover:border-accent hover:bg-accent/10">
          <span>./ver_precios</span>
          <span>→</span>
        </a>
      </div>
      
      <!-- Vista previa de la terminal -->
      <div class="w-full max-w-2xl terminal glow-accent neon-box hover-lift">
        <div class="terminal-header">
          <span class="terminal-dot terminal-dot-red"></span>
          <span class="terminal-dot terminal-dot-yellow"></span>
          <span class="terminal-dot terminal-dot-green"></span>
          <span class="text-text-muted font-mono text-xs ml-2">Terminal</span>
        </div>
        <div class="terminal-body space-y-2">
          <div class="flex">
            <span class="terminal-prompt">$ </span>
            <span class="terminal-prompt" id="cmd1"></span>
          </div>
          <div class="terminal-success hidden" id="output1">✓ Pod creado con éxito</div>
          <div class="h-2"></div>
          <div class="flex hidden" id="line2">
            <span class="terminal-prompt">$ </span>
            <span class="terminal-prompt" id="cmd2"></span>
          </div>
          <div class="terminal-success hidden" id="output2">✓ OpenClaw desplegado y funcionando 24/7</div>
          <div class="h-2 hidden" id="spacer"></div>
          <div class="flex hidden" id="cursor-line">
            <span class="terminal-prompt">$ </span>
            <span class="cursor-blink"></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {

    // Animación de escritura del título
    const titleLine1 = document.getElementById('title-line1');
    const titleLine2 = document.getElementById('title-line2');
    const titleTexts = ['Tu IA', 'Nunca Duerme'];
    
    async function typeTitle() {
      // Limpiar ambas líneas simultáneamente para evitar que line2 parpadee mientras se escribe line1
      if (titleLine1) titleLine1.textContent = '';
      if (titleLine2) titleLine2.textContent = '';

      if (titleLine1) {
        for (let i = 0; i <= titleTexts[0].length; i++) {
          titleLine1.textContent = titleTexts[0].substring(0, i) + (i < titleTexts[0].length ? '█' : '');
          await new Promise(function(r) { setTimeout(r, 100); });
        }
        titleLine1.textContent = titleTexts[0];
      }
      
      await new Promise(function(r) { setTimeout(r, 200); });
      
      if (titleLine2) {
        for (let i = 0; i <= titleTexts[1].length; i++) {
          titleLine2.textContent = titleTexts[1].substring(0, i) + (i < titleTexts[1].length ? '█' : '');
          await new Promise(function(r) { setTimeout(r, 80); });
        }
        titleLine2.textContent = titleTexts[1];
      }
    }
    
    // Actualización de la hora de estado
    var timeElement = document.getElementById('status-time');
    function updateTime() {
      if (!timeElement) return;
      var now = new Date();
      timeElement.textContent = now.toLocaleTimeString('es-ES', { hour12: false });
    }
    updateTime();
    setInterval(updateTime, 1000);
    
    // Animación de escritura de la terminal
    var commands = [
      { id: 'cmd1', text: 'agentputer init openclaw-pod', output: 'output1', next: 'line2' },
      { id: 'cmd2', text: 'agentputer deploy openclaw', output: 'output2', next: 'spacer' }
    ];
    
    async function typeText(elementId, text, speed) {
      speed = speed || 50;
      var element = document.getElementById(elementId);
      if (!element) return;
      
      for (var i = 0; i < text.length; i++) {
        element.textContent = text.substring(0, i + 1);
        await new Promise(function(r) { setTimeout(r, speed); });
      }
    }
    
    function showElement(id) {
      var el = document.getElementById(id);
      if (el) {
        el.classList.remove('hidden');
        el.classList.add('animate-fade-in');
      }
    }
    
    async function runTerminal() {
      // Primero, escribir el título
      await typeTitle();
      await new Promise(function(r) { setTimeout(r, 800); });
      
      // Luego, ejecutar los comandos de la terminal
      for (var i = 0; i < commands.length; i++) {
        var cmd = commands[i];
        await typeText(cmd.id, cmd.text);
        await new Promise(function(r) { setTimeout(r, 300); });
        showElement(cmd.output);
        await new Promise(function(r) { setTimeout(r, 500); });
        showElement(cmd.next);
        await new Promise(function(r) { setTimeout(r, 200); });
      }
      
      showElement('cursor-line');
    }
    
    runTerminal();
  });
</script>